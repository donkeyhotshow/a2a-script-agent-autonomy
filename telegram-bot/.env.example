# ──────────────────────────────────────────────────────────────────────────────
# Telegram Bot – Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# Required — obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Base URL of the A2A server (a2a-server package)
A2A_API_URL=http://localhost:3001

# Optional — comma-separated list of allowed Telegram chat IDs.
# Leave empty to allow all chats.
ALLOWED_CHAT_IDS=

# Optional — Redis URL for persistent session storage.
# When absent, falls back to an in-memory Map (resets on restart).
REDIS_URL=

# Polling configuration
POLL_INTERVAL_MS=800
POLL_MAX_ATTEMPTS=60

# HTTP health-check port
PORT=4000
