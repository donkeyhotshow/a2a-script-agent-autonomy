# ──────────────────────────────────────────────────────────────────────────────
# Telegram Bot — Environment Variables
# These override equivalent values in config.toml when both are present.
# ──────────────────────────────────────────────────────────────────────────────

# Required — obtain from @BotFather (overrides config.toml [telegram].bot_token)
TELEGRAM_BOT_TOKEN=

# Base URL of the A2A server (overrides config.toml [a2a].api_url)
A2A_API_URL=http://localhost:3001

# Optional — comma-separated allowed Telegram chat IDs (overrides config.toml)
ALLOWED_CHAT_IDS=

# Optional — Redis URL for persistent sessions + episodic memory
REDIS_URL=redis://localhost:6379

# Polling
POLL_INTERVAL_MS=800
POLL_MAX_ATTEMPTS=60

# Optional — OpenAI API key for Whisper voice transcription
OPENAI_API_KEY=

# Verbosity: 0=quiet 1=normal 2=detailed
VERBOSE_LEVEL=1

# HTTP health-check port
PORT=4000

# Feature flags (override config.toml [features])
# FEATURE_VOICE=false
# FEATURE_PHOTOS=true
# FEATURE_MEMORY=true
# FEATURE_VERBOSE_TOOLS=true

# Watchdog
# WATCHDOG_TIMEOUT_SECONDS=120
# WATCHDOG_NOTIFY=true
