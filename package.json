{
  "name": "a2a-coding-orchestrator",
  "private": true,
  "type": "module",
  "devRoots": [
    "a2a-client",
    "a2a-server",
    "a2a-ai-hub",
    "@a2a-client/web",
    "@a2a/agents"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:legacy": "node scripts/runbook-cli.js start",
    "sim:lint": "npm --prefix a2a-server run sim:lint --",
    "sim:lint:all": "npm --prefix a2a-server run sim:lint:all --",
    "sim:validate": "npm --prefix a2a-server run sim:validate --",
    "sim:quality": "npm --prefix a2a-server run sim:quality",
    "sim:contract-report": "npm --prefix a2a-server run sim:contract-report --",
    "sim:check-md": "npm --prefix a2a-server run sim:check-md --",
    "sim:check-md:fail": "npm --prefix a2a-server run sim:check-md -- --fail",
    "sim:check-md:fix": "npm --prefix a2a-server run sim:check-md:fix --",
    "gate:cleanup": "npm --prefix a2a-server run gate:cleanup",
    "agent-runner": "node tests/integration/direct-tests/agent-dialog-runner.mjs",
    "central": "node scripts/orchestrator-runbook/central-orchestrator.mjs",
    "central:offline": "npm run test:before-start && npm run cross-system:validate && npm run sim:check-md:fail && npm run sim:lint:all && npm run sim:validate -- --all",
    "monitor": "node scripts/monitor-and-process-tasks.js",
    "monitor:daemon": "node scripts/monitor-and-process-tasks.js --daemon",
    "monitor:once": "node scripts/monitor-and-process-tasks.js --once",
    "monitor:completed": "node scripts/monitor-and-process-tasks.js --list-completed",
    "monitor:completed:json": "node scripts/monitor-and-process-tasks.js --list-completed --json",
    "monitor:rewind-session": "node scripts/scripts/rewind-session-last-step.mjs",
    "check:promise-queue": "node scripts/monitor-tasks/check-promise-queue.mjs",
    "report:promise": "node scripts/scripts/promise-artifacts-report.mjs",
    "monitor:reset": "node scripts/cleanup-session-state.js --monitor-state",
    "cleanup:state": "node scripts/cleanup-session-state.js",
    "cleanup:fresh": "node scripts/cleanup-session-state.js --fresh",
    "cleanup:sessions-only": "node scripts/cleanup-session-state.js --sessions-only",
    "test:monitor": "vitest run tests/integration/indirect-tests/infrastructure/monitor-and-process-tasks.test.js tests/integration/indirect-tests/infrastructure/central-orchestrator.test.js",
    "test:direct-tests": "vitest run tests/integration/direct-tests",
    "test:indirect": "node tests/integration/indirect-tests/run-all.mjs",
    "validate:mama-red-vertical": "node tests/integration/indirect-tests/red-room/validate-red-room-dialog-vertical.mjs",
    "validate:mama-gray-horizontal": "node tests/integration/indirect-tests/gray-room/validate-gray-room-horizontal.mjs",
    "test:server:unit": "powershell -ExecutionPolicy Bypass -File tests/integration/indirect-tests/run-server-unit-tests.ps1",
    "test:before-start": "npm run test:indirect && npm run test:server:unit && npm run test:monitor && npm run verify:audit-session-storage",
    "test:gang": "node tests/integration/indirect-tests/papa-mama-gang.mjs",
    "scan-promise-bodies": "node tests/integration/direct-tests/validators/scan-promise-bodies.mjs",
    "scan-session-responses": "node tests/integration/direct-tests/validators/scan-session-responses.mjs",
    "verify:gray-room": "node tests/integration/direct-tests/validators/verify-gray-room-state.mjs",
    "verify:audit-session-storage-generator": "node tests/integration/direct-tests/validators/verify-audit-session-storage-generator.mjs",
    "verify:audit-session-storage-accuracy": "node tests/integration/direct-tests/validators/verify-audit-session-storage-accuracy.mjs",
    "verify:audit-session-storage": "npm run verify:audit-session-storage-generator && npm run audit:session-storage && npm run verify:audit-session-storage-accuracy",
    "audit:sim-choice-descriptions": "node tests/integration/direct-tests/validators/audit-sim-choice-descriptions.mjs",
    "audit:session-storage": "node scripts/audit-session-storage-to-tasks.mjs",
    "cross-system:validate": "node tests/integration/indirect-tests/cross-system-validate.mjs",
    "cross-system:new-fixture": "node scripts/scripts/new-cross-system-fixture.mjs",
    "validate:proba-servera": "tsx tests/integration/proba-servera/validate.mts",
    "verify:proba-cache-api": "node tests/integration/proba-servera/cache-api-smoke.mjs",
    "test:human-review:all": "node scripts/scripts/run-human-review-all.mjs",
    "fix-imports:direct": "node scripts/fix-imports-direct.mjs",
    "postinstall": "node -e \"console.log('[postinstall] root: optional devDeps only; use per-package npm i in a2a-server / a2a-client.'); process.exit(0)\""
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "ajv": "^8.18.0",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "dotenv": "^17.4.1",
    "eventsource": "^2.0.0",
    "js-yaml": "^4.1.0",
    "jsdom": "^28.1.0",
    "lucide-react": "^1.8.0",
    "node-fetch": "^3.3.2",
    "postcss": "^8.5.10",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "axios": "^1.14.0",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "next": "^16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^3.25.76"
  },
  "version": "1.0.0",
  "description": "**Status: 2026-03-27 (Production Readiness Phase)**",
  "main": "scripts/monitor-and-process-tasks.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleon10/a2a-script-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aleon10/a2a-script-agent/issues"
  },
  "homepage": "https://github.com/aleon10/a2a-script-agent#readme"
}
