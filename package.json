{
    "name": "a2a-coding-orchestrator",
    "private": true,
    "type": "module",
    "devRoots": [
        "a2a-client",
        "a2a-server",
        "ai-integration",
        "@a2a-client/web"
    ],
    "scripts": {
        "dev": "start-all.bat",
        "sim:lint": "npm --prefix a2a-server run sim:lint --",
        "sim:lint:all": "npm --prefix a2a-server run sim:lint:all --",
        "sim:validate": "npm --prefix a2a-server run sim:validate --",
        "sim:validate:all": "npm --prefix a2a-server run sim:validate -- --all",
        "sim:validate:all:contract": "npm --prefix a2a-server run sim:validate -- --all --step-contract",
        "sim:quality": "npm --prefix a2a-server run sim:quality",
        "sim:contract-report": "npm --prefix a2a-server run sim:contract-report --",
        "sim:check-md": "npm --prefix a2a-server run sim:check-md --",
        "sim:check-md:fail": "npm --prefix a2a-server run sim:check-md -- --fail",
        "sim:check-md:fix": "npm --prefix a2a-server run sim:check-md:fix --",
        "gate:cleanup": "npm --prefix a2a-server run gate:cleanup",
        "agent-runner": "node scripts/agent-dialog-runner.mjs",
        "monitor": "node monitor-and-process-tasks.js",
        "monitor:daemon": "node monitor-and-process-tasks.js --daemon",
        "monitor:once": "node monitor-and-process-tasks.js --once",
        "monitor:reset": "node -e \"require('fs').unlinkSync('task-monitor-state.json')\" 2>nul || exit 0",
        "test:direct-tests": "vitest run tests/direct-tests",
        "test:indirect": "node tests/indirect-tests/run-all.mjs",
        "validate:mama-red-vertical": "node tests/indirect-tests/red-room/validate-red-room-dialog-vertical.mjs",
        "validate:mama-gray-horizontal": "node tests/indirect-tests/gray-room/validate-gray-room-horizontal.mjs",
        "test:server:unit": "powershell -ExecutionPolicy Bypass -File tests/indirect-tests/run-server-unit-tests.ps1",
        "test:server:unit:all": "powershell -ExecutionPolicy Bypass -File tests/indirect-tests/run-server-unit-tests.ps1 -IncludeIntegration",
        "test:before-start": "npm run test:indirect && npm run test:server:unit",
        "test:gang": "node tests/papa-mama-gang.mjs",
        "test:gang:mama": "node tests/papa-mama-gang.mjs --mama-only",
        "test:gang:papa": "node tests/papa-mama-gang.mjs --papa-only",
        "test:gang:strict": "node tests/papa-mama-gang.mjs --strict-artifacts",
        "test:recon": "node tests/papa-mama-gang.mjs --recon",
        "test:recon:mama": "node tests/papa-mama-gang.mjs --mama-only --recon",
        "gang:orient-session": "node tests/gang-orient-session.mjs",
        "cursor:hook-ticker": "node scripts/cursor-hook-ticker.mjs",
        "cursor:hook-ticker:once": "node scripts/cursor-hook-ticker.mjs --once",
        "scan-promise-bodies": "node tests/direct-tests/validators/scan-promise-bodies.mjs",
        "scan-promise-bodies:strict": "node tests/direct-tests/validators/scan-promise-bodies.mjs --strict",
        "scan-session-responses": "node tests/direct-tests/validators/scan-session-responses.mjs",
        "scan-session-responses:strict": "node tests/direct-tests/validators/scan-session-responses.mjs --strict",
        "verify:gray-room": "node tests/direct-tests/validators/verify-gray-room-state.mjs",
        "audit:sim-choice-descriptions": "node tests/direct-tests/validators/audit-sim-choice-descriptions.mjs",
        "validate:proba-servera": "tsx tests/proba-servera/validate.mts",
        "test:human-review:all": "node scripts/run-human-review-all.mjs",
        "docs:system-errors": "node scripts/generate-system-errors-docs.mjs"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "ajv": "^8.18.0",
        "concurrently": "^9.1.0",
        "dotenv": "^17.3.1",
        "eventsource": "^2.0.0",
        "js-yaml": "^4.1.0",
        "node-fetch": "^3.3.2",
        "tsx": "^4.19.0",
        "typescript": "^5.3.3",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@chainsafe/libp2p-gossipsub": "^14.1.2",
        "@chainsafe/libp2p-noise": "^17.0.0",
        "@langchain/langgraph": "^1.2.7",
        "@libp2p/mplex": "^12.0.15",
        "@libp2p/tcp": "^11.0.14",
        "@types/commander": "^2.12.0",
        "a2a-js": "^0.2.0",
        "axios": "^1.14.0",
        "bullmq": "^5.73.0",
        "commander": "^14.0.3",
        "express": "^5.2.1",
        "glob": "^13.0.6",
        "ioredis": "^5.10.1",
        "langgraph-js": "^1.0.1-alpha.18",
        "libp2p": "^3.1.7",
        "litellm": "^0.12.0",
        "loro-crdt": "^1.10.8",
        "playwright": "^1.58.2",
        "typescript-json": "^7.6.4",
        "zod": "^3.22.4"
    },
    "version": "1.0.0",
    "description": "**Status: 2026-03-27 (Production Readiness Phase)**",
    "main": "monitor-and-process-tasks.js",
    "directories": {
        "doc": "docs",
        "test": "test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://aleon10: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@github.com/aleon10/a2a-script-agent.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/aleon10/a2a-script-agent/issues"
    },
    "homepage": "https://github.com/aleon10/a2a-script-agent#readme"
}
