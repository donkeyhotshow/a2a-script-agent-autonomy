{
    "name":  "a2a-coding-orchestrator",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "sim:run":  "node simulations/run-simulation.js",
                    "sim:run-all":  "node simulations/run-all-simulations.js",
                    "sse:demo":  "node scripts/run-sse-demo.js",
                    "questions":  "node scripts/questions-cli.js",
                    "generate:types":  "node scripts/generate-action-types.js",
                    "dev":  "node scripts/orchestrator.js all",
                    "dev:client":  "node scripts/orchestrator.js client",
                    "dev:server":  "node scripts/orchestrator.js server",
                    "dev:proxy":  "node scripts/orchestrator.js proxy",
                    "dev:full":  "node scripts/orchestrator.js full",
                    "dev:status":  "node scripts/orchestrator.js status",
                    "dev:stop":  "node scripts/orchestrator.js stop",
                    "dev:legacy":  "node scripts/dev-launch.js",
                    "dev:stack":  "concurrently \"npm run dev:web\" \"npm run dev:client-api\" \"npm run dev:server-api\"",
                    "dev:stack:ai":  "concurrently \"npm run dev:web\" \"npm run dev:client-api\" \"npm run dev:server-api\" \"npm run dev:ai\"",
                    "dev:kill-ports":  "npx --yes kill-port 5173 5174 3000 3001 11434 || exit 0",
                    "dev:web":  "npm run dev --prefix a2a-client",
                    "dev:client-api":  "npm run dev --prefix a2a-client/packages/sdk",
                    "dev:server-api":  "npm run dev --prefix a2a-server",
                    "dev:ai":  "cd ai-integration \u0026\u0026 python -m proxy",
                    "docker:up":  "docker compose up -d",
                    "docker:down":  "docker compose down",
                    "docker:logs":  "docker compose logs -f",
                    "test":  "npm run test --prefix a2a-client",
                    "validate:config":  "tsx config/validate.ts",
                    "validate:config:safe":  "tsx config/validate.ts --safe",
                    "pre-release":  "node scripts/pre-release.js",
                    "smoke-test":  "powershell -ExecutionPolicy Bypass -File scripts/test-web-ui.ps1 -SkipBrowser",
                    "smoke-test:full":  "powershell -ExecutionPolicy Bypass -File scripts/test-web-ui.ps1",
                    "retrospective":  "node scripts/smoke-retrospective.js",
                    "retrospective:daily":  "node scripts/smoke-retrospective.js --period daily",
                    "retrospective:weekly":  "node scripts/smoke-retrospective.js --period weekly",
                    "setup-retrospectives":  "powershell -ExecutionPolicy Bypass -File scripts/setup-retrospectives.ps1 -Install",
                    "remove-retrospectives":  "powershell -ExecutionPolicy Bypass -File scripts/setup-retrospectives.ps1 -Uninstall",
                    "test-retrospectives":  "powershell -ExecutionPolicy Bypass -File scripts/setup-retrospectives.ps1 -Test",
                    "setup:smoke-system":  "powershell -ExecutionPolicy Bypass -File scripts/setup-complete-smoke-system.ps1",
                    "setup:smoke-system:quick":  "powershell -ExecutionPolicy Bypass -File scripts/setup-complete-smoke-system.ps1 -Quick",
                    "setup:smoke-system:skip-tests":  "powershell -ExecutionPolicy Bypass -File scripts/setup-complete-smoke-system.ps1 -SkipTests"
                },
    "devDependencies":  {
                            "@types/node":  "^20.11.0",
                            "concurrently":  "^9.1.0",
                            "dotenv":  "^17.3.1",
                            "eventsource":  "^2.0.0",
                            "js-yaml":  "^4.1.0",
                            "node-fetch":  "^3.3.2",
                            "tsx":  "^4.19.0",
                            "typescript":  "^5.3.3",
                            "vitest":  "^4.0.18"
                        },
    "dependencies":  {
                         "playwright":  "^1.58.2",
                         "zod":  "^3.22.4"
                     }
}
