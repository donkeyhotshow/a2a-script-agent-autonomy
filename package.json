{
  "name": "a2a-coding-orchestrator",
  "private": true,
  "type": "module",
  "devRoots": [
    "a2a-client",
    "a2a-server",
    "a2a-ai-hub",
    "@a2a-client/web",
    "@a2a/agents"
  ],
  "scripts": {
    "dev": "node scripts/runbook-cli.js start",
    "sim:lint": "npm --prefix a2a-server run sim:lint --",
    "sim:lint:all": "npm --prefix a2a-server run sim:lint:all --",
    "sim:validate": "npm --prefix a2a-server run sim:validate --",
    "sim:quality": "npm --prefix a2a-server run sim:quality",
    "sim:contract-report": "npm --prefix a2a-server run sim:contract-report --",
    "sim:check-md": "npm --prefix a2a-server run sim:check-md --",
    "sim:check-md:fail": "npm --prefix a2a-server run sim:check-md -- --fail",
    "sim:check-md:fix": "npm --prefix a2a-server run sim:check-md:fix --",
    "gate:cleanup": "npm --prefix a2a-server run gate:cleanup",
    "agent-runner": "node tests/agent-dialog-runner.mjs",
"central": "node a2a-orchestrator/src/runbook/central-orchestrator.mjs",
    "central:offline": "npm run test:before-start && npm run cross-system:validate && npm run sim:check-md:fail && npm run sim:lint:all && npm run sim:validate -- --all",
    "monitor": "node runbook/monitor-and-process-tasks.js",
    "monitor:daemon": "node runbook/monitor-and-process-tasks.js --daemon",
    "monitor:once": "node runbook/monitor-and-process-tasks.js --once",
    "monitor:completed": "node runbook/monitor-and-process-tasks.js --list-completed",
    "monitor:completed:json": "node runbook/monitor-and-process-tasks.js --list-completed --json",
    "monitor:rewind-session": "node runbook/scripts/rewind-session-last-step.mjs",
    "check:promise-queue": "node tests/monitor-tasks/check-promise-queue.mjs",
    "report:promise": "node runbook/scripts/promise-artifacts-report.mjs",
    "monitor:reset": "node scripts/monitor-reset-state.mjs",
    "cleanup:state": "node runbook/cleanup-session-state.js",
    "cleanup:fresh": "node runbook/cleanup-session-state.js --fresh",
    "cleanup:sessions-only": "node runbook/cleanup-session-state.js --sessions-only",
    "test:monitor": "vitest run tests/infrastructure/monitor-and-process-tasks.test.js tests/infrastructure/central-orchestrator.test.js",
    "test:direct-tests": "vitest run tests/direct-tests",
    "test:indirect": "node tests/indirect-tests/run-all.mjs",
    "validate:mama-red-vertical": "node tests/indirect-tests/red-room/validate-red-room-dialog-vertical.mjs",
    "validate:mama-gray-horizontal": "node tests/indirect-tests/gray-room/validate-gray-room-horizontal.mjs",
    "test:server:unit": "powershell -ExecutionPolicy Bypass -File tests/indirect-tests/run-server-unit-tests.ps1",
    "test:before-start": "npm run test:indirect && npm run test:server:unit && npm run test:monitor && npm run verify:audit-session-storage",
    "test:gang": "node tests/papa-mama-gang.mjs",
    "scan-promise-bodies": "node tests/direct-tests/validators/scan-promise-bodies.mjs",
    "scan-session-responses": "node tests/direct-tests/validators/scan-session-responses.mjs",
    "verify:gray-room": "node tests/direct-tests/validators/verify-gray-room-state.mjs",
    "verify:audit-session-storage-generator": "node tests/direct-tests/validators/verify-audit-session-storage-generator.mjs",
    "verify:audit-session-storage-accuracy": "node tests/direct-tests/validators/verify-audit-session-storage-accuracy.mjs",
    "verify:audit-session-storage": "npm run verify:audit-session-storage-generator && npm run audit:session-storage && npm run verify:audit-session-storage-accuracy",
    "audit:sim-choice-descriptions": "node tests/direct-tests/validators/audit-sim-choice-descriptions.mjs",
    "audit:session-storage": "node runbook/scripts/audit-session-storage-to-tasks.mjs",
    "cross-system:validate": "node tests/cross-system-validate.mjs",
    "cross-system:new-fixture": "node runbook/scripts/new-cross-system-fixture.mjs",
    "validate:proba-servera": "tsx tests/proba-servera/validate.mts",
    "verify:proba-cache-api": "node tests/proba-servera/cache-api-smoke.mjs",
    "test:human-review:all": "node runbook/scripts/run-human-review-all.mjs",
    "fix-imports:direct": "node scripts/fix-imports-direct.mjs",
    "postinstall": "echo 'No root node_modules needed! Use: cd a2a-server && npm i; cd ../a2a-client && npm i etc.' && exit 0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ajv": "^8.18.0",
    "concurrently": "^9.1.0",
    "dotenv": "^17.4.1",
    "eventsource": "^2.0.0",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@langchain/langgraph": "^1.2.7",
    "@libp2p/mplex": "^12.0.15",
    "@libp2p/tcp": "^11.0.14",
    "@types/commander": "^2.12.0",
    "a2a-js": "^0.2.0",
    "axios": "^1.14.0",
    "bullmq": "^5.73.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "glob": "^13.0.6",
    "ioredis": "^5.10.1",
    "libp2p": "^3.1.7",
    "litellm": "^0.12.0",
    "loro-crdt": "^1.10.8",
    "playwright": "^1.58.2",
    "typescript-json": "^7.6.4",
    "zod": "^3.22.4"
  },
  "version": "1.0.0",
  "description": "**Status: 2026-03-27 (Production Readiness Phase)**",
  "main": "tests/monitor-and-process-tasks.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aleon10/a2a-script-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aleon10/a2a-script-agent/issues"
  },
  "homepage": "https://github.com/aleon10/a2a-script-agent#readme"
}
