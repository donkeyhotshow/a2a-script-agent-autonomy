{
    "name":  "a2a-coding-orchestrator",
    "private":  true,
    "type":  "module",
    "devRoots":  [
        "a2a-client",
        "a2a-server",
        "ai-integration",
        "a2a-client/web"
    ],
    "scripts":  {
                    "dev":  "start-all.bat",
                    "sim:lint":  "npm --prefix a2a-server run sim:lint --",
                    "sim:lint:all":  "npm --prefix a2a-server run sim:lint:all --",
                    "sim:validate":  "npm --prefix a2a-server run sim:validate --",
                    "tester":  "cd a2a-client/tester && npm run start",
                    "tester:install":  "cd a2a-client/tester && npm install",
                    "tester:test":  "cd a2a-client/tester && npm test"
                },
    "devDependencies":  {
                            "@types/node":  "^20.11.0",
                            "concurrently":  "^9.1.0",
                            "dotenv":  "^17.3.1",
                            "eventsource":  "^2.0.0",
                            "js-yaml":  "^4.1.0",
                            "node-fetch":  "^3.3.2",
                            "tsx":  "^4.19.0",
                            "typescript":  "^5.3.3",
                            "vitest":  "^4.0.18"
                        },
    "dependencies":  {
                         "playwright":  "^1.58.2",
                         "zod":  "^3.22.4"
                     }
}
