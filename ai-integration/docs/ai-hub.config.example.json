{
  "$schema": "./ai-hub.config.schema.json",
  "model_aliases": {
    "qwen3:8b": "qwen3:8b",
    "big": "qwen3:8b",
    "small": "qwen3:8b"
  },
  "strict_model_aliases": false,
  "rules": [
    {
      "id": "avoid_big_by_model",
      "when": {
        "path_regex": "^api/(generate|embeddings|chat).*$",
        "model": [
          "big",
          "qwen3:8b"
        ]
      },
      "then": [
        {
          "type": "set_model",
          "model": "small"
        }
      ]
    },
    {
      "id": "simulate_smoke",
      "when": {
        "path_regex": "^api/generate$",
        "prompt_contains": [
          "SIMULATE:"
        ]
      },
      "then": {
        "type": "simulate",
        "builder": "ollama.generate",
        "text": "SIMULATED: {prompt}",
        "delay_ms": 50
      }
    },
    {
      "id": "script_route_and_simulate",
      "when": {
        "path_regex": "^api/generate$",
        "prompt_contains": [
          "ROUTE_AND_SIM:"
        ]
      },
      "then": [
        {
          "type": "set_model",
          "model": "small"
        },
        {
          "type": "simulate",
          "builder": "ollama.generate",
          "text": "model={model}; prompt={prompt}"
        }
      ]
    },
    {
      "id": "promise_pending_delay",
      "when": {
        "path_regex": "^api/generate$",
        "prompt_contains": [
          "PENDING_PROMISE"
        ]
      },
      "then": {
        "type": "simulate",
        "builder": "ollama.generate",
        "text": "PENDING SIMULATED PROMISE: {prompt}",
        "delay_ms": 6000
      }
    }
  ],
  "virtual_models": {
    "rnj-L": {
