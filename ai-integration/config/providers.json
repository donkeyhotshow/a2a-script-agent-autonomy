{
  "providers": {
    "ollama": {
      "type": "ollama",
      "url": "${OLLAMA_HOST:-http://localhost:11435}",
      "enabled": true,
      "priority": 1,
      "models": ["qwen3:8b"],
      "timeout": 0,
      "max_retries": 3
    },
    "openrouter": {
      "type": "openai",
      "url": "https://openrouter.ai/api/v1",
      "api_key": "${OPENROUTER_API_KEY}",
      "enabled": false,
      "priority": 2,
      "models": [
        "meta-llama/llama-3-8b-instruct",
        "mistralai/mistral-7b-instruct",
        "google/gemma-7b-it",
        "nousresearch/hermes-3-llama-3.1-405b"
      ],
      "fallback_models": {
        "qwen3:8b": "meta-llama/llama-3-8b-instruct",
        "mistral": "mistralai/mistral-7b-instruct"
      },
      "timeout": 0,
      "max_retries": 2
    },
    "groq": {
      "type": "openai",
      "url": "https://api.groq.com/openai/v1",
      "api_key": "${GROQ_API_KEY}",
      "enabled": false,
      "priority": 3,
      "models": [
        "qwen3-8b-8192",
        "qwen3-70b-8192",
        "mixtral-8x7b-32768",
        "gemma2-9b-it"
      ],
      "fallback_models": {
        "qwen3:8b": "qwen3-8b-8192",
        "mistral": "mixtral-8x7b-32768"
      },
      "timeout": 0,
      "max_retries": 2
    },
    "huggingface": {
      "type": "huggingface",
      "url": "https://api-inference.huggingface.co",
      "api_key": "${HF_TOKEN}",
      "enabled": false,
      "priority": 4,
      "models": [
        "meta-llama/Llama-2-7b-chat-hf",
        "mistralai/Mistral-7B-v0.1"
      ],
      "timeout": 0,
      "max_retries": 1
    },
    "cohere": {
      "type": "openai",
      "url": "https://api.cohere.ai/v1",
      "api_key": "${COHERE_API_KEY}",
      "enabled": false,
      "priority": 5,
      "models": ["command-r", "command-r-plus"],
      "timeout": 0,
      "max_retries": 2
    }
  },
  "default_provider": "ollama",
  "fallback_chain": ["ollama", "groq", "openrouter"],
  "enable_fallback": true,
  "provider_timeout": 0
}
