{
  "workflow_version": "1.0.0",
  "session_timeout": 86400000,
  "max_retries": 3,
  "batch_size": {
    "high": 5,
    "medium": 10,
    "low": 20
  },
  "quality_thresholds": {
    "completion_rate": 95,
    "accuracy_score": 90,
    "organization_score": 85
  },
  "processing_limits": {
    "max_documents_per_hour": 100,
    "max_memory_usage": 80,
    "max_processing_time": 7200000
  },
  "error_handling": {
    "retry_delay": 30000,
    "rollback_on_critical_error": true,
    "manual_intervention_threshold": 10
  },
  "notifications": {
    "enabled": true,
    "email": {
      "enabled": false,
      "recipients": ["admin@example.com"]
    },
    "webhook": {
      "enabled": false,
      "url": "",
      "events": ["phase_complete", "error", "success"]
    }
  },
  "integration": {
    "ci_cd": {
      "enabled": true,
      "github_actions": true,
      "gitlab_ci": true,
      "jenkins": true
    },
    "monitoring": {
      "dashboard_enabled": true,
      "metrics_enabled": true,
      "real_time_updates": true
    }
  }
}