{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apps List Configuration Schema",
  "description": "Schema for the unified application list configuration.",
  "type": "object",
  "properties": {
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "appId": {"type": "string"},
          "title": {"type": "string"},
          "path": {"type": "string"},
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "envVar": {"type": "string"},
                "value": {"type": "integer", "minimum": 1024, "maximum": 65535}
              },
              "required": ["name", "envVar", "value"]
            }
          },
          "tests": {
            "type": "array",
            "items": {"type": "string"}
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "command": {"type": "string"},
          "env": {
            "type": "object",
            "patternProperties": {
              "^[a-zA-Z0-9_]+$": {"type": "string"}
            },
            "additionalProperties": false
          },
          "enabled": {"type": "boolean"},
          "autoStart": {"type": "boolean"},
          "group": {"type": ["string", "null"]},
          "description": {"type": "string"},
          "projectType": {"type": "string"},
          "visibleWindow": {"type": "boolean"},
          "detectContains": {
            "type": "array",
            "items": {"type": "string"}
          },
          "component": {"type": "string"},
          "category": {"type": "string"},
          "icon": {"type": "string"},
          "tags": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "required": ["appId", "title", "path"]
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created": { "type": "string", "format": "date-time" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["created", "version", "description"],
      "additionalProperties": false
    }
  },
  "required": ["apps", "metadata"],
  "additionalProperties": false
}
