{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unified Services Configuration Schema",
  "description": "Schema for the unified services configuration file.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Version of the configuration schema."
    },
    "global": {
      "type": "object",
      "properties": {
        "logging": {
          "type": "object",
          "properties": {
            "level": { "type": "string" },
            "format": { "type": "string" },
            "file": { "type": "string" },
            "rotation": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "maxSize": { "type": "string" },
                "maxFiles": { "type": "number" }
              },
              "required": ["enabled", "maxSize", "maxFiles"]
            }
          },
          "required": ["level", "format", "file", "rotation"]
        },
        "monitoring": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "port": { "type": "number" }
          },
          "required": ["enabled", "port"]
        },
        "security": {
          "type": "object",
          "properties": {
            "ssl": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              },
              "required": ["enabled"]
            },
            "auth": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              },
              "required": ["enabled"]
            }
          },
          "required": ["ssl", "auth"]
        }
      },
      "required": ["logging", "monitoring", "security"]
    },
    "services": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "properties": {
            "appId": { "type": "string" },
            "name": { "type": "string" },
            "enabled": { "type": "boolean" },
            "group": { "type": "string" },
            "autostart": { "type": "boolean" },
            "status": { "type": "string" },
            "type": { "type": "string" },
            "load": { "type": "number" },
            "region": { "type": "string" },
            "description": { "type": "string" },
            "environment": {
              "type": "object",
              "patternProperties": {
                "^[A-Z_]+$": { "type": "string" }
              },
              "additionalProperties": true
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "envVar": { "type": "string" },
                  "value": { "type": "number" },
                  "protocol": { "type": "string" },
                  "host": { "type": "string" },
                  "external": { "type": "boolean" },
                  "timeout": { "type": "number" }
                },
                "required": ["name", "value", "protocol"]
              }
            },
            "startCommands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "command": { "type": "string" },
                  "args": { "type": "array", "items": { "type": "string" } },
                  "cwd": { "type": "string" },
                  "logFile": { "type": "string" },
                  "enabled": { "type": "boolean" },
                  "description": { "type": "string" },
                  "priority": { "type": "number" },
                  "timeout": { "type": "number" },
                  "retries": { "type": "number" },
                  "retryDelay": { "type": "number" }
                },
                "required": ["id", "name", "command", "cwd"]
              }
            },
            "dependencies": {
              "type": "array",
              "items": { "type": "string" }
            },
            "resources": {
              "type": "object",
              "properties": {
                "maxMemory": { "type": "string" },
                "maxCpu": { "type": "string" },
                "workerThreads": { "type": "number" },
                "clusterMode": { "type": "boolean" },
                "loadBalancing": { "type": "string" }
              },
              "required": ["maxMemory", "maxCpu"]
            },
            "logging": {
              "type": "object",
              "properties": {
                "level": { "type": "string" },
                "format": { "type": "string" },
                "file": { "type": "string" },
                "console": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "colorize": { "type": "boolean" }
                  }
                },
                "rotation": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "maxSize": { "type": "string" },
                    "maxFiles": { "type": "number" }
                  }
                }
              },
              "required": ["level", "format", "file"]
            },
            "process": {
              "type": "object",
              "properties": {
                "autostart": { "type": "boolean" },
                "restart": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "maxRetries": { "type": "number" },
                    "interval": { "type": "number" },
                    "backoff": { "type": "string" }
                  },
                  "required": ["enabled", "maxRetries", "interval"]
                },
                "gracefulShutdown": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "timeout": { "type": "number" }
                  },
                  "required": ["enabled", "timeout"]
                }
              },
              "required": ["autostart", "restart"]
            },
            "performance": {
              "type": "object",
              "properties": {
                "compression": { "type": "boolean" },
                "compressionLevel": { "type": "number" },
                "caching": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "maxAge": { "type": "number" },
                    "etag": { "type": "boolean" }
                  },
                  "required": ["enabled", "maxAge", "etag"]
                },
                "rateLimiting": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "windowMs": { "type": "number" },
                    "max": { "type": "number" }
                  },
                  "required": ["enabled", "windowMs", "max"]
                }
              },
              "required": ["compression", "caching", "rateLimiting"]
            },
            "cache": {
              "type": "object",
              "properties": {
                "redis": {
                  "type": "object",
                  "properties": {
                    "url": { "type": "string" },
                    "keyPrefix": { "type": "string" },
                    "ttl": { "type": "number" }
                  },
                  "required": ["url", "keyPrefix", "ttl"]
                }
              },
              "required": ["redis"]
            },
            "database": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "url": { "type": "string" },
                "migrations": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "autoRun": { "type": "boolean" }
                  },
                  "required": ["enabled", "autoRun"]
                }
              },
              "required": ["type", "url"]
            },
            "security": {
              "type": "object",
              "properties": {
                "cors": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "origin": { "type": "array", "items": { "type": "string" } },
                    "credentials": { "type": "boolean" }
                  },
                  "required": ["enabled", "origin", "credentials"]
                },
                "helmet": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "contentSecurityPolicy": { "type": "boolean" },
                    "hsts": { "type": "boolean" }
                  },
                  "required": ["enabled", "contentSecurityPolicy", "hsts"]
                }
              },
              "required": ["cors", "helmet"]
            },
            "metrics": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "port": { "type": "number" },
                "endpoint": { "type": "string" },
                "prometheus": {
                  "type": "object",
                  "properties": {
                    "enabled": { "type": "boolean" }
                  },
                  "required": ["enabled"]
                }
              },
              "required": ["enabled", "port", "endpoint", "prometheus"]
            },
            "notifications": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "events": {
                  "type": "object",
                  "properties": {
                    "startup": { "type": "boolean" },
                    "shutdown": { "type": "boolean" },
                    "error": { "type": "boolean" }
                  }
                },
                "providers": {
                  "type": "object",
                  "properties": {
                    "slack": {
                      "type": "object",
                      "properties": {
                        "enabled": { "type": "boolean" },
                        "webhook": { "type": "string" }
                      },
                      "required": ["enabled", "webhook"]
                    }
                  }
                }
              },
              "required": ["enabled"]
            },
            "debug": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "port": { "type": "number" }
              },
              "required": ["enabled", "port"]
            }
          },
          "required": ["name", "group", "appId"]
        }
      },
      "description": "Definitions of individual services."
    },
    "groups": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "description": { "type": "string" },
            "type": { "type": "string" },
            "services": {
              "type": "array",
              "items": { "type": "string" }
            },
            "autoStart": { "type": "boolean" },
            "enabled": { "type": "boolean" },
            "metadata": {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9_-]+$": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "required": ["id", "name", "type", "services"]
        }
      },
      "description": "Definitions of service groups."
    },
    "settings": {
      "type": "object",
      "properties": {
        "autoRestart": { "type": "boolean" },
        "maxRetries": { "type": "number" },
        "logRotation": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "maxSize": { "type": "string" },
            "maxFiles": { "type": "number" }
          },
          "required": ["enabled", "maxSize", "maxFiles"]
        }
      },
      "required": ["autoRestart", "maxRetries", "logRotation"]
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "number" },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "target": { "type": "string" }
            },
            "required": ["path", "target"]
          }
        }
      },
      "required": ["enabled", "port", "routes"]
    }
  },
  "required": ["version", "global", "services", "groups", "settings", "gateway"]
}
