          "cwd": "./test-service",
          "logFile": "logs/test-service.log",
          "enabled": true,
          "description": "Тестовый сервер",
          "priority": 3,
          "timeout": 30000,
          "retries": 2
        }
      ],
      "dependencies": [],
      "resources": {
        "maxMemory": "256MB",
        "maxCpu": "20%",
        "workerThreads": 1
      },
      "database": {
        "type": "sqlite",
        "url": "sqlite:./data/test-database.sqlite"
      },
      "logging": {
        "level": "debug",
        "format": "text",
        "file": "logs/test-service.log"
      },
      "debug": {
        "enabled": true,
        "port": 9229
      },
      "process": {
        "autostart": false,
        "restart": {
          "enabled": true,
          "maxRetries": 2,
          "interval": 5000
        }
      },
      "notifications": {
        "enabled": false
