{
  "global": {
    "logging": {
      "level": "info",
      "format": "json",
      "file": "logs/daemon.log",
      "rotation": {
        "enabled": true,
        "maxSize": "100MB",
        "maxFiles": 10
      }
    },
    "monitoring": {
      "enabled": true,
      "port": 9090
    },
    "security": {
      "ssl": {
        "enabled": false
      },
      "auth": {
        "enabled": false
      }
    }
  },
  "services": {
    "projects-manager-ui": {
      "appId": "projects-manager-ui",
      "name": "Projects Manager UI",
      "enabled": true,
      "group": "development",
      "autostart": true,
      "status": "running",
      "type": "web",
      "load": 25,
      "region": "local",
      "description": "Vue.js UI для управления проектами",
      "environment": {
        "NODE_ENV": "development",
        "VITE_PORT": "3000",
        "VITE_API_URL": "http://localhost:3012",
        "DEBUG": "true",
        "LOG_LEVEL": "debug"
      },
      "ports": [
        {
          "name": "dev-server",
          "envVar": "VITE_PORT",
          "value": 3000,
          "protocol": "http",
          "host": "0.0.0.0",
          "external": true,
          "timeout": 5000
        }
      ],
      "startCommands": [
        {
          "id": "dev-server",
          "name": "Development Server",
          "command": "npm",
          "args": [
            "run",
            "dev"
          ],
          "cwd": "../../root/projects-manager/ui",
          "logFile": "logs/ui-dev.log",
          "enabled": true,
          "description": "Запуск Vue.js dev сервера",
          "priority": 1,
          "timeout": 30000,
          "retries": 3,
          "retryDelay": 5000
        }
      ],
      "resources": {
        "maxMemory": "1GB",
        "maxCpu": "50%",
        "workerThreads": 2
      },
      "logging": {
        "level": "debug",
        "format": "text",
        "file": "logs/ui.log",
        "console": {
          "enabled": true,
          "colorize": true
        }
      },
      "process": {
        "autostart": true,
        "restart": {
          "enabled": true,
          "maxRetries": 5,
          "interval": 5000,
          "backoff": "exponential"
        },
        "gracefulShutdown": {
          "enabled": true,
          "timeout": 30000
        }
      },
      "dependencies": [
        "api-gateway"
      ],
      "notifications": {
        "enabled": true,
        "events": {
          "startup": true,
          "shutdown": true,
          "error": true
        }
      }
    },
    "desktop-app-clicker": {
      "name": "Desktop App Clicker",
      "description": "Desktop application for automation",
      "group": "automation",
      "status": "running",
      "type": "desktop",
      "load": 10,
      "region": "local",
      "autostart": false,
      "restart": {
        "enabled": true,
        "maxRetries": 3,
        "interval": 10000
      },
      "startCommands": [
        {
          "id": "clicker-service",
          "name": "Clicker Service",
          "command": "node",
          "args": [
            "index.js"
          ],
          "cwd": "./desktop-app-clicker",
          "logFile": "logs/clicker.log",
          "enabled": true,
          "description": "Сервис автоматизации кликов",
          "priority": 2,
          "timeout": 30000,
          "retries": 3
        }
      ],
      "dependencies": [],
      "appId": "desktop-app-clicker",
      "resources": {
        "maxMemory": "512MB",
        "maxCpu": "30%",
        "workerThreads": 1
      },
      "logging": {
        "level": "debug",
        "format": "text",
        "file": "logs/clicker.log"
      },
      "process": {
        "autostart": false,
        "restart": {
          "enabled": true,
          "maxRetries": 3,
          "interval": 10000
        }
      },
      "notifications": {
        "enabled": false
      }
    },
    "api-gateway": {
      "appId": "api-gateway",
      "name": "API Gateway",
      "enabled": true,
      "group": "production",
      "status": "running",
      "type": "api",
      "load": 80,
      "region": "local",
      "description": "API Gateway для всех сервисов",
      "environment": {
        "NODE_ENV": "production",
        "PORT": "3012",
        "DATABASE_URL": "sqlite:./data/database.sqlite",
        "REDIS_URL": "redis://localhost:6379",
        "LOG_LEVEL": "info",
        "CORS_ORIGIN": "*"
      },
      "ports": [
        {
          "name": "api-server",
          "envVar": "PORT",
          "value": 3012,
          "protocol": "http",
          "host": "0.0.0.0",
          "external": true,
          "timeout": 5000
        }
      ],
      "startCommands": [
        {
          "id": "gateway-server",
          "name": "API Server",
          "command": "node",
          "args": [
            "server.js"
          ],
          "cwd": "./api-gateway",
          "logFile": "logs/api-gateway.log",
          "enabled": true,
          "description": "API Gateway сервер",
          "priority": 1,
          "timeout": 30000,
          "retries": 3
        }
      ],
      "dependencies": [
        "test-service"
      ],
      "resources": {
        "maxMemory": "2GB",
        "maxCpu": "80%",
        "workerThreads": 4,
        "clusterMode": true,
        "loadBalancing": "round-robin"
      },
      "performance": {
        "compression": true,
        "compressionLevel": 6,
        "caching": {
          "enabled": true,
          "maxAge": 3600,
          "etag": true
        },
        "rateLimiting": {
          "enabled": true,
          "windowMs": 900000,
          "max": 1000
        }
      },
      "cache": {
        "redis": {
          "url": "redis://localhost:6379",
          "keyPrefix": "api:",
          "ttl": 3600
        }
      },
      "database": {
        "type": "sqlite",
        "url": "sqlite:./data/database.sqlite",
        "migrations": {
          "enabled": true,
          "autoRun": true
        }
      },
      "security": {
        "cors": {
          "enabled": true,
          "origin": [
            "http://localhost:3000",
            "http://localhost:5179"
          ],
          "credentials": true
        },
        "helmet": {
          "enabled": true,
          "contentSecurityPolicy": true,
          "hsts": true
        }
      },
      "logging": {
        "level": "info",
        "format": "json",
        "file": "logs/api-gateway.log",
        "rotation": {
          "enabled": true,
          "maxSize": "100MB",
          "maxFiles": 10
        }
      },
      "metrics": {
        "enabled": true,
        "port": 9091,
        "endpoint": "/metrics",
        "prometheus": {
          "enabled": true
        }
      },
      "process": {
        "autostart": true,
        "restart": {
          "enabled": true,
          "maxRetries": 10,
          "interval": 5000
        }
      },
      "notifications": {
        "enabled": true,
        "providers": {
          "slack": {
            "enabled": true,
            "webhook": "https://hooks.slack.com/..."
          }
        }
      }
    },
    "test-service": {
      "appId": "test-service",
      "name": "Test Service",
      "enabled": false,
      "group": "testing",
      "status": "error",
      "type": "api",
      "load": 5,
      "region": "local",
