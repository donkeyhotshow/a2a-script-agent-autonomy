{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Types Configuration Schema",
  "description": "Schema for defining different task types, quality thresholds, generation settings, and file naming conventions.",
  "type": "object",
  "properties": {
    "taskTypes": {
      "type": "object",
      "patternProperties": {
        "^[A-Z_]+$": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "templates": { "type": "array", "items": { "type": "string" } },
            "defaultTemplate": { "type": "string" },
            "fileExtensions": { "type": "array", "items": { "type": "string" } },
            "testFrameworks": { "type": "array", "items": { "type": "string" } },
            "defaultTestFramework": { "type": "string" }
          },
          "required": ["name", "description", "templates", "defaultTemplate", "fileExtensions", "testFrameworks", "defaultTestFramework"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Definitions for various task types, their templates, file extensions, and test frameworks."
    },
    "qualityThresholds": {
      "type": "object",
      "properties": {
        "syntaxCheck": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["required", "weight"],
          "additionalProperties": false
        },
        "linting": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["required", "weight"],
          "additionalProperties": false
        },
        "testCoverage": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "minPercentage": { "type": "integer", "minimum": 0, "maximum": 100 },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["required", "minPercentage", "weight"],
          "additionalProperties": false
        },
        "documentation": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["required", "weight"],
          "additionalProperties": false
        },
        "securityCheck": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["required", "weight"],
          "additionalProperties": false
        },
        "performanceCheck": {
          "type": "object",
          "properties": {
            "required": { "type": "boolean" },
            "weight": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["required", "weight"],
          "additionalProperties": false
        }
      },
      "required": ["syntaxCheck", "linting", "testCoverage", "documentation", "securityCheck", "performanceCheck"],
      "additionalProperties": false,
      "description": "Thresholds and requirements for code quality checks."
    },
    "generationSettings": {
      "type": "object",
      "properties": {
        "defaultIndentation": { "type": "string", "enum": ["spaces", "tabs"] },
        "indentationSize": { "type": "integer", "minimum": 2, "maximum": 8 },
        "includeJSDoc": { "type": "boolean" },
        "includeTypeScript": { "type": "boolean" },
        "includePropTypes": { "type": "boolean" },
        "generateTests": { "type": "boolean" },
        "generateDocumentation": { "type": "boolean" },
        "generateReadme": { "type": "boolean" }
      },
      "required": ["defaultIndentation", "indentationSize", "includeJSDoc", "includeTypeScript", "includePropTypes", "generateTests", "generateDocumentation", "generateReadme"],
      "additionalProperties": false,
      "description": "Settings for code generation, including formatting, documentation, and test generation."
    },
    "fileNaming": {
      "type": "object",
      "properties": {
        "component": {
          "type": "object",
          "properties": {
            "pattern": { "type": "string" },
            "suffix": { "type": "string" },
            "examples": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["pattern", "suffix", "examples"],
          "additionalProperties": false
        },
        "controller": {
          "type": "object",
          "properties": {
            "pattern": { "type": "string" },
            "suffix": { "type": "string" },
            "examples": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["pattern", "suffix", "examples"],
          "additionalProperties": false
        },
        "service": {
          "type": "object",
          "properties": {
            "pattern": { "type": "string" },
            "suffix": { "type": "string" },
            "examples": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["pattern", "suffix", "examples"],
          "additionalProperties": false
        },
        "test": {
          "type": "object",
          "properties": {
            "pattern": { "type": "string" },
            "suffix": { "type": "string" },
            "examples": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["pattern", "suffix", "examples"],
          "additionalProperties": false
        }
      },
      "required": ["component", "controller", "service", "test"],
      "additionalProperties": false,
      "description": "Conventions for file naming based on component type."
    }
  },
  "required": ["taskTypes", "qualityThresholds", "generationSettings", "fileNaming"],
  "additionalProperties": false
}
