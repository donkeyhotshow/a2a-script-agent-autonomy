{
  "taskTypes": {
    "COMPONENT": {
      "name": "Компонент",
      "description": "UI компонент для пользовательского интерфейса",
      "templates": [
        "react-component",
        "vue-component",
        "angular-component"
      ],
      "defaultTemplate": "react-component",
      "fileExtensions": [".jsx", ".tsx", ".vue", ".ts"],
      "testFrameworks": ["jest", "vitest", "cypress"],
      "defaultTestFramework": "jest"
    },
    "API": {
      "name": "API Эндпоинт",
      "description": "REST API контроллер или сервис",
      "templates": [
        "express-controller",
        "fastify-route",
        "koa-router"
      ],
      "defaultTemplate": "express-controller",
      "fileExtensions": [".js", ".ts"],
      "testFrameworks": ["jest", "supertest", "mocha"],
      "defaultTestFramework": "jest"
    },
    "TEST": {
      "name": "Система тестирования",
      "description": "Набор тестов для существующего кода",
      "templates": [
        "unit-tests",
        "integration-tests",
        "e2e-tests"
      ],
      "defaultTemplate": "unit-tests",
      "fileExtensions": [".test.js", ".spec.js", ".test.ts"],
      "testFrameworks": ["jest", "mocha", "jasmine"],
      "defaultTestFramework": "jest"
    },
    "CONFIG": {
      "name": "Конфигурация",
      "description": "Файлы конфигурации приложения",
      "templates": [
        "app-config",
        "database-config",
        "logging-config"
      ],
      "defaultTemplate": "app-config",
      "fileExtensions": [".js", ".json", ".yaml", ".env"],
      "testFrameworks": ["jest"],
      "defaultTestFramework": "jest"
    },
    "GENERAL": {
      "name": "Общая задача",
      "description": "Универсальный тип задачи",
      "templates": [
        "generic-module",
        "utility-function",
        "data-structure"
      ],
      "defaultTemplate": "generic-module",
      "fileExtensions": [".js", ".ts"],
      "testFrameworks": ["jest", "mocha"],
      "defaultTestFramework": "jest"
    }
  },
  "qualityThresholds": {
    "syntaxCheck": {
      "required": true,
      "weight": 0.2
    },
    "linting": {
      "required": true,
      "weight": 0.15
    },
    "testCoverage": {
      "required": true,
      "minPercentage": 80,
      "weight": 0.25
    },
    "documentation": {
      "required": false,
      "weight": 0.1
    },
    "securityCheck": {
      "required": true,
      "weight": 0.15
    },
    "performanceCheck": {
      "required": false,
      "weight": 0.15
    }
  },
  "generationSettings": {
    "defaultIndentation": "spaces",
    "indentationSize": 2,
    "includeJSDoc": true,
    "includeTypeScript": false,
    "includePropTypes": true,
    "generateTests": true,
    "generateDocumentation": true,
    "generateReadme": true
  },
  "fileNaming": {
    "component": {
      "pattern": "PascalCase",
      "suffix": "",
      "examples": ["UserList", "DataTable", "LoginForm"]
    },
    "controller": {
      "pattern": "PascalCase",
      "suffix": "Controller",
      "examples": ["UserController", "ProductController"]
    },
    "service": {
      "pattern": "PascalCase",
      "suffix": "Service",
      "examples": ["AuthService", "DatabaseService"]
    },
    "test": {
      "pattern": "camelCase",
      "suffix": ".test",
      "examples": ["userService.test.js", "loginComponent.test.js"]
    }
  },
  "metadata": {
    "created": "2024-09-08T03:00:00.000Z",
    "version": "1.0.0",
    "description": "Конфигурация типов задач"
  }
}
