{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Validation rules for all port-related fields",
  "fields": {
    "port": {
      "type": "integer",
      "min": 1,
      "max": 65535,
      "required": true,
      "errorMessages": {
        "required": "Порт обязателен для заполнения",
        "type": "Порт должен быть числом",
        "min": "Порт не может быть меньше 1",
        "max": "Порт не может быть больше 65535",
        "invalid": "Некорректный номер порта"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "required": true,
      "pattern": "^[a-zA-Z0-9а-яА-ЯёЁ\\s\\-_]+$",
      "errorMessages": {
        "required": "Название обязательно для заполнения",
        "minLength": "Название должно содержать минимум 1 символ",
        "maxLength": "Название не может превышать 100 символов",
        "pattern": "Название может содержать только буквы, цифры, пробелы, дефисы и подчеркивания"
      }
    },
    "protocol": {
      "type": "enum",
      "enumRef": "protocols",
      "required": true,
      "default": "tcp",
      "errorMessages": {
        "required": "Протокол обязателен для выбора",
        "enum": "Выберите корректный протокол из списка"
      }
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 500,
      "required": false,
      "errorMessages": {
        "maxLength": "Описание не может превышать 500 символов"
      }
    },
    "type": {
      "type": "enum",
      "enumRef": "types",
      "required": false,
      "default": "custom",
      "errorMessages": {
        "enum": "Выберите корректный тип из списка"
      }
    },
    "category": {
      "type": "enum",
      "enumRef": "categories",
      "required": false,
      "default": "custom",
      "errorMessages": {
        "enum": "Выберите корректную категорию из списка"
      }
    },
    "priority": {
      "type": "integer",
      "min": 0,
      "max": 100,
      "required": false,
      "default": 50,
      "errorMessages": {
        "type": "Приоритет должен быть числом",
        "min": "Приоритет не может быть меньше 0",
        "max": "Приоритет не может быть больше 100"
      }
    },
    "enabled": {
      "type": "boolean",
      "required": false,
      "default": true,
      "errorMessages": {
        "type": "Значение должно быть true или false"
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "required": false,
      "errorMessages": {
        "pattern": "Цвет должен быть в формате HEX (#RRGGBB)"
      }
    },
    "icon": {
      "type": "string",
      "maxLength": 100,
      "required": false,
      "errorMessages": {
        "maxLength": "Название иконки не может превышать 100 символов"
      }
    },
    "tags": {
      "type": "array",
      "itemType": "string",
      "maxItems": 10,
      "itemMaxLength": 50,
      "required": false,
      "errorMessages": {
        "maxItems": "Максимум 10 тегов",
        "itemMaxLength": "Каждый тег не может превышать 50 символов"
      }
    },
    "rangeFrom": {
      "type": "integer",
      "min": 1,
      "max": 65535,
      "required": true,
      "errorMessages": {
        "required": "Начало диапазона обязательно",
        "type": "Начало диапазона должно быть числом",
        "min": "Начало диапазона не может быть меньше 1",
        "max": "Начало диапазона не может быть больше 65535"
      }
    },
    "rangeTo": {
      "type": "integer",
      "min": 1,
      "max": 65535,
      "required": true,
      "errorMessages": {
        "required": "Конец диапазона обязателен",
        "type": "Конец диапазона должен быть числом",
        "min": "Конец диапазона не может быть меньше 1",
        "max": "Конец диапазона не может быть больше 65535"
      }
    },
    "rangeType": {
      "type": "enum",
      "enumRef": "rangeTypes",
      "required": false,
      "default": "allowed",
      "errorMessages": {
        "enum": "Выберите корректный тип диапазона"
      }
    },
    "systemName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "required": true,
      "errorMessages": {
        "required": "Название системы обязательно",
        "minLength": "Название системы должно содержать минимум 1 символ",
        "maxLength": "Название системы не может превышать 100 символов"
      }
    },
    "systemType": {
      "type": "enum",
      "enumRef": "systemTypes",
      "required": true,
      "default": "custom",
      "errorMessages": {
        "required": "Тип системы обязателен",
        "enum": "Выберите корректный тип системы"
      }
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "required": false,
      "default": "1.0.0",
      "errorMessages": {
        "pattern": "Версия должна быть в формате X.Y.Z (например: 1.0.0)"
      }
    },
    "environment": {
      "type": "enum",
      "enumRef": "environments",
      "required": false,
      "default": "development",
      "errorMessages": {
        "enum": "Выберите корректное окружение"
      }
    },
    "monitorInterval": {
      "type": "integer",
      "min": 5,
      "max": 300,
      "required": true,
      "errorMessages": {
        "required": "Интервал мониторинга обязателен",
        "type": "Интервал мониторинга должен быть числом",
        "min": "Интервал мониторинга не может быть меньше 5 секунд",
        "max": "Интервал мониторинга не может быть больше 300 секунд"
      }
    }
  }
}

