{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Configuration templates for common deployment scenarios",
  "templates": {
    "webServer": {
      "id": "webServer",
      "name": "Веб-сервер",
      "description": "Типичная конфигурация для веб-сервера с HTTP/HTTPS",
      "icon": "pi pi-globe",
      "category": "web",
      "singlePorts": [
        {
          "port": 80,
          "name": "HTTP",
          "protocol": "http",
          "type": "system",
          "category": "web",
          "enabled": true,
          "priority": 90
        },
        {
          "port": 443,
          "name": "HTTPS",
          "protocol": "https",
          "type": "system",
          "category": "web",
          "enabled": true,
          "priority": 95
        }
      ],
      "ranges": [
        {
          "from": 3000,
          "to": 3999,
          "description": "Диапазон для веб-приложений",
          "type": "allowed",
          "enabled": true
        }
      ],
      "system": {
        "name": "Web Server",
        "type": "web-server",
        "environment": "production"
      }
    },
    "apiServer": {
      "id": "apiServer",
      "name": "API-сервер",
      "description": "Конфигурация для REST/GraphQL API сервера",
      "icon": "pi pi-sitemap",
      "category": "api",
      "singlePorts": [
        {
          "port": 3000,
          "name": "REST API",
          "protocol": "http",
          "type": "service",
          "category": "api",
          "enabled": true,
          "priority": 80
        },
        {
          "port": 4000,
          "name": "GraphQL API",
          "protocol": "http",
          "type": "service",
          "category": "api",
          "enabled": true,
          "priority": 80
        }
      ],
      "ranges": [
        {
          "from": 3001,
          "to": 3999,
          "description": "Диапазон для API endpoints",
          "type": "allowed",
          "enabled": true
        }
      ],
      "system": {
        "name": "API Server",
        "type": "api-server",
        "environment": "production"
      }
    },
    "fullStack": {
      "id": "fullStack",
      "name": "Full-Stack приложение",
      "description": "Полная конфигурация с веб-сервером, API и базой данных",
      "icon": "pi pi-th-large",
      "category": "web",
      "singlePorts": [
        {
          "port": 80,
          "name": "HTTP Frontend",
          "protocol": "http",
          "type": "system",
          "category": "web",
          "enabled": true,
          "priority": 90
        },
        {
          "port": 443,
          "name": "HTTPS Frontend",
          "protocol": "https",
          "type": "system",
          "category": "web",
          "enabled": true,
          "priority": 95
        },
        {
          "port": 3000,
          "name": "Backend API",
          "protocol": "http",
          "type": "service",
          "category": "api",
          "enabled": true,
          "priority": 85
        },
        {
          "port": 5432,
          "name": "PostgreSQL",
          "protocol": "tcp",
          "type": "service",
          "category": "database",
          "enabled": true,
          "priority": 80
        },
        {
          "port": 6379,
          "name": "Redis Cache",
          "protocol": "tcp",
          "type": "service",
          "category": "cache",
          "enabled": true,
          "priority": 75
        }
      ],
      "ranges": [
        {
          "from": 3001,
          "to": 3999,
          "description": "Диапазон для микросервисов",
          "type": "allowed",
          "enabled": true
        }
      ],
      "system": {
        "name": "Full-Stack Application",
        "type": "web-server",
        "environment": "production"
      }
    },
    "developmentEnv": {
      "id": "developmentEnv",
      "name": "Среда разработки",
      "description": "Конфигурация для локальной разработки",
      "icon": "pi pi-code",
      "category": "development",
      "singlePorts": [
        {
          "port": 5173,
          "name": "Vite Dev Server",
          "protocol": "http",
          "type": "development",
          "category": "development",
          "enabled": true,
          "priority": 60
        },
        {
          "port": 3000,
          "name": "Backend Dev",
          "protocol": "http",
          "type": "development",
          "category": "development",
          "enabled": true,
          "priority": 60
        },
        {
          "port": 5432,
          "name": "PostgreSQL Dev",
          "protocol": "tcp",
          "type": "development",
          "category": "database",
          "enabled": true,
          "priority": 60
        },
        {
          "port": 6379,
          "name": "Redis Dev",
          "protocol": "tcp",
          "type": "development",
          "category": "cache",
          "enabled": true,
          "priority": 50
        }
      ],
      "ranges": [
        {
          "from": 3000,
          "to": 9999,
          "description": "Диапазон для разработки",
          "type": "allowed",
          "enabled": true
        }
      ],
      "system": {
        "name": "Development Environment",
        "type": "development",
        "environment": "development"
      }
    },
    "microservices": {
      "id": "microservices",
      "name": "Микросервисная архитектура",
      "description": "Конфигурация для микросервисов с шлюзом и балансировщиком",
      "icon": "pi pi-sitemap",
      "category": "api",
      "singlePorts": [
        {
          "port": 80,
          "name": "API Gateway",
          "protocol": "http",
          "type": "service",
          "category": "api",
          "enabled": true,
          "priority": 95
        },
        {
          "port": 50051,
          "name": "gRPC Gateway",
          "protocol": "tcp",
          "type": "service",
          "category": "api",
          "enabled": true,
          "priority": 90
        },
        {
          "port": 9090,
          "name": "Prometheus",
          "protocol": "http",
          "type": "service",
          "category": "monitoring",
          "enabled": true,
          "priority": 80
        },
        {
          "port": 3000,
          "name": "Grafana",
          "protocol": "http",
          "type": "service",
          "category": "monitoring",
          "enabled": true,
          "priority": 75
        }
      ],
      "ranges": [
        {
          "from": 8000,
          "to": 8999,
          "description": "Диапазон для микросервисов HTTP",
          "type": "allowed",
          "enabled": true
        },
        {
          "from": 50052,
          "to": 50099,
          "description": "Диапазон для микросервисов gRPC",
          "type": "allowed",
          "enabled": true
        }
      ],
      "system": {
        "name": "Microservices Platform",
        "type": "api-server",
        "environment": "production"
      }
    },
    "monitoringStack": {
      "id": "monitoringStack",
      "name": "Стек мониторинга",
      "description": "Полная конфигурация для мониторинга и логирования",
      "icon": "pi pi-chart-line",
      "category": "monitoring",
      "singlePorts": [
        {
          "port": 9090,
          "name": "Prometheus",
          "protocol": "http",
          "type": "service",
          "category": "monitoring",
          "enabled": true,
          "priority": 85
        },
        {
          "port": 3000,
          "name": "Grafana",
          "protocol": "http",
          "type": "service",
          "category": "monitoring",
          "enabled": true,
          "priority": 85
        },
        {
          "port": 9200,
          "name": "Elasticsearch",
          "protocol": "http",
          "type": "service",
          "category": "monitoring",
          "enabled": true,
          "priority": 80
        },
        {
          "port": 5601,
          "name": "Kibana",
          "protocol": "http",
          "type": "service",
          "category": "monitoring",
          "enabled": true,
          "priority": 80
        },
        {
          "port": 5044,
          "name": "Logstash",
          "protocol": "tcp",
          "type": "service",
          "category": "monitoring",
          "enabled": true,
          "priority": 75
        }
      ],
      "ranges": [],
      "system": {
        "name": "Monitoring Stack",
        "type": "custom",
        "environment": "production"
      }
    }
  }
}

