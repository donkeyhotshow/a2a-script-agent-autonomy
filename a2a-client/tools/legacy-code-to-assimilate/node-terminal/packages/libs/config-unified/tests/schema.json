{
  "type": "object",
  "properties": {
    "types": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "report": { "type": "string" }
          },
          "required": ["command", "report"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "appId": { "type": "string" },
          "types": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["appId", "types"],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created": { "type": "string", "format": "date-time" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["created", "version", "description"],
      "additionalProperties": false
    }
  },
  "required": ["types", "matrix", "metadata"],
  "additionalProperties": false
}
