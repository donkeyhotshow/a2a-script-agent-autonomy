{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Validation rules for Port Map fields",
  "fields": {
    "protocol": {
      "type": "string",
      "enumRef": "enums.protocols",
      "required": true,
      "errorMessages": {
        "required": "Protocol is required",
        "type": "Protocol must be a string",
        "enum": "Invalid protocol value"
      }
    },
    "status": {
      "type": "string",
      "enumRef": "enums.portStatus",
      "required": true,
      "errorMessages": {
        "required": "Status is required",
        "type": "Status must be a string",
        "enum": "Invalid status value"
      }
    }
  }
}
