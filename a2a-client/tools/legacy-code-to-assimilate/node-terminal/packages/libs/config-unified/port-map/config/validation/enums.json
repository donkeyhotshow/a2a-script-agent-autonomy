{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Enumerations for Port Map",
  "enums": {
    "protocols": {
      "values": [
        "tcp",
        "udp",
        "both",
        "all"
      ],
      "labels": {
        "tcp": "TCP",
        "udp": "UDP",
        "both": "TCP/UDP",
        "all": "All Protocols"
      },
      "descriptions": {
        "tcp": "Transmission Control Protocol",
        "udp": "User Datagram Protocol",
        "both": "Both TCP and UDP",
        "all": "All available network protocols"
      }
    },
    "portStatus": {
      "values": [
        "active",
        "inactive",
        "conflicting",
        "all"
      ],
      "labels": {
        "active": "Active",
        "inactive": "Inactive",
        "conflicting": "Conflicting",
        "all": "All Statuses"
      },
      "descriptions": {
        "active": "Port is currently in use and operational.",
        "inactive": "Port is available but not currently in use.",
