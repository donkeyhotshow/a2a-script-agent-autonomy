{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Error Handling Configuration Schema",
  "description": "Schema for the unified error handling configuration.",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Global enable/disable for error handling."
    },
    "logLevel": {
      "type": "string",
      "enum": ["error", "warn", "info", "debug", "trace"],
      "description": "Global minimum log level for error handling."
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0,
      "description": "Maximum number of retries for error-related operations."
    },
    "retryDelay": {
      "type": "integer",
      "minimum": 0,
      "description": "Delay between retries in milliseconds."
    },
    "batchSize": {
      "type": "integer",
      "minimum": 1,
      "description": "Batch size for processing errors/tasks."
    },
    "system": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      },
      "required": ["name", "version"],
      "description": "System information."
    },
    "directories": {
      "type": "object",
      "properties": {
        "work": {"type": "string"},
        "errors": {"type": "string"},
        "reports": {"type": "string"},
        "backups": {"type": "string"},
        "logs": {"type": "string"},
        "errorLogs": {"type": "string"}
      },
      "required": ["work", "errors", "reports", "backups", "logs", "errorLogs"],
      "description": "Directory paths for error handling components."
    },
    "taskManager": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "autoCreateTasks": {"type": "boolean"},
        "taskCategories": {
          "type": "array",
          "items": {"type": "string"}
        },
        "defaultPriority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
        "database": {
          "type": "object",
          "properties": {
            "path": {"type": "string"},
            "backup": {"type": "boolean"},
            "backupInterval": {"type": "integer", "minimum": 0}
          },
          "required": ["path", "backup", "backupInterval"]
        },
        "tasks": {
          "type": "object",
          "properties": {
            "maxRetries": {"type": "integer", "minimum": 0},
            "retryDelay": {"type": "integer", "minimum": 0},
            "timeout": {"type": "integer", "minimum": 0},
            "autoResolve": {"type": "boolean"}
          },
          "required": ["maxRetries", "retryDelay", "timeout", "autoResolve"]
        },
        "cleanup": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "integer", "minimum": 0},
            "maxAge": {"type": "integer", "minimum": 0},
            "keepResolved": {"type": "boolean"}
          },
          "required": ["enabled", "interval", "maxAge", "keepResolved"]
        },
        "notifications": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "criticalOnly": {"type": "boolean"},
            "webhook": {"type": "string"},
            "email": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "smtp": {"type": "string"},
                "user": {"type": "string"},
                "pass": {"type": "string"},
                "from": {"type": "string"},
                "to": {"type": "string"}
              },
              "required": ["enabled", "smtp", "user", "pass", "from", "to"]
            }
          },
          "required": ["enabled", "criticalOnly", "webhook", "email"]
        },
        "cli": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "commands": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "required": ["enabled", "commands"]
        }
      },
      "required": ["enabled", "autoCreateTasks", "taskCategories", "defaultPriority", "database", "tasks", "cleanup", "notifications", "cli"],
      "description": "Task Manager configuration."
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "interval": {"type": "integer", "minimum": 0},
        "metrics": {
          "type": "object",
          "properties": {
            "diskSpace": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "threshold": {"type": "integer", "minimum": 0, "maximum": 100}
              },
              "required": ["enabled", "threshold"]
            },
            "memoryUsage": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "threshold": {"type": "integer", "minimum": 0, "maximum": 100}
              },
              "required": ["enabled", "threshold"]
            },
            "cpuUsage": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "threshold": {"type": "integer", "minimum": 0, "maximum": 100}
              },
              "required": ["enabled", "threshold"]
            },
            "processCount": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "threshold": {"type": "integer", "minimum": 0}
              },
              "required": ["enabled", "threshold"]
            }
          },
          "required": ["diskSpace", "memoryUsage", "cpuUsage", "processCount"]
        },
        "alerts": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "immediate": {"type": "boolean"}
              },
              "required": ["enabled", "immediate"]
            },
            "high": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "delay": {"type": "integer", "minimum": 0}
              },
              "required": ["enabled", "delay"]
            },
            "medium": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "delay": {"type": "integer", "minimum": 0}
              },
              "required": ["enabled", "delay"]
            },
            "low": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"}
              },
              "required": ["enabled"]
            }
          },
          "required": ["critical", "high", "medium", "low"]
        },
        "threshold": {"type": "integer", "minimum": 0},
        "notifications": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "webhook": {"type": "string"},
            "email": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "smtp": {"type": "string"},
                "user": {"type": "string"},
                "pass": {"type": "string"},
                "from": {"type": "string"},
                "to": {"type": "string"}
              },
              "required": ["enabled", "smtp", "user", "pass", "from", "to"]
            }
          },
          "required": ["enabled", "webhook", "email"]
        }
      },
      "required": ["enabled", "interval", "metrics", "alerts", "threshold", "notifications"],
      "description": "Monitoring configuration."
    },
    "logging": {
      "type": "object",
      "properties": {
        "level": {"type": "string", "enum": ["error", "warn", "info", "debug", "trace"]},
        "format": {"type": "string", "enum": ["json", "text"]},
        "timestamp": {"type": "boolean"},
        "file": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "path": {"type": "string"},
            "maxSize": {"type": "string"},
            "maxFiles": {"type": "integer", "minimum": 1},
            "compress": {"type": "boolean"}
          },
          "required": ["enabled", "path", "maxSize", "maxFiles", "compress"]
        },
        "console": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "colors": {"type": "boolean"},
            "timestamp": {"type": "boolean"}
          },
          "required": ["enabled", "colors", "timestamp"]
        },
        "levels": {
          "type": "object",
          "properties": {
            "error": {
              "type": "object",
              "properties": {
                "file": {"type": "boolean"},
                "console": {"type": "boolean"},
                "notify": {"type": "boolean"}
              },
              "required": ["file", "console", "notify"]
            },
            "warn": {
              "type": "object",
              "properties": {
                "file": {"type": "boolean"},
                "console": {"type": "boolean"},
                "notify": {"type": "boolean"}
              },
              "required": ["file", "console", "notify"]
            },
            "info": {
              "type": "object",
              "properties": {
                "file": {"type": "boolean"},
                "console": {"type": "boolean"},
                "notify": {"type": "boolean"}
              },
              "required": ["file", "console", "notify"]
            },
            "debug": {
              "type": "object",
              "properties": {
                "file": {"type": "boolean"},
                "console": {"type": "boolean"},
                "notify": {"type": "boolean"}
              },
              "required": ["file", "console", "notify"]
            }
          },
          "required": ["error", "warn", "info", "debug"]
        },
        "filters": {
          "type": "object",
          "properties": {
            "excludePatterns": {
              "type": "array",
              "items": {"type": "string"}
            },
            "includePatterns": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "required": ["excludePatterns", "includePatterns"]
        },
        "errorLogging": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "level": {"type": "string", "enum": ["error", "warn", "info", "debug", "trace"]},
            "file": {"type": "boolean"},
            "console": {"type": "boolean"}
          },
          "required": ["enabled", "level", "file", "console"]
        },
        "requestLogging": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "level": {"type": "string", "enum": ["error", "warn", "info", "debug", "trace"]},
            "file": {"type": "boolean"},
            "console": {"type": "boolean"}
          },
          "required": ["enabled", "level", "file", "console"]
        }
      },
      "required": ["level", "format", "timestamp", "file", "console", "levels", "filters", "errorLogging", "requestLogging"],
      "description": "Logging configuration."
    },
    "notifications": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "webhook": {"type": "string"},
        "email": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "smtp": {"type": "string"},
            "user": {"type": "string"},
            "pass": {"type": "string"},
            "from": {"type": "string"},
            "to": {"type": "string"}
          },
          "required": ["enabled", "smtp", "user", "pass", "from", "to"]
        }
      },
      "required": ["enabled", "webhook", "email"],
      "description": "Notifications configuration."
    },
    "templates": {
      "type": "object",
      "properties": {
        "default": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "critical": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"},
            "notify": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate", "notify"]
        },
        "warning": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "info": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "memory": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "network": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "database": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "file": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "port": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "config": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "auth": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        },
        "timeout": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "description": {"type": "string"},
            "priority": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
            "autoCreate": {"type": "boolean"}
          },
          "required": ["title", "description", "priority", "autoCreate"]
        }
      },
      "required": ["default", "critical", "warning", "info", "memory", "network", "database", "file", "port", "config", "auth", "timeout"],
      "description": "Error message templates."
    },
    "priorities": {
      "type": "object",
      "properties": {
        "low": {
          "type": "object",
          "properties": {
            "color": {"type": "string"},
            "icon": {"type": "string"},
            "autoResolve": {"type": "boolean"}
          },
          "required": ["color", "icon", "autoResolve"]
        },
        "medium": {
          "type": "object",
          "properties": {
            "color": {"type": "string"},
            "icon": {"type": "string"},
            "autoResolve": {"type": "boolean"}
          },
          "required": ["color", "icon", "autoResolve"]
        },
        "high": {
          "type": "object",
          "properties": {
            "color": {"type": "string"},
            "icon": {"type": "string"},
            "autoResolve": {"type": "boolean"}
          },
          "required": ["color", "icon", "autoResolve"]
        },
        "critical": {
          "type": "object",
          "properties": {
            "color": {"type": "string"},
            "icon": {"type": "string"},
            "autoResolve": {"type": "boolean"},
            "immediate": {"type": "boolean"}
          },
          "required": ["color", "icon", "autoResolve", "immediate"]
        }
      },
      "required": ["low", "medium", "high", "critical"],
      "description": "Error priority definitions."
    }
  },
  "required": [
    "enabled",
    "logLevel",
    "maxRetries",
    "retryDelay",
    "batchSize",
    "system",
    "directories",
    "taskManager",
    "monitoring",
    "logging",
    "notifications",
    "templates",
    "priorities"
  ]
}
