{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Projects Configuration",
  "description": "Schema for managing development projects and their properties.",
  "type": "object",
  "properties": {
    "projects": {
      "type": "array",
      "description": "List of configured projects.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Unique ID for the project" },
          "name": { "type": "string", "minLength": 1, "description": "Project name" },
          "status": { "type": "string", "enum": ["active", "archived", "on-hold", "completed"], "default": "active" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50, "description": "Priority for project visibility or resource allocation" },
          "description": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date" },
          "created": { "type": "string", "format": "date-time" },
          "updated": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "name", "status"],
        "additionalProperties": true
      },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created": { "type": "string", "format": "date-time" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["created", "version"],
      "additionalProperties": false
    }
  },
  "required": ["projects", "metadata"],
  "additionalProperties": false
}

