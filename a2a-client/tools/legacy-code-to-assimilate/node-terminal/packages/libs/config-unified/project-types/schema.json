{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unified Project Types Configuration Schema",
  "description": "Schema for defining various project types and their configurations.",
  "type": "object",
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "created": { "type": "string", "format": "date-time" },
        "version": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["created", "version", "description"]
    },
    "projectTypes": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "detection": {
              "type": "object",
              "properties": {
                "files": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "dependencies": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["files"]
            },
            "config": {
              "type": "object",
              "properties": {
                "port": { "type": "integer", "minimum": 0 },
                "startCommand": { "type": "string" },
                "startScriptPatterns": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              },
              "required": ["port", "startCommand"]
            }
          },
          "required": ["name", "detection", "config"]
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["metadata", "projectTypes"],
  "additionalProperties": false
}
