{
  "name": "@mcp/core-utils",
  "version": "1.0.0",
  "description": "Универсальные утилиты для всего проекта",
  "main": "formatters.js",
  "type": "commonjs",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "utils",
    "utilities",
    "helpers",
    "file",
    "string",
    "date",
    "validation",
    "cross-platform"
  ],
  "author": "Apps Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "file://C:/apps"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "*.js",
      "!**/node_modules/**",
      "!**/tests/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
