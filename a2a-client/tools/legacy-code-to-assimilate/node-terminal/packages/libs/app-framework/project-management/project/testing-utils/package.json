{
  "name": "@mcp/project-testing-utils",
  "version": "1.0.0",
  "description": "Utilities for testing project modules",
  "main": "index.js",
  "scripts": {
    "test": "jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@mcp/utils-file-system": "*",
    "@mcp/utils-logging": "*",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "@babel/core": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "babel-jest": "^30.0.5"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/unit/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@libs/(.*)$": "<rootDir>/../../$1"
    },
    "transform": {
      "^(.*\\\\.js|\\\\.ts)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!eventemitter3)"
    ]
  }
}
