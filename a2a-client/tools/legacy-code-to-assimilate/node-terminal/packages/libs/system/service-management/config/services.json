{
  "version": "1.0.0",
  "services": {
    "projects-manager-ui": {
      "appId": "projects-manager-ui",
      "name": "Projects Manager UI",
      "enabled": true,
      "group": "development",
      "autostart": true,
      "status": "running",
      "type": "web",
      "load": 25,
      "region": "eu-west",
      "startCommands": [
        {
          "id": "dev-server",
          "name": "Development Server",
          "command": "cmd.exe",
          "args": [
            "/c",
            "C:\\Program Files\\nodejs\\npm.cmd",
            "run",
            "dev"
          ],
          "cwd": "../../root/projects-manager/ui",
          "logFile": "logs/ui-dev.log",
          "enabled": true,
          "description": "Запуск Vue.js dev сервера",
          "port": 5179,
          "stdio": "pipe"
        }
      ],
      "dependencies": [
        "api-gateway"
      ]
    },
    "desktop-app-clicker": {
      "name": "Desktop App Clicker",
      "description": "Desktop application for automation",
      "group": "automation",
      "status": "running",
      "type": "desktop",
      "load": 10,
      "region": "local",
      "autostart": false,
      "restart": {
        "enabled": true,
        "maxRetries": 3,
        "interval": 5000
      },
      "startCommands": [
        {
          "id": "clicker-service",
          "name": "Clicker Service",
          "command": "node",
          "args": [
            "index.js"
          ],
          "cwd": "./desktop-app-clicker",
          "logFile": "logs/clicker.log",
          "enabled": true,
          "description": "Сервис автоматизации кликов",
          "port": 3012,
          "stdio": "pipe"
        }
      ],
      "dependencies": []
    },
    "api-gateway": {
      "appId": "api-gateway",
      "name": "API Gateway",
      "enabled": false,
      "group": "production",
      "status": "running",
      "type": "api",
      "load": 80,
      "region": "us-east",
      "startCommands": [
        {
          "id": "gateway-server",
          "name": "Gateway Server",
          "command": "node",
          "args": [
            "server.js"
          ],
          "cwd": "./api-gateway",
          "logFile": "logs/gateway.log",
          "enabled": true,
          "description": "API Gateway сервер",
          "port": 3012,
          "stdio": "pipe"
        }
      ],
      "dependencies": [
        "test-service"
      ]
    },
    "test-service": {
      "appId": "test-service",
      "name": "Test Service",
      "enabled": false,
      "group": "testing",
      "status": "error",
      "type": "api",
      "load": 5,
      "region": "us-east",
      "startCommands": [
        {
          "id": "test-server",
          "name": "Test Server",
          "command": "node",
          "args": [
            "test-server.js"
          ],
          "cwd": "./test-service",
          "logFile": "logs/test-service.log",
          "enabled": false,
          "description": "Тестовый сервис для разработки",
          "port": 3002,
          "stdio": "pipe"
        }
      ],
      "dependencies": []
    },
    "admin-app": {
      "appId": "admin-app",
      "name": "Admin App",
      "enabled": false,
      "group": "tools",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\opt\\projects\\admin-app"
        }
      ]
    },
    "context-gates": {
      "appId": "context-gates",
      "name": "Context Gates",
      "enabled": false,
      "group": "tools",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\opt\\projects\\context-gates"
        }
      ]
    },
    "integrated-autoclicker": {
      "appId": "integrated-autoclicker",
      "name": "Integrated Autoclicker",
      "enabled": false,
      "group": "automation",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\opt\\projects\\integrated-autoclicker"
        }
      ]
    },
    "neural-train-and-chat": {
      "appId": "neural-train-and-chat",
      "name": "Neural Train and Chat",
      "enabled": false,
      "group": "ai",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\opt\\projects\\neural-train-and-chat"
        }
      ]
    },
    "outsource-code-to-the-json": {
      "appId": "outsource-code-to-the-json",
      "name": "Outsource Code to the JSON",
      "enabled": false,
      "group": "tools",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\opt\\projects\\outsource-code-to-the-json"
        }
      ]
    },
    "prompt-sequences": {
      "appId": "prompt-sequences",
      "name": "Prompt Sequences",
      "enabled": false,
      "group": "ai",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\opt\\projects\\prompt-sequences"
        }
      ]
    },
    "autoclicker": {
      "appId": "autoclicker",
      "name": "Autoclicker",
      "enabled": false,
      "group": "automation",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\usr\\local\\autoclicker"
        }
      ]
    },
    "debug-tools": {
      "appId": "debug-tools",
      "name": "Debug Tools",
      "enabled": false,
      "group": "tools",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\usr\\local\\debug-tools"
        }
      ]
    },
    "execution-manager": {
      "appId": "execution-manager",
      "name": "Execution Manager",
      "enabled": false,
      "group": "tools",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\usr\\local\\execution-manager"
        }
      ]
    },
    "projects-manager": {
      "appId": "projects-manager",
      "name": "Projects Manager",
      "enabled": true,
      "group": "system",
      "autostart": true,
      "startCommands": [
        {
          "id": "start-apps-watchdog",
          "name": "Start Apps Watchdog",
          "command": "node",
          "args": [
            "app.js"
          ],
          "cwd": ".",
          "logFile": "logs/projects-manager.log",
          "enabled": true,
          "description": "Основной сервер Projects Manager",
          "port": 3012,
          "stdio": "pipe"
        }
      ]
    },
    "main-gateway": {
      "appId": "main-gateway",
      "name": "Main Gateway",
      "enabled": false,
      "group": "production",
      "startCommands": [
        {
          "id": "start",
          "name": "Start",
          "command": "npm",
          "args": [
            "start"
          ],
          "cwd": "C:\\apps\\root\\services\\main-gateway"
        }
      ]
    }
  },
  "groups": {
    "development": {
      "id": "development",
      "name": "Development Environment",
      "description": "Группа сервисов для разработки",
      "type": "project",
      "services": [
        "projects-manager-ui"
      ],
      "autoStart": true,
      "enabled": true,
      "metadata": {
        "environment": "development",
        "priority": "high"
      }
    },
    "production": {
      "id": "production",
      "name": "Production Environment",
      "description": "Группа сервисов для production",
      "type": "project",
      "services": [
        "api-gateway"
      ],
      "autoStart": false,
      "enabled": true,
      "metadata": {
        "environment": "production",
        "priority": "critical"
      }
    },
    "automation": {
      "id": "automation",
      "name": "Automation Tools",
      "description": "Инструменты автоматизации",
      "type": "group",
      "services": [
        "desktop-app-clicker"
      ],
      "autoStart": false,
      "enabled": true,
      "metadata": {
        "category": "tools",
        "priority": "medium"
      }
    },
    "testing": {
      "id": "testing",
      "name": "Testing Services",
      "description": "Сервисы для тестирования",
      "type": "group",
      "services": [
        "test-service"
      ],
      "autoStart": false,
      "enabled": false,
      "metadata": {
        "category": "testing",
        "priority": "low"
      }
    },
    "ai": {
      "id": "ai",
      "name": "AI Services",
      "description": "Сервисы для работы с нейронными сетями",
      "type": "group",
      "services": [
        "neural-train-and-chat",
        "json-ml",
        "ml-dron"
      ],
      "autoStart": false,
      "enabled": true,
      "metadata": {
        "category": "ai",
        "priority": "high"
      }
    },
    "tools": {
      "id": "tools",
      "name": "Development Tools",
      "description": "Инструменты для разработки",
      "type": "group",
      "services": [
        "admin-app",
        "context-gates",
        "integrated-autoclicker",
        "outsource-code-to-the-json",
        "prompt-sequences",
        "autoclicker",
        "debug-tools",
        "execution-manager",
        "node-terminal",
        "projects-manager"
      ],
      "autoStart": false,
      "enabled": true,
      "metadata": {
        "category": "tools",
        "priority": "medium"
      }
    }
  },
  "settings": {
    "autoRestart": true,
    "maxRetries": 3,
    "healthCheckInterval": 30000,
    "logRotation": {
      "enabled": true,
      "maxSize": "10MB",
      "maxFiles": 5
    }
  },
  "gateway": {
    "enabled": true,
    "port": 3012,
    "routes": [
      {
        "path": "/api/*",
        "target": "http://localhost:3000"
      }
    ]
  }
}