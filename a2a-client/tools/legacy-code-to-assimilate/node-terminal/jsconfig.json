{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@libs/*": [
        "../../../libs/*"
      ],
      "@root/*": [
        "../../../root/*"
      ]
    },
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "**/*.js",
    "**/*.cjs"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "**/build"
  ]
}
