{
  "name": "a2a-client",
  "version": "1.0.0",
  "private": true,
  "description": "A2A Client - indexing, search, agent",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api": "npm run test --prefix ../a2a-server -- tests/integration",
    "test:web": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "dev": "vite"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "cross-env": "^7.0.3",
    "node-fetch": "^2.7.0",
    "supertest": "^6.3.4",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
