{
  "name": "@a2a-client/root",
  "version": "1.0.0",
  "private": true,
  "description": "A2A Client - indexing, search, agent",
  "workspaces": ["packages/*", "kernel/"],
  "scripts": {
    "test": "vitest run",
    "test:human-review": "node scripts/run-human-review.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:client-api": "vitest run tests/integration/api-server-sessions.test.js",
    "smoke:client": "node ./scripts/smoke-client-api.mjs",
    "verify:client": "npm run test:client-api",
    "test:api": "npm run test --prefix ../a2a-server -- tests/integration",
    "test:web": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:simulation": "playwright test tests/e2e/simulation-driven.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "dev": "vite",
    "dev:local": "vite",
    "build": "vite build --config vite.config.prod.ts",
    "build:web": "vite build --config vite.config.prod.ts",
    "build:analyze": "cross-env ANALYZE=true vite build --config vite.config.prod.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx --fix",
    "type-check": "vue-tsc --noEmit",
    "cli": "tsx ./cli/index.ts",
    "cleanup:sessions": "node ./scripts/cleanup-sessions.mjs",
    "cleanup:sessions:dry-run": "node ./scripts/cleanup-sessions.mjs --dry-run",
    "repair:session-steps": "node ./scripts/repair-session-step-artifacts.mjs",
    "repair:session-steps:dry-run": "node ./scripts/repair-session-step-artifacts.mjs --dry-run"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@vitest/ui": "^4.0.18",
    "cross-env": "^7.0.3",
    "jsdom": "^28.1.0",
    "node-fetch": "^2.7.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "supertest": "^6.3.4",
    "tsx": "^4.21.0",
    "vite": "^5.4.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@a2a-client/vite-plugin": "file:packages/vite-plugin",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "uuid": "^13.0.0",
    "vue": "^3.4.0",
    "zod": "^3.22.4"
  },
  "type": "module"
}
