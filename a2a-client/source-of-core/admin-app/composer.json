{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-exif": "*",
        "ext-ftp": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "fakerphp/faker": "^1.23",
        "flow/jsonpath": "^0.5.0",
        "guzzlehttp/guzzle": "^7.2",
        "inertiajs/inertia-laravel": "^2.0",
        "justinrainbow/json-schema": "^6.3",
        "laravel/framework": "^11.1",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "league/flysystem-sftp-v3": "^3.29",
        "league/glide-symfony": "^2.0",
        "openai-php/client": "*",
        "php-ai/php-ml": "^0.10.0",
        "phpoffice/phpspreadsheet": "^2.2.2",
        "phpseclib/phpseclib": "^3.0",
        "softcreatr/jsonpath": "^0.10.0",
        "spatie/error-solutions": "^1.1",
        "spatie/laravel-sluggable": "^3.6",
        "webnuvola/laravel-json-ld": "^2.1"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "phpunit/phpunit": "^11.5",
        "roave/security-advisories": "dev-latest",
        "sebastian/environment": "^7.2",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "App\\Engine\\": "app-manager/engine/",
            "App\\Engine\\TaskValidation\\": "app-manager/engine/TaskValidation/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Traits\\": "../../libs/php-traits/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\Tests\\Unit\\": "tests/Unit/",
            "App\\Script\\FixIndexer\\": "script/fix/src/Indexer/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "compile": [
            "@php artisan migrate:fresh "
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
