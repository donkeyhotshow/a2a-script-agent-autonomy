{
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "required": false,
            "description": "Unique identifier for the component"
        },
        "class": {
            "type": "string",
            "required": false,
            "description": "CSS class names"
        },
        "style": {
            "type": ["string", "object"],
            "required": false,
            "description": "Inline CSS styles"
        },
        "disabled": {
            "type": "boolean",
            "required": false,
            "default": false,
            "description": "Disables the component"
        },
        "title": {
            "type": "string",
            "required": false,
            "description": "Tooltip text on hover"
        },
        "tabindex": {
            "type": ["string", "number"],
            "required": false,
            "description": "Tab order for keyboard navigation"
        }
    }
}
