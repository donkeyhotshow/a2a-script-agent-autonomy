{
    "componentName": "divider",
    "description": "PrimeVue divider component.",
    "level": 5,
    "status": "ready",
    "dependencies": [],
    "_comment": "Validation expects properties within a 'props' object.",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for PrimeVue divider properties and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "layout": {
                            "type": "string",
                            "required": false,
                            "options": [
                                "horizontal",
                                "vertical"
                            ],
                            "default": "horizontal"
                        },
                        "align": {
                            "type": "string",
                            "required": false,
                            "options": [
                                "left",
                                "center",
                                "right",
                                "top",
                                "bottom"
                            ],
                            "description": "Alignment of content when divider has children."
                        },
                        "pt": {
                            "type": "object",
                            "required": false
                        },
                        "ptOptions": {
                            "type": "object",
                            "required": false
                        },
                        "unstyled": {
                            "type": "boolean",
                            "required": false,
                            "default": false
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Optional content placed within the divider (used with align prop).",
                "nestedValidation": {
                    "_allowString": true,
                    "_allowAnyObject": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored placeholder rule to standard V1 format (using 'props').",
        "Level updated to 5.",
        "Added common PrimeVue divider properties."
    ]
}
