{
    "componentName": "Column",
    "description": "Used within Grid component to define column layout.",
    "level": 1,
    "status": "ready",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "dependencies": [
        "Grid"
    ],
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "children": {
                "type": "array",
                "required": false,
                "nestedValidation": {
                    "_allowAnyObject": true,
                    "_allowString": true
                }
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for Column attributes.",
                "nestedValidation": {
                    "structure": {
                        "name": {
                            "type": "string",
                            "required": false,
                            "description": "Optional name identifier for the column."
                        },
                        "size": {
                            "type": [
                                "number",
                                "string"
                            ],
                            "required": false,
                            "description": "Column size definition (e.g., span count, fixed width). Depends on parent Grid implementation."
                        },
                        "key": {
                            "type": [
                                "string",
                                "number"
                            ],
                            "required": false
                        },
                        "ref": {
                            "type": "string",
                            "required": false
                        },
                        "pt": {
                            "type": "object",
                            "required": false
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Assumes usage within a Grid component. Validation rules might need adjustment based on actual grid system."
    ]
}
