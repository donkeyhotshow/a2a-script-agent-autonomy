{
    "componentName": "Icon",
    "description": "Displays an icon, typically using CSS classes.",
    "level": 3,
    "status": "active",
    "dependencies": [],
    "_comment": "Validation expects properties within a 'props' object.",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Icon does not typically accept children.",
                "nestedValidation": {
                    "_blockAll": true
                }
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for icon properties and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "name": {
                            "type": "string",
                            "required": false,
                            "description": "The name of the icon (e.g. 'pi pi-check')"
                        },
                        "spin": {
                            "type": "boolean",
                            "required": false,
                            "default": false,
                            "description": "Applies spin animation (PrimeIcons)."
                        },
                        "pt": {
                            "type": "object",
                            "required": false
                        },
                        "ptOptions": {
                            "type": "object",
                            "required": false,
                            "description": "PassThrough options."
                        },
                        "unstyled": {
                            "type": "boolean",
                            "required": false,
                            "default": false
                        },
                        "aria-label": {
                            "type": "string",
                            "required": false
                        },
                        "aria-hidden": {
                            "type": "boolean",
                            "required": false,
                            "default": true
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "requiresModel": false,
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": []
}
