{
    "componentName": "InputGroupAddon",
    "description": "Adds text, buttons or icons to the start or end of an input group.",
    "level": 3,
    "status": "ready",
    "dependencies": [
        "InputGroup"
    ],
    "_comment": "Validation expects properties within a 'props' object.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for standard HTML attributes applied to the addon span.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Content of the addon (text, icon, button, etc.).",
                "nestedValidation": {
                    "_allowAnyObject": true,
                    "_allowString": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard V1 format (using 'props').",
        "PrimeVue component: InputGroupAddon",
        "Used within InputGroup."
    ],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
