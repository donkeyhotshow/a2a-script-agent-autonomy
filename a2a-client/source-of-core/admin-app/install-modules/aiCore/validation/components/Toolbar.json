{
    "componentName": "Toolbar",
    "description": "Displays alignment groups for commands or content.",
    "level": 2,
    "status": "ready",
    "dependencies": [],
    "_comment": "Validation expects properties within a 'props' object.",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for PrimeVue Toolbar properties and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "aria-labelledby": {
                            "type": "string",
                            "required": false,
                            "description": "ARIA label association."
                        },
                        "pt": {
                            "type": "object",
                            "required": false
                        },
                        "ptOptions": {
                            "type": "object",
                            "required": false
                        },
                        "unstyled": {
                            "type": "boolean",
                            "required": false,
                            "default": false
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Toolbar content is defined via slots (start, center, end). Children usually blocked.",
                "nestedValidation": {
                    "_blockAll": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard V1 format (using 'props').",
        "PrimeVue component: Toolbar",
        "Content should be placed in 'start', 'center', or 'end' slots."
    ]
}
