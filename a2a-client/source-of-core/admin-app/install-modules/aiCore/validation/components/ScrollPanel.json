{
    "componentName": "ScrollPanel",
    "description": "PrimeVue ScrollPanel component wrapper.",
    "level": 3,
    "status": "ready",
    "dependencies": [
        "PrimeVue"
    ],
    "_comment": "Validation rules using the 'props' structure. Requires review based on PrimeVue docs.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "nestedValidation": {
                    "structure": {
                        "step": {
                            "type": "number",
                            "required": false,
                            "description": "Step factor for smooth scrolling."
                        },
                        "pt": {
                            "type": "object",
                            "required": false
                        },
                        "ptOptions": {
                            "type": "object",
                            "required": false
                        },
                        "unstyled": {
                            "type": "boolean",
                            "required": false
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "nestedValidation": {
                    "_allowAnyObject": true,
                    "_allowString": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard structure V1 (using 'props').",
        "Level updated to 1.",
        "Status set to ready, but rules are basic and require verification against PrimeVue ScrollPanel documentation.",
        "Added common PT props."
    ],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
