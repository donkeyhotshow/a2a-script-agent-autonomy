{
    "componentName": "Form",
    "description": "Represents an HTML <form> element, potentially with custom handling.",
    "level": 1,
    "status": "active",
    "dependencies": [],
    "_comment": "Validation rules for the Form component, using nestedValidation structure.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "type": {
                "_description": "Implicitly validated component type key",
                "_internal": true
            },
            "comment": {
                "type": "string",
                "required": false,
                "description": "Developer comment."
            },
            "name": {
                "type": "string",
                "required": false,
                "description": "Used for identifying the form, often same as formName."
            },
            "model": {
                "type": "object",
                "required": false,
                "description": "Data model associated with the form."
            },
            "fields": {
                "type": "array",
                "required": false,
                "description": "Definition of form fields (often included from external files).",
                "nestedValidation": {
                    "_allowAnyObject": true
                }
            },
            "actions": {
                "type": "array",
                "required": false,
                "description": "Definition of form actions (e.g., submit, cancel buttons).",
                "nestedValidation": {
                    "_allowAnyObject": true
                }
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for standard HTML attributes and specific form props.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Direct children of the form element.",
                "nestedValidation": {
                    "_allowAnyObject": true,
                    "_allowString": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Restructured to use nestedValidation.structure.",
        "Defined model, fields, actions, comment as allowed top-level structural keys.",
        "Form-specific props (formName, method, action, name) and standard attributes are defined within props.nestedValidation.structure.",
        "Validator should now allow props like 'method' or 'action' to appear directly OR within a props: {} object."
    ],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
