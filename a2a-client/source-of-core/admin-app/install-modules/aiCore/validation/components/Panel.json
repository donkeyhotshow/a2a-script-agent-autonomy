                "description": "Container for standard HTML attributes and Panel-specific props.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            },
                            {
                                "toggleable": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "collapsed": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "collapseIcon": {
                                    "type": "string",
                                    "required": false
                                },
                                "expandIcon": {
                                    "type": "string",
                                    "required": false
                                },
                                "toggleButtonProps": {
                                    "type": "object",
                                    "required": false
                                }
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Content of the panel body.",
                "nestedValidation": {
                    "_allowAnyObject": true,
                    "_allowString": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Restructured to use nestedValidation.structure.",
        "Represents the PrimeVue Panel component.",
        "Props and standard attributes defined within props.nestedValidation.structure."
