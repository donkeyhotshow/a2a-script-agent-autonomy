{
    "componentName": "Panel",
    "description": "PrimeVue Panel component.",
    "level": 2,
    "status": "active",
    "dependencies": [],
    "_comment": "Validation rules using nestedValidation structure.",
    "nestedValidation": {
        "structure": {
            "props": {
                "type": "object",
