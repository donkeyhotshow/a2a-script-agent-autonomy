{
    "componentName": "Tabs",
    "description": "PrimeVue Tabs (TabView) component wrapper.",
    "level": 2,
    "status": "active",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "dependencies": [
        "TabPanel"
    ],
    "_comment": "Validation expects properties within a 'props' object.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for PrimeVue TabView properties and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "activeIndex": {
                            "type": "number",
                            "required": false,
                            "default": 0,
                            "description": "Index of the active tab (use v-model)."
                        },
                        "lazy": {
                            "type": "boolean",
                            "required": false,
                            "default": false,
                            "description": "Load tab content lazily."
                        },
                        "scrollable": {
                            "type": "boolean",
                            "required": false,
                            "default": false,
                            "description": "Enable scrollable tabs."
                        },
                        "tabindex": {
                            "type": [
                                "string",
                                "number"
                            ],
                            "required": false,
                            "default": 0
                        },
                        "selectOnFocus": {
                            "type": "boolean",
                            "required": false,
                            "default": false
                        },
                        "pt": {
                            "type": "object",
                            "required": false
                        },
                        "ptOptions": {
                            "type": "object",
                            "required": false
                        },
                        "unstyled": {
                            "type": "boolean",
                            "required": false,
                            "default": false
                        },
                        "key": {
                            "type": [
                                "string",
                                "number"
                            ],
                            "required": false
                        },
                        "ref": {
                            "type": "string",
                            "required": false
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "name": {
                "type": "string",
                "required": false
            },
            "customHooks": {
                "type": "object",
                "required": false
            },
            "items": {
                "type": "array",
                "required": true,
                "description": "Must contain TabPanel components."
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Tabs does not typically accept children.",
                "nestedValidation": {
                    "_blockAll": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard V1 format (using 'props').",
        "PrimeVue component: TabView",
        "Requires children of type TabPanel.",
        "Removed 'items' prop, content is defined via TabPanel children.",
        "requiresModel=true because activeIndex uses v-model."
    ]
}
