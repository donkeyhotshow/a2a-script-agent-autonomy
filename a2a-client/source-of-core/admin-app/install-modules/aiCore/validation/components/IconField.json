{
    "componentName": "IconField",
    "description": "PrimeVue IconField component wrapper, used for positioning icons inside inputs.",
    "level": 3,
    "status": "ready",
    "dependencies": [
        "InputIcon"
    ],
    "_comment": "Validation expects properties within a 'props' object.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for IconField properties and standard HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "iconPosition": {
                            "type": "string",
                            "required": false,
                            "options": [
                                "left",
                                "right"
                            ],
                            "default": "right",
                            "description": "Position of the icon ('left' or 'right')."
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": true,
                "description": "Should contain an input element (e.g., InputText) and potentially an InputIcon.",
                "nestedValidation": {
                    "allowedTypes": [
                        "InputText",
                        "Password",
                        "InputIcon"
                    ],
                    "_allowAnyObject": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored placeholder rule to standard V1 format (using 'props').",
        "Level updated to 2.",
        "Added likely dependency InputIcon.",
        "Updated children validation based on expected usage."
    ],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
