{
    "componentName": "Grid",
    "description": "Layout component, possibly for creating grid layouts (e.g., using CSS Grid or Flexbox).",
    "level": 1,
    "status": "ready",
    "dependencies": [
        "Column",
        "Row"
    ],
    "_comment": "Validation expects properties within a 'props' object.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for Grid layout properties and standard HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "columns": {
                            "type": [
                                "number",
                                "string"
                            ],
                            "required": false,
                            "description": "Number of columns or template string."
                        },
                        "gap": {
                            "type": [
                                "string",
                                "number"
                            ],
                            "required": false,
                            "description": "Gap between grid items."
                        },
                        "alignItems": {
                            "type": "string",
                            "required": false
                        },
                        "justifyContent": {
                            "type": "string",
                            "required": false
                        },
                        "key": {
                            "type": [
                                "string",
                                "number"
                            ],
                            "required": false
                        },
                        "ref": {
                            "type": "string",
                            "required": false
                        },
                        "pt": {
                            "type": "object",
                            "required": false
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Should contain Row or Column components depending on structure.",
                "nestedValidation": {
                    "allowedTypes": [
                        "Column",
                        "Row"
                    ],
                    "_allowAnyObject": true
                }
            },
            "requiresModel": false,
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored placeholder rule to standard V1 format (using 'props').",
        "Level updated to 2.",
        "Added example Grid layout props (columns, gap, etc.) - review/adjust based on actual implementation.",
        "Updated children to allow Row and Column components.",
        "Note: Original notes mentioned missing .vue file."
    ],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
