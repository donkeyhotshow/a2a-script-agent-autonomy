{
    "componentName": "Select",
    "description": "PrimeVue Dropdown component (assumed wrapper), used for selecting a value from a list of options.",
    "level": 2,
    "status": "active",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "dependencies": [
        "VModel.vue"
    ],
    "examples": [
        {
            "type": "select",
            "model": {
                "form": "userForm",
                "field": "country",
                "default": "us",
                "optionLabel": "name",
                "optionValue": "code",
                "options": ["us", "ca", "mx"]
            },
            "props": {
                "filter": true,
                "showClear": true
            }
        },
        {
            "type": "select",
            "model": {
                "form": "orderForm",
                "field": "status",
                "optionLabel": "label",
                "optionValue": "value",
                "options": [         {
                    "label": "ID",
                    "value": "id"
                },
                {
                    "label": "Name",
                    "value": "name"
                }],   
                "default": ""
            },
            "props": {
                "placeholder": "Select status",
                "disabled": false
            }
        }
    ],
    "nestedValidation": {
        "structure": {
            "model": {
                "type": "object",
                "required": false,
                "description": "Model linkage object (form, field, options, etc.).",
                "nestedValidation": {
                    "structure": {
                        "form": {
                            "type": "string",
                            "required": false,
                            "description": "The form context for the model."
                        },
                        "field": {
                            "type": "string",
                            "required": true,
                            "description": "The field name within the form for model binding."
                        },
                        "default": {
                            "type": "any",
                            "required": false,
                            "description": "Default value for the select component."
                        },
                        "optionLabel": {
                            "type": "string",
                            "required": false
                        },
                        "optionValue": {
                            "type": "string",
                            "required": false
                        },
                        "optionDisabled": {
                            "type": "string",
                            "required": false
                        },
                        "options": {
                            "type": "array",
                            "required": false,
                            "description": "Options should usually be defined in the model object."
                        }
                    }
                }
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for PrimeVue Dropdown/Select props and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            },
                            {
                                "$ref": "../common/input.json"
                            },
                            {
                                "$ref": "../common/label.json"
                            },
                            {
                                "showClear": {
                                    "type": "boolean",
                                    "required": false
                                },
                                "filter": {
                                    "type": "boolean",
                                    "required": false
                                },
                                "filterPlaceholder": {
                                    "type": "string",
                                    "required": false
                                }
                            }
                        ]
                    }
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Created based on usage in config-settings.json and likely PrimeVue Dropdown props.",
        "Requires VModel wrapper.",
        "Allows 'label' as a structural key.",
        "Assumes 'options' are primarily defined in the model, but allows in props for flexibility.",
        "Restructured to use nestedValidation.structure.",
        "Added 'model' and 'customHooks' as allowed top-level keys.",
        "Assumed based on PrimeVue Dropdown props. Verify against actual component."
    ],
    "suggestions": {
        "unknown_prop": {
            "message": "The Select component doesn't support this property. Common errors include using 'option' instead of 'options' array or accessing options incorrectly.",
            "docs_url": "docs/ui/resources/elements/primevue/components/VModel/Select/Dropdown.md",
            "example": "\"model\": { \"options\": [{\"label\": \"Option 1\", \"value\": \"1\"}, {\"label\": \"Option 2\", \"value\": \"2\"}], \"optionLabel\": \"label\", \"optionValue\": \"value\" }"
        },
        "invalid_prop_type": {
            "message": "Type mismatch in Select component property. Common errors: 'options' must be array, 'optionLabel' and 'optionValue' must be strings.",
            "docs_url": "docs/ui/resources/elements/primevue/components/VModel/Select/Dropdown.md"
        },
        "missing_required_key": {
            "message": "Select component is missing a required key. The 'field' property is required in the model object.",
            "example": "\"model\": { \"field\": \"countryCode\", \"options\": [...] }"
        },
        "properties": {
            "option": {
                "message": "Use 'options' (plural) in the model object instead of 'option'.",
                "suggest": "options",
                "example": "\"model\": { \"options\": [{\"label\": \"Option 1\", \"value\": \"1\"}] }"
            },
            "options": {
                "message": "Options should be defined in the model object, not directly in props.",
                "example": "\"model\": { \"options\": [{\"label\": \"Option 1\", \"value\": \"1\"}] }"
            },
            "optionLabel": {
                "message": "The 'optionLabel' property specifies which field in your options objects should be used as the display text.",
                "example": "\"model\": { \"optionLabel\": \"name\", \"options\": [{\"name\": \"USA\", \"code\": \"US\"}] }"
            }
        },
        "empty_array_not_allowed": {
            "message": "The 'options' array cannot be empty. Add at least one option or set to null.",
            "example": "\"model\": { \"options\": [{\"label\": \"Option 1\", \"value\": \"1\"}] }"
        }
    }
}
