{
    "componentName": "FloatLabel",
    "description": "A container component that adds a floating label effect to the child input element.",
    "level": 3,
    "status": "ready",
    "dependencies": [],
    "_comment": "Validation expects properties within a 'props' object.",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for standard HTML attributes applied to the wrapper span.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": true,
                "description": "Should contain exactly one input element (e.g., InputText, Dropdown) and optionally a Label component.",
                "nestedValidation": {
                    "allowedTypes": [
                        "InputText",
                        "Password",
                        "Dropdown",
                        "Calendar",
                        "Textarea",
                        "Label"
                    ],
                    "_allowAnyObject": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard V1 format (using 'props').",
        "PrimeVue component: FloatLabel",
        "Acts as a wrapper. Standard HTML attributes apply to the root span.",
        "Updated children validation with examples of expected input components."
    ]
}
