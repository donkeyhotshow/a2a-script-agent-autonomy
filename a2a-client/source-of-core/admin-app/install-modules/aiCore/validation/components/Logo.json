{
    "componentName": "Logo",
    "description": "Displays the application logo, potentially linking to a URL.",
    "level": 5,
    "status": "ready",
    "dependencies": [],
    "_comment": "Validation expects properties within a 'props' object.",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "nestedValidation": {
        "structure": {
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for Logo link and SVG properties, plus standard HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "href": {
                            "type": "string",
                            "required": false,
                            "default": "/",
                            "description": "The URL the logo links to."
                        },
                        "target": {
                            "type": "string",
                            "required": false,
                            "options": [
                                "_self",
                                "_blank",
                                "_parent",
                                "_top"
                            ],
                            "description": "Specifies where to open the linked document."
                        },
                        "svg": {
                            "type": "array",
                            "required": false,
                            "description": "CSS id for the SVG element."
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Logo does not typically accept children.",
                "nestedValidation": {
                    "_blockAll": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard V1 format (using 'props').",
        "Renders a link (likely <a>) containing an SVG defined by svg* props.",
        "'svgPath' prop is required."
    ]
}
