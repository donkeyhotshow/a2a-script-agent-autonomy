{
    "componentName": "Password",
    "description": "Input field for passwords with optional mask toggle and strength indicator.",
    "level": 2,
    "status": "ready",
    "dependencies": [
        "VModel.vue"
    ],
    "_comment": "Validation expects properties within a 'props' object.",
    "nestedValidation": {
        "structure": {
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for PrimeVue Password properties and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            },
                            {
                                "label": {
                                    "type": "string",
                                    "required": false
                                },
                                "placeholder": {
                                    "type": "string",
                                    "required": false
                                },
                                "toggleMask": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false,
                                    "description": "Shows toggle mask icon."
                                },
                                "hideIcon": {
                                    "type": "string",
                                    "required": false
                                },
                                "showIcon": {
                                    "type": "string",
                                    "required": false
                                },
                                "feedback": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": true,
                                    "description": "Shows strength indicator."
                                },
                                "promptLabel": {
                                    "type": "string",
                                    "required": false,
                                    "description": "Prompt text."
                                },
                                "weakLabel": {
                                    "type": "string",
                                    "required": false,
                                    "description": "Weak strength text."
                                },
                                "mediumLabel": {
                                    "type": "string",
                                    "required": false,
                                    "description": "Medium strength text."
                                },
                                "strongLabel": {
                                    "type": "string",
                                    "required": false,
                                    "description": "Strong strength text."
                                },
                                "invalid": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "variant": {
                                    "type": "string",
                                    "required": false,
                                    "options": [
                                        "filled"
                                    ]
                                },
                                "pt": {
                                    "type": "object",
                                    "required": false
                                },
                                "ptOptions": {
                                    "type": "object",
                                    "required": false
                                },
                                "unstyled": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "readonly": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "required": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "name": {
                                    "type": "string",
                                    "required": false
                                },
                                "maxlength": {
                                    "type": "number",
                                    "required": false
                                },
                                "minlength": {
                                    "type": "number",
                                    "required": false
                                },
                                "pattern": {
                                    "type": "string",
                                    "required": false
                                },
                                "autocomplete": {
                                    "type": "string",
                                    "required": false,
                                    "default": "current-password"
                                },
                                "tabindex": {
                                    "type": [
                                        "string",
                                        "number"
                                    ],
                                    "required": false
                                }
                            }
                        ]
                    }
                }
            },
            "model": {
                "type": "object",
                "required": false,
                "description": "Model linkage object defining form and field for data binding.",
                "nestedValidation": {
                    "structure": {
                        "form": {
                            "type": "string",
                            "required": false
                        },
                        "field": {
                            "type": "string",
                            "required": false
                        }
                    }
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard V1 format (using 'props').",
        "PrimeVue component: Password",
        "The 'model' property is an object containing 'form' and 'field' keys for data binding.",
        "Added standard HTML input[type=password] attributes and common PrimeVue props/slots.",
        "Requires model binding (likely via VModel wrapper)."
    ],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
