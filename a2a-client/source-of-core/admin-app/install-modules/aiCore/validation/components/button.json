{
    "componentName": "Button",
    "description": "Standard button component.",
    "level": 2,
    "status": "active",
    "dependencies": [],
    "_comment": "Validation rules using nestedValidation structure.",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "nestedValidation": {
        "structure": {
            "$ref": "../common/root.json",
            "props": {
                "type": "object",
                "required": false,
                "_suggestions": [
                    "Note: 'props' contains attributes directly applied to the button element.",
                    "For event handling or more complex actions, consider using 'customHooks' outside of 'props'.",
                    "For button content (like text or icons not managed by icon props), use the 'children' property outside of 'props'."
                ],
                "_docs_link": "docs/ui/button-component.md",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            },
                            {
                                "$ref": "../common/label.json"
                            },
                            {
                                "$ref": "../common/icon.json"
                            },
                            {
                                "$ref": "../common/size.json"
                            },
                            {
                                "$ref": "../common/button.json"
                            },
                            {
                                "iconPos": {
                                    "type": "string",
                                    "required": false,
                                    "options": [
                                        "left",
                                        "right",
                                        "top",
                                        "bottom"
                                    ],
                                    "default": "left"
                                },
                                "loading": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "disabled": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "type": {
                                    "type": "string",
                                    "required": false,
                                    "options": [
                                        "button",
                                        "submit",
                                        "reset"
                                    ],
                                    "default": "button"
                                },
                                "dialogConfig": {
                                    "type": "object",
                                    "required": false,
                                    "description": "Configuration for opening a dialog."
                                }
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": [
                    "string",
                    "array"
                ],
                "required": false,
                "description": "Button label or complex content.",
                "nestedValidation": {
                    "_allowString": true,
                    "allowedTypes": [
                        "Icon",
                        "Span"
                    ]
                }
            }
        }
    },
    "implementationNotes": [
        "Restructured to use nestedValidation.structure.",
        "Defined children, props as allowed top-level keys.",
        "All PrimeVue Button properties and standard HTML attributes are defined within props.nestedValidation.structure.",
        "For navigation, use customHooks.click with action: 'navigate' and to: '/target-path'",
        "For form submission, use customHooks.click with action: 'submit' and target: 'formId'",
        "Тест: customHooks должен быть доступен через $ref на common-validation-config.json"
    ]
}
