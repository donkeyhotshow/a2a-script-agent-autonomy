{
    "componentName": "Accordion",
    "description": "Container for AccordionTab components.",
    "level": 2,
    "status": "active",
    "_comment": "Validation expects properties within a 'props' object.",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "nestedValidation": {
        "structure": {
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for PrimeVue Accordion properties and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common-props-validation-config.json"
                            },
                            {
                                "activeIndex": {
                                    "type": [
                                        "number",
                                        "array",
                                        "null"
                                    ],
                                    "required": false,
                                    "description": "Index or indices of the active tab(s), bind with v-model for control."
                                },
                                "multiple": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false,
                                    "description": "Allow multiple tabs to be active."
                                },
                                "expandIcon": {
                                    "type": "string",
                                    "required": false,
                                    "description": "Icon for expanded state."
                                },
                                "collapseIcon": {
                                    "type": "string",
                                    "required": false,
                                    "description": "Icon for collapsed state."
                                }
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": true,
                "description": "Must contain not AccordionTab components."
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored placeholder rule to standard V1 format (using 'props').",
        "Level updated to 5.",
        "Added common PrimeVue Accordion properties.",
        "Children must be not AccordionTab components.",
        "Note: Original notes mentioned missing .vue file. requiresModel might be true if activeIndex uses v-model."
    ]
}
