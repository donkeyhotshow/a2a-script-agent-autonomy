{
    "componentName": "P",
    "description": "Standard HTML P paragraph tag.",
    "level": 5,
    "status": "active",
    "dependencies": [],
    "_comment": "Validation expects properties within a 'props' object.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "children": {
                "type": "array",
                "required": false,
                "nestedValidation": {
                    "_allowString": true,
                    "allowedTypes": [
                        "Span",
                        "B",
                        "I",
                        "Strong",
                        "Em",
                        "Code",
                        "A",
                        "Icon",
                        "BR",
                        "Image"
                    ]
                }
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for standard HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "content": {
                            "type": "string",
                            "required": false
                        },
                        "lang": {
                            "type": "string",
                            "required": false
                        },
                        "dir": {
                            "type": "string",
                            "required": false,
                            "options": [
                                "ltr",
                                "rtl",
                                "auto"
                            ]
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
