{
    "componentName": "SplitterPanel",
    "description": "Represents a panel within a Splitter component.",
    "level": 3,
    "status": "ready",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "dependencies": [
        "Splitter"
    ],
    "_comment": "Validation expects properties within a 'props' object.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for PrimeVue SplitterPanel properties and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "size": {
                            "type": "number",
                            "required": false,
                            "description": "Size of the panel in percentages."
                        },
                        "minSize": {
                            "type": "number",
                            "required": false,
                            "description": "Minimum size in percentages."
                        },
                        "pt": {
                            "type": "object",
                            "required": false
                        },
                        "ptOptions": {
                            "type": "object",
                            "required": false
                        },
                        "unstyled": {
                            "type": "boolean",
                            "required": false,
                            "default": false
                        },
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "Content to be displayed inside the panel.",
                "nestedValidation": {
                    "_allowAnyObject": true,
                    "_allowString": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard V1 format (using 'props').",
        "PrimeVue component: SplitterPanel",
        "Used as a child of Splitter.",
        "Added common PrimeVue SplitterPanel props and standard attributes."
    ]
}
