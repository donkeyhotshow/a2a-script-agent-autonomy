{
    "componentName": "Link",
    "description": "Custom Link component, likely wrapping Inertia Link or router-link.",
    "level": 2,
    "status": "ready",
    "dependencies": [],
    "nestedValidation": {
        "structure": {
            "children": {
                "type": "array",
                "required": false,
                "nestedValidation": {
                    "_allowString": true,
                    "_allowAnyObject": true
                }
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for link properties and attributes.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            },
                            {
                                "href": {
                                    "type": "string",
                                    "required": true
                                },
                                "target": {
                                    "type": "string",
                                    "required": false,
                                    "options": [
                                        "_blank",
                                        "_self",
                                        "_parent",
                                        "_top"
                                    ]
                                },
                                "label": {
                                    "type": "string",
                                    "required": false
                                },
                                "icon": {
                                    "type": "string",
                                    "required": false,
                                    "description": "Icon for the link (e.g., PrimeIcons like 'pi pi-home')."
                                },
                                "content": {
                                    "type": "string",
                                    "required": false
                                }
                            }
                        ]
                    }
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored placeholder rule.",
        "Assumes it's a link wrapper needing at least 'href'. Added standard attrs and customHooks."
    ],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
