{
    "componentName": "InputIcon",
    "description": "Used within an IconField to display an icon.",
    "level": 3,
    "status": "ready",
    "documentationLink": "docs/guides/module/04-ui-construction.md",
    "dependencies": [
        "IconField"
    ],
    "_comment": "Validation expects properties within a 'props' object.",
    "nestedValidation": {
        "structure": {
            "vAddress": {
                "type": "string",
                "required": false,
                "description": "Address for v-model or component identification."
            },
            "disabled": {
                "type": "boolean",
                "required": false,
                "default": false,
                "description": "Disable rendering of the component."
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for icon class and standard HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            }
                        ]
                    }
                }
            },
            "children": {
                "type": "array",
                "required": false,
                "description": "InputIcon does not typically accept children.",
                "nestedValidation": {
                    "_blockAll": true
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Refactored to standard V1 format (using 'props').",
        "PrimeVue component: InputIcon",
        "Used within IconField.",
        "The 'class' prop is required to specify the icon."
    ]
}
