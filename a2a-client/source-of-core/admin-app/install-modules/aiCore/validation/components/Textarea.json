{
    "componentName": "Textarea",
    "description": "PrimeVue Textarea component.",
    "level": 2,
    "status": "ready",
    "dependencies": [],
    "_comment": "Validation rules using nestedValidation structure.",
    "nestedValidation": {
        "structure": {
            "model": {
                "type": [
                    "string",
                    "object"
                ],
                "required": false,
                "description": "v-model binding (string) or model linkage object.",
                "nestedValidation": {
                    "structure": {
                        "form": {
                            "type": "string",
                            "required": false
                        },
                        "field": {
                            "type": "string",
                            "required": false
                        }
                    }
                }
            },
            "props": {
                "type": "object",
                "required": false,
                "description": "Container for PrimeVue Textarea properties and HTML attributes.",
                "nestedValidation": {
                    "structure": {
                        "allOf": [
                            {
                                "$ref": "../common/props.json"
                            },
                            {
                                "$ref": "../common/label.json"
                            },
                            {
                                "$ref": "../common/input.json"
                            },
                            {
                                "autoResize": {
                                    "type": "boolean",
                                    "required": false,
                                    "default": false
                                },
                                "rows": {
                                    "type": "number",
                                    "required": false
                                },
                                "cols": {
                                    "type": "number",
                                    "required": false
                                },
                                "maxlength": {
                                    "type": "number",
                                    "required": false
                                }
                            }
                        ]
                    }
                }
            },
            "$ref": "../common/root.json"
        }
    },
    "implementationNotes": [
        "Restructured to use nestedValidation.structure.",
        "Allowed 'model' to be string (v-model) or object (for binding linkage).",
        "Represents the PrimeVue Textarea component."
    ],
    "documentationLink": "docs/guides/module/04-ui-construction.md"
}
