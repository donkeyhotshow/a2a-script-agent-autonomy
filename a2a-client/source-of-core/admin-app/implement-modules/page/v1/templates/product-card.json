{
    "type": "Column",
    "children": [
        {
            "type": "Card",
            "props": {
                "class": "text-center shadow-md hover:shadow-lg transition-shadow duration-300 h-full flex flex-col"
            },
            "children": [
                {
                    "type": "Image",
                    "props": {
                        "src": "{imageSrc}",
                        "alt": "{productName}",
                        "class": "w-full h-48 object-cover mb-4"
                    }
                },
                {
                    "type": "div",
                    "props": {
                        "class": "flex-grow p-4"
                    },
                    "children": [
                        {
                            "type": "H3",
                            "props": {
                                "content": "{productName}",
                                "class": "text-xl font-semibold mb-2"
                            }
                        },
                        {
                            "type": "P",
                            "props": {
                                "content": "{productDescription}",
                                "class": "text-gray-600 mb-3"
                            }
                        },
                        {
                            "type": "P",
                            "props": {
                                "content": "{productPrice}",
                                "class": "font-bold text-lg mb-4"
                            }
                        }
                    ]
                },
                {
                    "type": "div",
                    "props": {
                        "class": "p-4 border-t border-gray-200"
                    },
                    "children": [
                        {
                            "type": "Button",
                            "props": {
                                "label": "View Details",
                                "severity": "secondary"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
