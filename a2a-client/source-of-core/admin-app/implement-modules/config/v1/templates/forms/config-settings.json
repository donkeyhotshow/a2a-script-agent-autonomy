{
    "type": "Form",
    "name": "configForm",
    "children": [
        {
            "type": "InputText",
            "model": {
                "form": "configForm",
                "field": "siteName"
            },
            "props": {
                "label": "Site Name"
            }
        },
        {
            "type": "Checkbox",
            "model": {
                "form": "configForm",
                "field": "maintenanceMode"
            },
            "props": {
                "label": "Maintenance Mode",
                "binary": true,
                "inputId": "maintenanceModeCheck"
            }
        },
        {
            "type": "Select",
            "form": "configForm",
            "field": "targetModule",
            "model": {
                "optionLabel": "label",
                "optionValue": "value",
                "options": [
                    {
                        "label": "Primary Form",
                        "value": "primary-form"
                    },
                    {
                        "label": "Questions To User",
                        "value": "questions-to-user"
                    },
                    {
                        "label": "Landing Main Page",
                        "value": "landing-main-page"
                    },
                    {
                        "label": "Playground",
                        "value": "playground"
                    },
                    {
                        "label": "Config",
                        "value": "config"
                    },
                    {
                        "label": "Page",
                        "value": "page"
                    },
                    {
                        "label": "Contact Form",
                        "value": "contact-form"
                    },
                    {
                        "label": "Top Bar",
                        "value": "top-bar"
                    },
                    {
                        "label": "Login Form",
                        "value": "login-form"
                    },
                    {
                        "label": "Errors",
                        "value": "errors"
                    }
                ]
            },
            "props": {
                "label": "Target Module",
                "placeholder": "Select a module..."
            }
        }
    ]
}
