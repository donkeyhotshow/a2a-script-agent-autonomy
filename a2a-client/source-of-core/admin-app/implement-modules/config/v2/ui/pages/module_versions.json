{
    "type": "page",
    "version": "1.0.0",
    "layout": "config.default_layout",
    "title": "Управление версиями модулей (module-versions.json)",
    "description": "Страница для редактирования файла `install-modules/aiCore/module-versions.json`, определяющего доступные версии для каждого модуля.",
    "//_comment_dataSources": "Loads the module versions file. Extracts the 'modules' object into formData for easier manipulation, and keeps the original raw file for saving and display.",
    "dataSources": [
        {
            "id": "moduleVersionsData",
            "action": "config.load_config_file",
            "params": {
                "filePath": "install-modules/aiCore/module-versions.json"
            },
            "onSuccess": {
                "setContext": {
                    "formData": "{{actionResult.fileContent.modules}}",
                    "rawFileData": "{{actionResult.fileContent}}",
                    "newModuleNameInput": "",
                    "newVersionInputs": {}
                }
            },
            "onError": {
                "showToast": {
                    "severity": "error",
                    "summary": "Ошибка загрузки",
                    "detail": "Не удалось загрузить module-versions.json: {{error.message}}"
                },
                "setContext": {
                    "formData": {}
                }
                // Инициализируем пустым объектом в случае ошибки
            }
        }
    ],
    "actions": [
        {
            "id": "saveChanges",
            "//_comment": "Saves the current formData. Wraps formData back into {modules: ...} structure before saving.",
            "action": "config.save_config_file",
            "params": {
                "filePath": "install-modules/aiCore/module-versions.json",
                // Перед сохранением оборачиваем formData обратно в структуру { "modules": ... }
                "fileContent": "{{ { modules: context.formData } }}"
            },
            "onSuccess": {
                "showToast": {
                    "severity": "success",
                    "summary": "Сохранено",
                    "detail": "Файл module-versions.json успешно сохранен."
                },
                "triggerDataSource": "moduleVersionsData"
            },
            "onError": {
                "showToast": {
                    "severity": "error",
                    "summary": "Ошибка сохранения",
                    "detail": "Не удалось сохранить module-versions.json: {{error.message}}"
                }
            }
        },
        {
            "id": "addModule",
            "//_comment": "Adds a new module. Reads module name from context.newModuleNameInput. Clears input on success.",
            "run": [
                {
                    "if": "{{ context.newModuleNameInput && context.newModuleNameInput.trim() !== \"\" && !context.formData[context.newModuleNameInput.trim()] }}",
                    "then": [
                        {
                            "setContext": {
                                "formData": "{{ {...context.formData, [context.newModuleNameInput.trim()]: []} }}",
                                "newModuleNameInput": ""
                            }
                        }
                    ],
                    "else": [
                        {
                            "showToast": {
                                "severity": "warn",
                                "summary": "Ошибка добавления",
                                "detail": "Модуль уже существует или имя не указано."
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "deleteModule",
            "params": [
                "moduleName"
            ],
            "//_comment": "Deletes an entire module entry from formData.",
            "run": [
                {
                    "setContext": {
                        // Создаем новый объект formData без указанного moduleName
                        "formData": "{{ Object.fromEntries(Object.entries(context.formData).filter(([key]) => key !== params.moduleName)) }}"
                    }
                }
            ]
        },
        {
            "id": "addVersionToModule",
            "params": [
                "moduleName"
            ],
            "//_comment": "Adds a new version to a specific module. Reads version from context.newVersionInputs[moduleName]. Clears the specific input on success.",
            "run": [
                {
                    // Read newVersion from context.newVersionInputs[params.moduleName]
                    "if": "{{ context.newVersionInputs[params.moduleName] && context.newVersionInputs[params.moduleName].trim() !== \"\" && context.formData[params.moduleName] && !context.formData[params.moduleName].includes(context.newVersionInputs[params.moduleName].trim()) }}",
                    "then": [
                        {
                            "setContext": {
                                // Use context.newVersionInputs[params.moduleName].trim()
                                "formData": "{{ {...context.formData, [params.moduleName]: [...context.formData[params.moduleName], context.newVersionInputs[params.moduleName].trim()]} }}",
                                // Clear the specific input after adding
                                "newVersionInputs": "{{ {...context.newVersionInputs, [params.moduleName]: ''} }}"
                            }
                        }
                    ],
                    "else": [
                        {
                            "showToast": {
                                "severity": "warn",
                                "summary": "Ошибка добавления версии",
                                "detail": "Версия не указана, уже существует или модуль не найден."
                            }
                        }
                    ]
                }
            ]
        },
        {
            "id": "deleteVersionFromModule",
            "params": [
                "moduleName",
                "versionToDelete"
            ],
            "//_comment": "Deletes a specific version from a module. Note: p-chips handles UI-driven deletion; this action is for programmatic use or other UI elements.",
            "run": [
                {
                    "setContext": {
                        "formData": "{{ {...context.formData, [params.moduleName]: context.formData[params.moduleName].filter(v => v !== params.versionToDelete)} }}"
                    }
                }
            ]
        }
    ],
    "body": [
        {
            "type": " r",
            "//_comment_toolbar": "Toolbar for adding a new module and saving all changes.",
            "children": [
                {
                    "type": " div",
                    "props": {
                        "class": "p-toolbar-group-left"
                    },
                    "children": [
                        {
                            "type": " p-inputText",
                            "props": {
                                "placeholder": "Имя нового модуля",
                                "id": "newModuleNameInput",
                                "modelValue": "{{context.newModuleNameInput}}"
                            },
                            "events": {
                                "update:modelValue": {
                                    "setContext": {
                                        "newModuleNameInput": "{{eventValue}}"
                                    }
                                },
                                "keydown.enter": {
                                    "triggerAction": {
                                        "id": "addModule"
                                    }
                                }
                            }
                        },
                        {
                            "type": " p-button",
                            "props": {
                                "label": "Добавить модуль",
                                "icon": "pi pi-plus",
                                "class": "p-ml-2"
                            },
                            "events": {
                                "click": {
                                    "triggerAction": {
                                        "id": "addModule"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": " div",
                    "props": {
                        "class": "p-toolbar-group-right"
                    },
                    "children": [
                        {
                            "type": " p-button",
                            "props": {
                                "label": "Сохранить все изменения",
                                "icon": "pi pi-save",
                                "class": "p-button-success"
                            },
                            "events": {
                                "click": {
                                    "triggerAction": "saveChanges"
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": " p-accordion",
            "//_comment_accordion": "Displays each module as an accordion tab. All tabs are open by default.",
            "props": {
                "multiple": true,
                // Разрешить несколько открытых вкладок
                "activeIndex": "{{ Object.keys(context.formData || {}).map((_, i) => i) }}"
                // Открывать все по умолчанию
            },
            "//_comment_accordion_loop": "Loops through an array of [moduleName, versionsArray] entries from formData.",
            "loop": {
                "data": "{{ Object.entries(context.formData || {}) }}",
                // [moduleName, versionsArray]
                "as": "moduleEntry"
            },
            "children": [
                {
                    "type": " p-accordionTab",
                    "props": {
                        "header": "{{ moduleEntry[0] }}"
                        // moduleName
                    },
                    "//_comment_accordion_tab_content": "Content for each module: input to add version, button to delete module, and p-chips for versions.",
                    "children": [
                        {
                            "type": " div",
                            "props": {
                                "class": "p-d-flex p-ai-center p-mb-2"
                            },
                            "children": [
                                {
                                    "type": " p-inputText",
                                    "props": {
                                        "placeholder": "Новая версия (например, v2)",
                                        "id": "{{ \`newVersionInput_\${moduleEntry[0]}\` }}",
                                        // ID can still be useful for labels
                                        "modelValue": "{{context.newVersionInputs[moduleEntry[0]]}}"
                                    },
                                    "events": {
                                        "update:modelValue": {
                                            "setContext": {
                                                "newVersionInputs": "{{ {...context.newVersionInputs, [moduleEntry[0]]: eventValue} }}"
                                            }
                                        },
                                        // Optional: Add on enter, passing moduleName
                                        "keydown.enter": {
                                            "triggerAction": {
                                                "id": "addVersionToModule",
                                                "params": {
                                                    "moduleName": "{{moduleEntry[0]}}"
                                                }
                                            }
                                        }
                                    }
                                },
                                {
                                    "type": " p-button",
                                    "props": {
                                        "icon": "pi pi-plus",
                                        "class": "p-button-sm p-ml-2",
                                        "aria-label": "Добавить версию"
                                    },
                                    "events": {
                                        // Trigger action, newVersion is read from context via moduleName
                                        "click": {
                                            "triggerAction": {
                                                "id": "addVersionToModule",
                                                "params": {
                                                    "moduleName": "{{moduleEntry[0]}}"
                                                }
                                            }
                                        }
                                    }
                                },
                                {
                                    "type": " p-button",
                                    "props": {
                                        "icon": "pi pi-trash",
                                        "class": "p-button-danger p-button-sm p-ml-auto",
                                        "aria-label": "Удалить модуль"
                                    },
                                    "events": {
                                        "click": {
                                            "triggerAction": {
                                                "id": "deleteModule",
                                                "params": {
                                                    "moduleName": "{{moduleEntry[0]}}"
                                                }
                                            }
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": " p-chips",
                            // Для редактирования массива строк (версий)
                            "props": {
                                "modelValue": "{{ moduleEntry[1] }}",
                                // versionsArray
                                "separator": ",",
                                "addOnBlur": true,
                                "allowDuplicate": false
                            },
                            "//_comment_p-chips_event": "p-chips directly updates the versions array for the current module in formData.",
                            "events": {
                                "update:modelValue": {
                                    "setContext": {
                                        "formData": "{{ {...context.formData, [moduleEntry[0]]: eventValue} }}"
                                    }
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "type": " p-panel",
            "props": {
                "header": "Raw JSON Data",
                "toggleable": true,
                "collapsed": true,
                "class": "p-mt-4"
            },
            "//_comment_raw_json_panel": "Displays the original, unmodified file content for reference (read-only).",
            "children": [
                {
                    "type": " config.json_editor",
                    "props": {
                        "data": "{{context.rawFileData}}",
                        // Показываем исходный файл
                        "options": {
                            "mode": "code",
                            "readOnly": true
                        }
                        // Только для чтения
                    }
                }
            ]
        }
    ]
}
