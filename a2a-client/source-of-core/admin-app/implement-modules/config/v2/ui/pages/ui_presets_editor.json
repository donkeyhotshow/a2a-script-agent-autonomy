{
    "type": "page",
    "version": "1.0.0",
    "layout": "config.default_layout",
    "title": "Редактор UI Пресетов (MyPreset.json)",
    "description": "Страница для редактирования файла UI пресетов `install-modules/aiCore/js/MyPreset.json`.",
    "//_comment_dataSources": "Loads the MyPreset.json file into formData and sets the initial active tab index.",
    "dataSources": [
        {
            "id": "presetsData",
            "action": "config.load_config_file",
            "params": {
                "filePath": "install-modules/aiCore/js/MyPreset.json"
            },
            "onSuccess": {
                "setContext": {
                    "formData": "{{actionResult.fileContent}}",
                    "//_comment_activeTabIndex": "Initialize activeIndex for TabView to the first tab, or null if no data.",
                    "activeTabIndex": "{{ Object.keys(actionResult.fileContent || {}).length > 0 ? 0 : null }}"
                }
            },
            "onError": {
                "showToast": {
                    "severity": "error",
                    "summary": "Ошибка загрузки",
                    "detail": "Не удалось загрузить MyPreset.json: {{error.message}}"
                },
                "setContext": {
                    "formData": {}
                }
            }
        }
    ],
    "//_comment_actions": "Defines actions available on this page, primarily for saving changes.",
    "actions": [
        {
            "id": "saveChanges",
            "//_comment_saveChanges_action": "Saves the entire formData (which represents MyPreset.json content) back to the file.",
            "action": "config.save_config_file",
            "params": {
                "filePath": "install-modules/aiCore/js/MyPreset.json",
                "fileContent": "{{context.formData}}",
                "prettyPrint": true
            },
            "onSuccess": {
                "showToast": {
                    "severity": "success",
                    "summary": "Сохранено",
                    "detail": "Файл MyPreset.json успешно сохранен."
                },
                "triggerDataSource": "presetsData"
            },
            "onError": {
                "showToast": {
                    "severity": "error",
                    "summary": "Ошибка сохранения",
                    "detail": "Не удалось сохранить MyPreset.json: {{error.message}}"
                }
            }
        }
    ],
    "//_comment_body": "Main layout of the page, including toolbar, tab view for categories, and raw JSON viewer.",
    "body": [
        {
            "type": "p-toolbar",
            "props": {
                "class": "p-mb-3"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "p-toolbar-group-left"
                    }
                },
                {
                    "type": "div",
                    "props": {
                        "class": "p-toolbar-group-right"
                    },
                    "children": [
                        {
                            "type": "p-button",
                            "props": {
                                "label": "Сохранить изменения",
                                "icon": "pi pi-save",
                                "class": "p-button-success"
                            },
                            "events": {
                                "click": {
                                    "triggerAction": "saveChanges"
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "//_comment_tabView": "Main TabView to iterate through top-level categories of MyPreset.json (e.g., primitive, semantic, extend). Each tab includes the category template.",
            "type": "p-tabView",
            "props": {
                "activeIndex": "{{context.activeTabIndex}}",
                "scrollable": true
            },
            "events": {
                "update:activeIndex": {
                    "setContext": {
                        "activeTabIndex": "{{eventValue}}"
                    }
                }
            },
            "loop": {
                "data": "{{ Object.entries(context.formData || {}) }}",
                "as": "categoryEntry",
                "//_comment_loop_note": "categoryEntry will be an array: [categoryName, categoryDataObject]"
            },
            "children": [
                {
                    "//_comment_template_inclusion": "This uses the 'include' component to render the _ui_presets_category_template.json for each category.",
                    "type": "include",
                    "props": {
                        "src": "implement-modules/config/v2/ui/pages/_ui_presets_category_template.json",
                        "//_comment_pass_context": "Passes the main page's formData and the current categoryEntry (from the loop) to the template's context.",
                        "context": {
                            "formData": "{{page.context.formData}}",
                            "categoryEntry": "{{loop.categoryEntry}}"
                        }
                    }
                }
            ]
        },
        {
            "//_comment_raw_json_panel": "Displays the full MyPreset.json content in a read-only JSON editor for reference.",
            "type": "p-panel",
            "props": {
                "header": "Raw MyPreset.json Data",
                "toggleable": true,
                "collapsed": true,
                "class": "p-mt-4"
            },
            "children": [
                {
                    "type": "config.json_editor",
                    "props": {
                        "data": "{{context.formData}}",
                        "options": {
                            "mode": "code",
                            "readOnly": true
                        }
                    }
                }
            ]
        }
    ]
}
