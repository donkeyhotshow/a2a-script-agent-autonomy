{
    // Define a base directory for logs. This should ideally be configurable.
    // Assuming this path is relative to the project root, and LogActions.php is deep within implement-modules.
    private
    const
    BASE_LOG_DIRECTORY
    =
    __DIR__
    .
    '/../../../../../storage/logs'
    ;

    /**
     * Получает список доступных лог-файлов.
     *
     * @param array $inputs Входные параметры (logDirectory, filePattern).
     * @return array Массив с ключом 'logFiles' или 'error'.
     */
    public
    function
    listLogs(array
    $inputs
    = []): array {
$subDirectory = $inputs['logDirectory'] ?? '';
$filePattern = $inputs['filePattern'] ?? '*.log';

// Sanitize subdirectory: remove leading/trailing slashes, disallow '..'
$sanitizedSubDirectory = trim(str_replace('..', '', $subDirectory), DIRECTORY_SEPARATOR);

// Sanitize filePattern: allow only alphanumeric, *, ., -
$sanitizedFilePattern = preg_replace('/[^a-zA-Z0-9_\*\.\-]/', '', $filePattern);
if (empty($sanitizedFilePattern)) {
$sanitizedFilePattern = '*.log'; // Default if pattern becomes empty after sanitization
}

$targetDirectory = self:: BASE_LOG_DIRECTORY;
if (!empty($sanitizedSubDirectory)) {
$targetDirectory .= DIRECTORY_SEPARATOR . $sanitizedSubDirectory;
}

$realTargetDirectory = realpath($targetDirectory);
$realBaseDirectory = realpath(self:: BASE_LOG_DIRECTORY);

if ($realTargetDirectory === false || $realBaseDirectory === false || strpos($realTargetDirectory, $realBaseDirectory) !== 0) {
return ['logFiles' => [], 'error' => 'Access denied or invalid log directory specified.'];
}

$foundFiles = [];
$fullPattern = rtrim($realTargetDirectory, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR . $sanitizedFilePattern;

foreach (glob($fullPattern) as $filename) {
if (is_file($filename)) {
// Ensure it's a file
$relativePath = str_replace($realBaseDirectory . DIRECTORY_SEPARATOR, '', realpath($filename));
$foundFiles[] = [
'name' => basename($filename),
'path' => $relativePath // Return path relative to BASE_LOG_DIRECTORY
];
}
}

return ['logFiles' => $foundFiles];
}

/**
 * Загружает содержимое указанного лог-файла.
 *
 * @param array $inputs Входные параметры (filePath (относительный), maxLines).
 * @return array Массив с ключами 'logContent', 'linesLoaded', 'totalLines', или 'error'.
 */
public function loadLogContent(array $inputs): array {
if (empty($inputs['filePath'])) {
return ['error' => 'filePath is required.'];
}

// Sanitize filePath: remove leading/trailing slashes, disallow '..'
$relativeFilePath = trim(str_replace('..', '', $inputs['filePath']), DIRECTORY_SEPARATOR);
$fullFilePath = self:: BASE_LOG_DIRECTORY . DIRECTORY_SEPARATOR . $relativeFilePath;

// Security Check: Ensure the resolved path is within the base log directory
$realFullFilePath = realpath($fullFilePath);
$realBaseDirectory = realpath(self:: BASE_LOG_DIRECTORY);

if ($realFullFilePath === false || $realBaseDirectory === false || strpos($realFullFilePath, $realBaseDirectory) !== 0 || !is_file($realFullFilePath)) {
return ['error' => 'Access denied, log file not found, or not a file: ' . htmlspecialchars($relativeFilePath)];
}

if (!is_readable($realFullFilePath)) {
return ['error' => 'Log file not readable: ' . htmlspecialchars($relativeFilePath)];
}

$maxLines = filter_var($inputs['maxLines'] ?? 0, FILTER_VALIDATE_INT, ['options' => ['default' => 0, 'min_range' => 0]]);

$content = '';
$linesLoaded = 0;
$totalLinesInFile = 0; // Will store actual total lines only if file fully read or counted
$hitMaxLines = false;

$fileHandle = @fopen($realFullFilePath, 'r');
if ($fileHandle) {
if ($maxLines > 0) {
while (($line = fgets($fileHandle)) !== false) {
if ($linesLoaded < $maxLines) {
$content .= $line;
$linesLoaded++;
} else {
$hitMaxLines = true; // We stopped reading because maxLines was hit
// We could break here if we don't want to count total lines when maxLines is hit
// For now, let's continue counting lines if $hitMaxLines is true, for a potentially partial total count.
// This is still not ideal for very large files.
}
$totalLinesInFile++; // Count every line we process from the file pointer
}
} else {// maxLines is 0, read the whole file
while (($line = fgets($fileHandle)) !== false) {
$content .= $line;
$linesLoaded++;
}
$totalLinesInFile = $linesLoaded;
}
fclose($fileHandle);

return [
'logContent' => $content,
'linesLoaded' => $linesLoaded,
// If maxLines was hit, totalLinesInFile might be an undercount or full count depending on if we read to EOF after hitting max.
// A more robust way for partial loads: if $hitMaxLines, set totalLines to e.g. -1 (unknown beyond loaded)
'totalLines' => $hitMaxLines ? $totalLinesInFile: $linesLoaded, // If maxLines hit, totalLines reflects lines up to that point or more if counted after.
// Or simply use: $totalLinesInFile if we always count all lines in the loop.
// Let's refine: if hitMaxLines, totalLines is lines read + indication of more. Else, it's linesLoaded.
'totalLinesIfAvailable' => $totalLinesInFile, // This is the actual count of lines processed.
'maxLinesReached' => $hitMaxLines
];
} else {
return ['error' => 'Could not open log file: ' . htmlspecialchars($relativeFilePath)];
}
}
}
