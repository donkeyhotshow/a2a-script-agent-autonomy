{
    "actionId": "config.load_log_file",
    "version": "1.0.0",
    "description": "Загружает содержимое указанного лог-файла.",
    "inputs": {
        "type": "object",
        "properties": {
            "filePath": {
                "type": "string",
                "description": "Путь к лог-файлу или идентификатор, полученный от list_log_files.",
                "required": true
            },
            "maxLines": {
                "type": "integer",
                "description": "Максимальное количество строк для загрузки (например, для больших файлов). 0 или отсутствие - загрузить весь файл.",
                "default": 0
            }
        },
        "required": [
            "filePath"
        ]
    },
    "outputs": {
        "type": "object",
        "properties": {
            "logContent": {
                "type": "string",
                "description": "Содержимое лог-файла в виде строки."
            },
            "linesLoaded": {
                "type": "integer",
                "description": "Количество фактически загруженных строк."
            },
            "totalLines": {
                "type": "integer",
                "description": "Общее количество строк в файле (если известно)."
            },
            "error": {
                "type": "string",
                "description": "Сообщение об ошибке, если операция не удалась."
            }
        }
    },
    "handler": {
        "type": "php",
        "class": "ConfigModule\LogActions",
        "method": "loadLogContent",
        "file": "php/LogActions.php"
    },
    "notes": "Обработчик должен вернуть пустую строку в logContent, если файл пуст или не удалось его прочитать, и заполнить поле error."
}
