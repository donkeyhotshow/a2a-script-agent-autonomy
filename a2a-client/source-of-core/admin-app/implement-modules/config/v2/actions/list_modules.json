{
    "actionId": "config.list_modules",
    "version": "1.0.0",
    "description": "Получает список всех модулей системы и их текущий статус.",
    "inputs": {
        "type": "object",
        "properties": {
            "filterByName": {
                "type": "string",
                "description": "Фильтр для поиска модулей по имени (опционально)."
            },
            "filterByStatus": {
                "type": "string",
                "enum": [
                    "all",
                    "enabled",
                    "disabled"
                ],
                "description": "Фильтр по статусу модуля (опционально).",
                "default": "all"
            }
        }
    },
    "outputs": {
        "type": "object",
        "properties": {
            "modules": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string",
                            "description": "Уникальный ID модуля (например, папка модуля)"
                        },
                        "name": {
                            "type": "string",
                            "description": "Отображаемое имя модуля"
                        },
                        "version": {
                            "type": "string",
                            "description": "Текущая версия модуля"
                        },
                        "description": {
                            "type": "string",
                            "description": "Краткое описание модуля"
                        },
                        "isEnabled": {
                            "type": "boolean",
                            "description": "True, если модуль включен"
                        },
                        "canDisable": {
                            "type": "boolean",
                            "description": "True, если модуль можно отключить (не является ядром)"
                        },
                        "hasSettingsPage": {
                            "type": "boolean",
                            "description": "True, если у модуля есть отдельная страница настроек"
                        },
                        "settingsPageUrl": {
                            "type": "string",
                            "description": "URL страницы настроек модуля (если есть)"
                        },
                        "dependencies": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "description": "Список ID модулей, от которых зависит данный модуль"
                        }
                    },
                    "required": [
                        "id",
                        "name",
                        "version",
                        "isEnabled",
                        "canDisable"
                    ]
                },
                "description": "Массив объектов, описывающих модули."
            },
            "error": {
                "type": "string",
                "description": "Сообщение об ошибке, если операция не удалась."
            }
        },
        "required": [
            "modules"
        ]
    },
    "handler": {
        "type": "php",
        "class": "ConfigModule\ModuleActions",
        "method": "listModules",
        "file": "php/ModuleActions.php"
    },
    "notes": "Обработчик должен извлекать информацию о модулях из конфигурационных файлов системы или манифестов модулей."
}
