{
    "actionId": "config.load_config_file",
    "version": "1.0.0",
    "description": "Загружает содержимое JSON-файла с диска.",
    "inputs": {
        "type": "object",
        "properties": {
            "filePath": {
                "type": "string",
                "description": "Полный или относительный путь к JSON-файлу.",
                "required": true
            }
        },
        "required": [
            "filePath"
        ]
    },
    "outputs": {
        "type": "object",
        "properties": {
            "fileContent": {
                "type": [
                    "object",
                    "array",
                    "string",
                    "number",
                    "boolean",
                    "null"
                ],
                "description": "Распарсенное JSON-содержимое файла."
            },
            "rawFileContent": {
                "type": "string",
                "description": "Исходное строковое содержимое файла."
            },
            "error": {
                "type": "string",
                "description": "Сообщение об ошибке, если операция не удалась."
            }
        }
    },
    "handler": {
        "type": "php",
        "class": "ConfigModule\\FileActions",
        "method": "loadFile",
        "file": "php/FileActions.php"
    },
    "notes": "При ошибке чтения или парсинга, fileContent должен быть null или отсутствовать, а поле error должно содержать описание проблемы."
}
