'hasSettingsPage' => true,
'settingsPageUrl' => '#/config/user-management-settings', // Example URL
'dependencies' => ['core']
],
[
'id' => 'contentManager',
'name' => 'Content Manager',
'version' => '0.9.0',
'description' => 'Модуль для управления контентом сайта.',
'isEnabled' => false,
'canDisable' => true,
'hasSettingsPage' => true,
'settingsPageUrl' => '#/config/content-manager-settings', // Example URL
'dependencies' => ['core', 'userManagement']
],
[
'id' => 'config', // This module itself
'name' => 'Configuration Module',
'version' => '1.0.0',
'description' => 'Модуль управления конфигурациями системы.',
'isEnabled' => true,
'canDisable' => false, // Usually a config module can't be disabled from itself
'hasSettingsPage' => false,
'settingsPageUrl' => null,
'dependencies' => ['core']
]
];
// --- End Example/Placeholder Data ---

// Apply filters
$filteredModules = array_filter($availableModules, function ($module) use ($filterByName, $filterByStatus) {
$nameMatch = true;
if (!empty($filterByName)) {
$nameMatch = stripos($module['name'], $filterByName) !== false || stripos($module['id'], $filterByName) !== false;
}

$statusMatch = true;
if ($filterByStatus === 'enabled') {
$statusMatch = $module['isEnabled'] === true;
} elseif ($filterByStatus === 'disabled') {
$statusMatch = $module['isEnabled'] === false;
}
return $nameMatch && $statusMatch;
});

return ['modules' => array_values($filteredModules)]; // Re-index array
}

/**
 * Включает или отключает указанный модуль.
 *
 * @param array $inputs Входные параметры (moduleId, enabled).
 * @return array Массив с ключами 'success', 'message', или 'error'.
 */
public function setModuleEnabledStatus(array $inputs): array {
if (empty($inputs['moduleId'])) {
return ['success' => false, 'error' => 'moduleId is required.', 'message' => 'ID модуля не указан.'];
}
if (!isset($inputs['enabled']) || !is_bool($inputs['enabled'])) {
return ['success' => false, 'error' => 'enabled (boolean) is required.', 'message' => 'Не указано новое состояние модуля.'];
}

$moduleId = $inputs['moduleId'];
$newState = $inputs['enabled'];

// Placeholder logic: In a real system, this would involve:
// 1. Finding the module (e.g., from a manifest or list).
// 2. Checking if it `canDisable` (if $newState is false).
// 3. Checking dependencies if disabling (warn or auto-disable others).
// 4. Updating a central configuration file or module-specific state.
// 5. Clearing caches / re-initializing if needed.

if ($moduleId === 'core' && $newState === false) {
return ['success' => false, 'message' => 'Основной модуль системы не может быть отключен.', 'error' => 'Cannot disable core module.'];
}

// Simulate finding the module and checking canDisable (using the placeholder data from listModules for simplicity)
$allModules = $this->listModules()['modules']; // Get unfiltered list
$moduleToChange = null;
foreach ($allModules as $mod) {
if ($mod['id'] === $moduleId) {
$moduleToChange = $mod;
break;
}
}

if (!$moduleToChange) {
return ['success' => false, 'message' => "Модуль с ID '{$moduleId}' не найден.", 'error' => 'Module not found.'];
}

if ($newState === false && $moduleToChange['canDisable'] === false) {
return ['success' => false, 'message' => "Модуль '{$moduleToChange['name']}' не может быть отключен.", 'error' => 'Module cannot be disabled.'];
}

// Simulate saving the state (e.g., to a JSON file)
