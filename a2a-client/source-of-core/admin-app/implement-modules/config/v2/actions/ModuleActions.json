// $moduleSettings[$moduleId]['isEnabled'] = $newState;
// file_put_contents($configFilePath, json_encode($moduleSettings, JSON_PRETTY_PRINT));

$statusText = $newState ? 'включен': 'отключен';
return ['success' => true, 'message' => "Модуль '{$moduleToChange['name']}' успешно {$statusText}."];
}
