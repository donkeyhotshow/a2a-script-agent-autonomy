{
    "actionId": "config.save_config_file",
    "version": "1.0.0",
    "description": "Сохраняет данные в JSON-файл на диске.",
    "inputs": {
        "type": "object",
        "properties": {
            "filePath": {
                "type": "string",
                "description": "Полный или относительный путь к JSON-файлу.",
                "required": true
            },
            "fileContent": {
                "type": [
                    "object",
                    "array",
                    "string",
                    "number",
                    "boolean",
                    "null"
                ],
                "description": "Данные для сохранения. Будут сериализованы в JSON, если не строка.",
                "required": true
            },
            "prettyPrint": {
                "type": "boolean",
                "description": "Форматировать ли JSON с отступами.",
                "default": true
            }
        },
        "required": [
            "filePath",
            "fileContent"
        ]
    },
    "outputs": {
        "type": "object",
        "properties": {
            "success": {
                "type": "boolean",
                "description": "True, если файл успешно сохранен, иначе false."
            },
            "error": {
                "type": "string",
                "description": "Сообщение об ошибке, если операция не удалась."
            }
        }
    },
    "handler": {
        "type": "php",
        "class": "ConfigModule\\FileActions",
        "method": "saveFile",
        "file": "php/FileActions.php"
    },
    "notes": "Обработчик должен создать директории по пути к файлу, если они не существуют. При ошибке success должен быть false, а поле error должно содержать описание проблемы."
}
