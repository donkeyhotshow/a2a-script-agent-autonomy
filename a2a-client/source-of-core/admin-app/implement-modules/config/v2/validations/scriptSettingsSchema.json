{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Script Settings Schema",
    "description": "JSON Schema for script-specific settings, used in scripts_config.json. Allows arbitrary script paths as keys.",
    "type": "object",
    "additionalProperties": {
        "type": "object",
        "title": "Settings for a specific script",
        "properties": {
            "autoTrigger": {
                "type": "string",
                "enum": [
                    "onFileChange",
                    "manual"
                ],
                "description": "Condition for automatic script trigger."
            },
            "watchedPaths": {
                "type": "array",
                "items": {
                    "type": "string"
                },
                "description": "Array of paths to watch for changes (if autoTrigger is 'onFileChange')."
            }
        },
        "if": {
            "properties": {
                "autoTrigger": {
                    "const": "onFileChange"
                }
            }
        },
        "then": {
            "required": [
                "watchedPaths"
            ]
        }
    }
}
