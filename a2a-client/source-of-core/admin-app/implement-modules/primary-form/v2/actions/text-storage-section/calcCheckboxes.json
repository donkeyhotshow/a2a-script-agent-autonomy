{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "from": "input",
                    "to": "primary-form/data/chat-response-form"
                },
                {
                    "from": "primary-form/data/chat-response-form",
                    "to": "output:forms.chat-response-form"
                },
                {
                    "from": "primary-form/data/chat-response-form:chatResponse",
                    "with": "json_decode",
                    "to": "buffer:rawChatResponse"
                },
                {
                    "action": "update",
                    "value": {},
                    "to": "primary-form/data/text-storage-section:result-data"
                },
                {
                    "from": "buffer:rawChatResponse.address",
                    "to": "primary-form/data/program:checkboxSectionUpdatingTo"
                },
                {
                    "from": "{buffer:rawChatResponse.address}",
                    "to": "primary-form/data/text-storage-section:result-data"
                },
                {
                    "value": {},
                    "to": "primary-form/data/text-storage-section:check-section"
                },
                {
                    "value": [],
                    "to": "primary-form/data/text-storage-section:check-section.cb-form"
                },
                {
                    "value": false,
                    "to": "primary-form/templates/forms/checkbox-section:children.0.disabled"
                },
                {
                    "value": false,
                    "to": "primary-form/templates/forms/checkbox-section:children.1.disabled"
                }
            ]
        },
        {
            "disabled": true,
            "action": "print_r",
            "from": "{buffer:rawChatResponse.address}"
        },
        {
            "action": "for",
            "from": "buffer:rawChatResponse.updates",
            "to": "primary-form/templates/forms/checkbox-section:children.0.children",
            "instructions": [
                {
                    "action": "update",
                    "batch": [
                        {
                            "from": "primary-form/data/blanks/cb:template",
                            "to": "buffer:new"
                        },
                        {
                            "from": "buffer:for.currentItem.value",
                            "to": "buffer:new.props.label"
                        },
                        {
                            "from": "buffer:for.currentItem.path",
                            "to": "buffer:new.props.path"
                        },
                        {
                            "from": "buffer:for.currentIndex",
                            "to": "buffer:new.model.value"
                        },
                        {
                            "value": "{buffer:for.currentItem.action}:{buffer:for.currentItem.path}",
                            "to": "buffer:new.props.header"
                        },
                        {
                            "condition": [
                                "equals",
                                "primary-form/data/text-storage-section:result-data.{buffer:for.currentItem.path}",
                                "buffer:for.currentItem.value"
                            ],
                            "value": true,
                            "to": "buffer:new.props.disabled"
                        },
                        {
                            "value": [],
                            "to": "buffer:new.model.default"
                        },
                        {
                            "from": "buffer:new",
                            "to": "buffer:for.list"
                        }
                    ]
                }
            ]
        },
        {
            "action": "for",
            "from": "buffer:rawChatResponse.updates",
            "to": "primary-form/data/text-storage-section:check-section.instructions",
            "instructions": [
                {
                    "action": "update",
                    "batch": [
                        {
                            "value": {},
                            "to": "buffer:new"
                        },
                        {
                            "from": "buffer:for.currentItem.action",
                            "to": "buffer:new.action"
                        },
                        {
                            "value": "primary-form/data/text-storage-section:result-data.{buffer:for.currentItem.path}",
                            "to": "buffer:new.to"
                        },
                        {
                            "from": "buffer:for.currentItem.value",
                            "to": "buffer:new.value"
                        },
                        {
                            "from": "buffer:new",
                            "to": "buffer:for.list"
                        }
                    ]
                }
            ]
        },
        {
            "action": "update",
            "from": "primary-form/data/text-storage-section:result-data",
            "with": "json_encode",
            "to": "primary-form/data/text-storage-section:result-data"
        },
        {
            "action": "save",
            "from": [
                "primary-form/templates/forms/checkbox-section",
                "primary-form/data/text-storage-section",
                "primary-form/data/chat-response-form",
                "primary-form/data/state/program"
            ]
        },
        {
            "disabled": true,
            "action": "add",
            "condition": "primary-form/data/program:log",
            "from": "primary-form/data/chat-response-form",
            "to": "primary-form/data/log"
        },
        {
            "action": "update",
            "value": "1",
            "to": "output:full"
        },
        {
            "action": "call",
            "from": "primary-form/commands/load-forms-and-return"
        },
        {
            "disabled": true,
            "action": "return",
            "from": "output"
        }
    ]
}
