{
    "type": "Dialog",
    "comment": "В разработке! Эта часть не тестировалась!",
    "props": {
        "header": "Удаление окна",
        "visible": false
    },
    "fields": [
        {
            "type": "InputText",
            "props": {
                "label": "Название окна",
                "placeholder": "Введите название окна для удаления",
                "class": "w-full"
            },
            "model": {
                "form": "dialog-remove-window",
                "field": "name",
                "target": "dialog-remove-window.name",
                "default": ""
            },
            "validation": {
                "required": true,
                "message": "Название окна обязательно"
            }
        }
    ],
    "actions": [
        {
            "type": "Button",
            "props": {
                "label": "Удалить",
                "class": "p-button-danger",
                "icon": "pi pi-times"
            },
            "model": {
                "form": "dialog-remove-window",
                "field": "action",
                "target": "dialog-remove-window.action",
                "default": "windowRemove"
            },
            "customHooks": {
                "click": [
                    {
                        "action": "sendData",
                        "target": "/primary-form/actions/program-section/windowRemove"
                    }
                ]
            }
        }
    ]
}
