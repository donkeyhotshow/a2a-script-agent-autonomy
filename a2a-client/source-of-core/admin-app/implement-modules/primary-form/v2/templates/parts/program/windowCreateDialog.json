{
    "type": "Dialog",
    "props": {
        "header": "Добавление окна",
        "visible": false
    },
    "fields": [
        {
            "type": "InputText",
            "props": {
                "label": "Название окна",
                "placeholder": "Введите название окна",
                "class": "w-full"
            },
            "model": {
                "form": "dialog-new-window",
                "field": "name",
                "default": ""
            },
            "validation": {
                "required": true,
                "message": "Название окна обязательно"
            }
        }
    ],
    "actions": [
        {
            "type": "submit",
            "props": {
                "label": "Добавить",
                "class": "p-button-primary",
                "form": "dialog-new-window",
                "icon": "pi pi-check",
                "sendTo": "windowCreate"
            }
        }
    ]
}
