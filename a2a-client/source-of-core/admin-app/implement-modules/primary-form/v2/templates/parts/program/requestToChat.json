[
    {
        "type": "div",
        "props": {
            "content": "Запрос к чату",
            "class": "font-semibold text-xl w-full"
        }
    },
    {
        "type": "div",
        "props": {
            "class": "relative w-full"
        },
        "children": [
            {
                "type": "Textarea",
                "vAddress": "textarea-unique-address-001",
                "props": {
                    "class": "w-full pr-10",
                    "rows": 10,
                    "disabled": true
                },
                "model": {
                    "form": "program-section",
                    "field": "requestToChat",
                    "default": ""
                }
            },
            {
                "type": "Button",
                "vAddress": "button-unique-address-001",
                "props": {
                    "class": "absolute top-0 right-0 transition-opacity duration-300 opacity-0",
                    "icon": "pi pi-copy"
                },
                "customHooks": {
                    "mouseover": [
                        {
                            "action": "changeAttribute",
                            "emitter": "textarea-unique-address-001",
                            "data": {
                                "target": "button-unique-address-001",
                                "attribute": "class",
                                "value": "opacity-25",
                                "add": true
                            }
                        },
                        {
                            "action": "changeAttribute",
                            "emitter": "textarea-unique-address-001",
                            "data": {
                                "target": "button-unique-address-001",
                                "attribute": "class",
                                "value": "opacity-0",
                                "add": false
                            }
                        },
                        {
                            "action": "changeAttribute",
                            "emitter": "button-unique-address-001",
                            "data": {
                                "target": "button-unique-address-001",
                                "attribute": "class",
                                "value": "!opacity-100",
                                "add": true
                            }
                        }
                    ],
                    "mouseout": [
                        {
                            "action": "changeAttribute",
                            "emitter": "textarea-unique-address-001",
                            "data": {
                                "target": "button-unique-address-001",
                                "attribute": "class",
                                "value": "opacity-25",
                                "add": false
                            }
                        },
                        {
                            "action": "changeAttribute",
                            "emitter": "textarea-unique-address-001",
                            "data": {
                                "target": "button-unique-address-001",
                                "attribute": "class",
                                "value": "opacity-0",
                                "add": true
                            }
                        },
                        {
                            "action": "changeAttribute",
                            "emitter": "button-unique-address-001",
                            "data": {
                                "target": "button-unique-address-001",
                                "attribute": "class",
                                "value": "!opacity-100",
                                "add": false
                            }
                        }
                    ],
                    "click": [
                        {
                            "action": "copyToClipboard",
                            "data": {
                                "form": "program-section",
                                "field": "requestToChat"
                            }
                        }
                    ]
                }
            }
        ]
    },
    {
        "type": "div",
        "props": {
            "class": "mt-4 flex justify-end"
        },
        "children": [
            {
                "type": "Button",
                "vAddress": "navigate-button-demo",
                "props": {
                    "label": "Перейти к документации",
                    "icon": "pi pi-external-link",
                    "class": "p-button-primary"
                },
                "customHooks": {
                    "click": [
                        {
                            "action": "navigateTo",
                            "data": {
                                "route": "/landing-main-page/page"
                            }
                        }
                    ]
                }
            }
        ]
    }
]
