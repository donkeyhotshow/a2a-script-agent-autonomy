{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "value": false,
            "to": "buffer:validationFailed"
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "buffer:registration.login",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {
                        "login": "Username is required"
                    },
                    "to": "buffer:validationErrors.login"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "buffer:registration.email",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {
                        "email": "Email is required"
                    },
                    "to": "buffer:validationErrors.email"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "buffer:registration.password",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {
                        "password": "Password is required"
                    },
                    "to": "buffer:validationErrors.password"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "buffer:registration.password_confirmation",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {
                        "password_confirmation": "Password confirmation is required"
                    },
                    "to": "buffer:validationErrors.password_confirmation"
                }
            ]
        },
        {
            "action": "update",
            "condition": "!buffer:validationFailed",
            "batch": [
                {
                    "action": "update",
                    "condition": [
                        "notEquals",
                        "buffer:registration.password",
                        "buffer:registration.password_confirmation"
                    ],
                    "batch": [
                        {
                            "value": true,
                            "to": "buffer:validationFailed"
                        },
                        {
                            "value": {
                                "password_confirmation": "Password confirmation does not match"
                            },
                            "to": "buffer:validationErrors.password_confirmation"
                        }
                    ]
                }
            ]
        },
        {
            "action": "update",
            "condition": "buffer:validationFailed",
            "batch": [
                {
                    "value": true,
                    "to": "buffer:error"
                },
                {
                    "from": "buffer:validationErrors",
                    "to": "login-form/state/validationErrors"
                }
            ]
        }
    ]
}
