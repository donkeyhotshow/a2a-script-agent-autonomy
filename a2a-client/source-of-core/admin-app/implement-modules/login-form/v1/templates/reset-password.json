{
    "type": "Card",
    "props": {
        "class": "w-full max-w-md mx-auto bg-white shadow-lg rounded-lg overflow-hidden"
    },
    "children": [
        {
            "type": "div",
            "props": {
                "class": "p-4"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "text-xl font-semibold text-center mb-6"
                    },
                    "children": [
                        "Reset Your Password"
                    ]
                },
                {
                    "type": "Form",
                    "name": "reset-password-form",
                    "props": {
                        "class": "flex flex-col gap-4"
                    },
                    "children": [
                        {
                            "type": "InputText",
                            "props": {
                                "class": "hidden"
                            },
                            "model": {
                                "form": "reset-password-form",
                                "field": "token"
                            }
                        },
                        {
                            "type": "InputText",
                            "props": {
                                "placeholder": "Email",
                                "class": "w-full p-2"
                            },
                            "model": {
                                "form": "reset-password-form",
                                "field": "email"
                            }
                        },
                        {
                            "type": "Password",
                            "props": {
                                "placeholder": "New Password",
                                "toggleMask": true,
                                "class": "w-full p-2"
                            },
                            "model": {
                                "form": "reset-password-form",
                                "field": "password"
                            }
                        },
                        {
                            "type": "Password",
                            "props": {
                                "placeholder": "Confirm New Password",
                                "toggleMask": true,
                                "class": "w-full p-2"
                            },
                            "model": {
                                "form": "reset-password-form",
                                "field": "password_confirmation"
                            }
                        },
                        {
                            "type": "Button",
                            "props": {
                                "label": "Reset Password",
                                "class": "p-button-primary mt-4"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
