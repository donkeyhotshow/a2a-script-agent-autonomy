{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "from": "input",
            "to": "login-form/data/forgot-password"
        },
        {
            "action": "update",
            "batch": [
                {
                    "value": false,
                    "to": "buffer:error"
                },
                {
                    "value": [],
                    "to": "buffer:validationErrors"
                },
                {
                    "value": false,
                    "to": "buffer:resetLinkSent"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "buffer:forgot-password.email",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {
                        "email": "Email is required"
                    },
                    "to": "buffer:validationErrors.email"
                }
            ]
        },
        {
            "action": "update",
            "condition": "!buffer:validationFailed",
            "batch": [
                {
                    "value": "mysql:users",
                    "with": "json_decode",
                    "to": "buffer:users"
                },
                {
                    "action": "for",
                    "from": "buffer:users",
                    "instructions": [
                        {
                            "action": "update",
                            "condition": [
                                "equals",
                                "buffer:for.currentItem.email",
                                "buffer:forgot-password.email"
                            ],
                            "batch": [
                                {
                                    "from": "buffer:for.currentItem",
                                    "to": "buffer:userFound"
                                },
                                {
                                    "value": true,
                                    "to": "buffer:userExists"
                                }
                            ]
                        }
                    ]
                },
                {
                    "action": "update",
                    "condition": "buffer:userExists",
                    "batch": [
                        {
                            "value": "{random(64)}",
                            "to": "buffer:resetToken"
                        },
                        {
                            "value": {
                                "user_id": "{buffer:userFound.id}",
                                "token": "{buffer:resetToken}",
                                "created_at": "{date('Y-m-d H:i:s')}",
                                "expires_at": "{date('Y-m-d H:i:s', strtotime('+1 hour'))}"
                            },
                            "to": "buffer:passwordReset"
                        },
                        {
                            "action": "add",
                            "from": "buffer:passwordReset",
                            "to": "mysql:password_resets"
                        },
                        {
                            "value": true,
                            "to": "buffer:resetLinkSent"
                        },
                        {
                            "value": "Password reset link has been sent to your email",
                            "to": "buffer:successMessage"
                        }
                    ]
                },
                {
                    "action": "update",
                    "condition": "!buffer:userExists",
                    "batch": [
                        {
                            "value": true,
                            "to": "buffer:error"
                        },
                        {
                            "value": "We couldn't find a user with that email address",
                            "to": "buffer:errorMessage"
                        }
                    ]
                }
            ]
        },
        {
            "action": "return",
            "from": "buffer"
        }
    ]
}
