{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "from": "input",
            "to": "login-form/data/reset-password"
        },
        {
            "action": "update",
            "batch": [
                {
                    "value": false,
                    "to": "buffer:error"
                },
                {
                    "value": [],
                    "to": "buffer:validationErrors"
                },
                {
                    "value": false,
                    "to": "buffer:passwordReset"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "buffer:reset-password.token",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {
                        "token": "Invalid token"
                    },
                    "to": "buffer:validationErrors.token"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "buffer:reset-password.password",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {
                        "password": "Password is required"
                    },
                    "to": "buffer:validationErrors.password"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "buffer:reset-password.password_confirmation",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {
                        "password_confirmation": "Password confirmation is required"
                    },
                    "to": "buffer:validationErrors.password_confirmation"
                }
            ]
        },
        {
            "action": "update",
            "condition": "!buffer:validationFailed",
            "batch": [
                {
                    "action": "update",
                    "condition": [
                        "notEquals",
                        "buffer:reset-password.password",
                        "buffer:reset-password.password_confirmation"
                    ],
                    "batch": [
                        {
                            "value": true,
                            "to": "buffer:validationFailed"
                        },
                        {
                            "value": {
                                "password_confirmation": "Password confirmation does not match"
                            },
                            "to": "buffer:validationErrors.password_confirmation"
                        }
                    ]
                }
            ]
        },
        {
            "action": "update",
            "condition": "!buffer:validationFailed",
            "batch": [
                {
                    "value": "mysql:password_resets",
                    "with": "json_decode",
                    "to": "buffer:passwordResets"
                },
                {
                    "action": "for",
                    "from": "buffer:passwordResets",
                    "instructions": [
                        {
                            "action": "update",
                            "condition": [
                                "equals",
                                "buffer:for.currentItem.token",
                                "buffer:reset-password.token"
                            ],
                            "batch": [
                                {
                                    "from": "buffer:for.currentItem",
                                    "to": "buffer:resetRecord"
                                },
                                {
                                    "value": true,
                                    "to": "buffer:tokenExists"
                                }
                            ]
                        }
                    ]
                },
                {
                    "action": "update",
                    "condition": "buffer:tokenExists",
                    "batch": [
                        {
                            "action": "update",
                            "condition": [
                                "greaterThan",
                                "buffer:resetRecord.expires_at",
                                "{date('Y-m-d H:i:s')}"
                            ],
                            "batch": [
                                {
                                    "value": "mysql:users",
                                    "with": "json_decode",
                                    "to": "buffer:users"
                                },
                                {
                                    "action": "for",
                                    "from": "buffer:users",
                                    "instructions": [
                                        {
                                            "action": "update",
                                            "condition": [
                                                "equals",
                                                "buffer:for.currentItem.id",
                                                "buffer:resetRecord.user_id"
                                            ],
                                            "batch": [
                                                {
                                                    "from": "buffer:for.currentItem",
                                                    "to": "buffer:userToUpdate"
                                                },
                                                {
                                                    "from": "buffer:reset-password.password",
                                                    "to": "buffer:userToUpdate.password"
                                                },
                                                {
                                                    "value": true,
                                                    "to": "buffer:userFound"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "action": "update",
                                    "condition": "buffer:userFound",
                                    "batch": [
                                        {
                                            "from": "buffer:userToUpdate",
                                            "to": "mysql:users.{buffer:userToUpdate.id}"
                                        },
                                        {
                                            "value": true,
                                            "to": "buffer:passwordReset"
                                        },
                                        {
                                            "value": "Password has been reset successfully",
                                            "to": "buffer:successMessage"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "action": "update",
                            "condition": [
                                "!greaterThan",
                                "buffer:resetRecord.expires_at",
                                "{date('Y-m-d H:i:s')}"
                            ],
                            "batch": [
                                {
                                    "value": true,
                                    "to": "buffer:error"
                                },
                                {
                                    "value": "Password reset token has expired",
                                    "to": "buffer:errorMessage"
                                }
                            ]
                        }
                    ]
                },
                {
                    "action": "update",
                    "condition": "!buffer:tokenExists",
                    "batch": [
                        {
                            "value": true,
                            "to": "buffer:error"
                        },
                        {
                            "value": "Invalid password reset token",
                            "to": "buffer:errorMessage"
                        }
                    ]
                }
            ]
        },
        {
            "action": "return",
            "from": "buffer"
        }
    ]
}
