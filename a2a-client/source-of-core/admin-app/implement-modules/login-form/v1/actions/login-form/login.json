{
    "type": "Instructions",
    "instructions": [
        {
            "action": "print_r",
            "from": "input"
        },
        {
            "action": "print_r",
            "from": "args"
        },
        {
            "action": "call",
            "from": "login-form/commands/authenticate"
        },
        {
            "action": "update",
            "condition": "buffer:authenticated",
            "batch": [
                {
                    "from": "buffer:authenticatedUser",
                    "to": "session!user"
                },
                {
                    "value": "Successfully logged in. Welcome back!",
                    "to": "buffer:successMessage"
                }
            ]
        },
        {
            "action": "update",
            "from": "buffer",
            "to": "output"
        }
    ]
}
