{
    "type": "Page",
    "title": "Login Form",
    "content": {
        "type": "Card",
        "props": {
            "class": "w-full max-w-md mx-auto mt-8 bg-surface-900 text-surface-0 rounded-lg shadow-2xl overflow-hidden border border-surface-700"
        },
        "children": [
            {
                "type": "Form",
                "name": "login-form",
                "props": {
                    "class": "p-8 bg-surface-800 rounded-md shadow-lg"
                },
                "children": [
                    {
                        "type": "InputText",
                        "props": {
                            "placeholder": "Enter your login",
                            "class": "mt-1 block w-full bg-surface-700 text-surface-0",
                            "label": "Login"
                        },
                        "model": {
                            "form": "login-form",
                            "field": "login"
                        }
                    },
                    {
                        "type": "Password",
                        "props": {
                            "placeholder": "Enter your password",
                            "class": "mt-1 block w-full bg-surface-700 text-surface-0",
                            "label": "Password"
                        },
                        "model": {
                            "form": "login-form",
                            "field": "password"
                        }
                    },
                    {
                        "type": "Button",
                        "props": {
                            "label": "Login",
                            "icon": "pi pi-sign-in",
                            "class": "btn-primary ml-auto"
                        },
                        "customHooks": {
                            "click": [
                                {
                                    "action": "sendData",
                                    "data": {
                                        "sendTo": "login-form/login",
                                        "form": "login-form"
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        ]
    }
}
