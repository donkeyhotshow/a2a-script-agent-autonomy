{
    "_comment": "Example questions for QTU v2, showcasing various input types and categorization.",
    "questions": [
        {
            "stepId": "user_name",
            "questionText": "What is your name?",
            "category": "Basic Information",
            "input": {
                "type": "string",
                "placeholder": "Enter your full name",
                "validation": {
                    "required": true,
                    "minLength": 2
                },
                "ariaDescribedBy": "user_name_help"
            },
            "helpText": {
                "id": "user_name_help",
                "text": "Please provide your first and last name."
            }
        },
        {
            "stepId": "user_email",
            "questionText": "What is your email address?",
            "category": "Basic Information",
            "input": {
                "type": "string",
                "placeholder": "e.g., user@example.com",
                "validation": {
                    "required": true,
                    "pattern": "^[\\w\\.-]+@[\\w\\.-]+\\.\\w{2,4}$"
                },
                "ariaDescribedBy": "user_email_help"
            },
            "helpText": {
                "id": "user_email_help",
                "text": "A valid email address is required for contact."
            }
        },
        {
            "stepId": "age",
            "questionText": "How old are you?",
            "category": "Personal Details",
            "input": {
                "type": "integer",
                "placeholder": "Enter your age",
                "validation": {
                    "required": true,
                    "min": 18,
                    "max": 120
                }
            }
        },
        {
            "stepId": "subscribe_newsletter",
            "questionText": "Subscribe to our newsletter?",
            "category": "Preferences",
            "input": {
                "type": "boolean"
            }
        },
        {
            "stepId": "preferred_contact_method",
            "questionText": "Preferred contact method:",
            "category": "Preferences",
            "input": {
                "type": "choice",
                "options": [
                    {"value": "email", "text": "Email"},
                    {"value": "phone", "text": "Phone"},
                    {"value": "mail", "text": "Snail Mail"}
                ],
                "placeholder": "Select a method"
            }
        },
        {
            "stepId": "profile_picture",
            "questionText": "Upload your profile picture:",
            "category": "Personal Details",
            "input": {
                "type": "filePath",
                "placeholder": "Choose an image file...",
                "validation": {
                    "accept": "image/*"
                }
            }
        },
        {
            "stepId": "project_directory",
            "questionText": "Select your project directory:",
            "category": "Project Setup",
            "input": {
                "type": "directoryPath",
                "placeholder": "Choose a folder..."
            }
        },
        {
            "stepId": "bio",
            "questionText": "Tell us about yourself (max 500 characters):",
            "category": "Personal Details",
            "input": {
                "type": "textarea",
                "placeholder": "Your biography...",
                "rows": 5,
                "validation": {
                    "maxLength": 500
                }
            }
        },
        {
            "stepId": "communication_prefs",
            "questionText": "How would you like to be notified?",
            "category": "Preferences",
            "input": {
                "type": "checkbox_list",
                "options": [
                    {"value": "email_updates", "text": "Product Updates via Email"},
                    {"value": "sms_alerts", "text": "SMS Alerts for critical issues"},
                    {"value": "app_notifications", "text": "In-app Notifications"}
                ],
                "orientation": "vertical"
            }
        },
        {
            "stepId": "satisfaction_level",
            "questionText": "How satisfied are you with our service?",
            "category": "Feedback",
            "input": {
                "type": "radio",
                "options": [
                    {"value": "very_satisfied", "text": "Very Satisfied"},
                    {"value": "satisfied", "text": "Satisfied"},
                    {"value": "neutral", "text": "Neutral"},
                    {"value": "unsatisfied", "text": "Unsatisfied"},
                    {"value": "very_unsatisfied", "text": "Very Unsatisfied"}
                ],
                "orientation": "horizontal",
                "validation": {
                    "required": true
                }
            }
        },
        {
            "stepId": "terms_agreement",
            "questionText": "Please review our terms and conditions.",
            "category": "Legal",
            "input": {
                "type": "text_block",
                "content": "By proceeding, you agree to our <a href=\"/terms\" target=\"_blank\">Terms of Service</a> and <a href=\"/privacy\" target=\"_blank\">Privacy Policy</a>. This is a non-interactive informational block."
            }
        },
        {
            "stepId": "feature_usage",
            "questionText": "Which features do you use most often?",
            "input": {
                "type": "checkbox_list",
                "options": [
                    {"value": "feature_a", "text": "Feature A"},
                    {"value": "feature_b", "text": "Feature B"},
                    {"value": "feature_c", "text": "Feature C"},
                    {"value": "other", "text": "Other (please specify)"}
                ],
                "orientation": "vertical"
            }
        },
        {
            "stepId": "install_path",
            "questionText": "Installation Path:",
            "category": "Project Setup",
            "input": {
                "type": "string",
                "placeholder": "/opt/app_name",
                "validation": {
                    "required": true
                }
            },
            "condition": {
                "field": "responses[project_directory]",
                "operator": "isNotEmpty"
            }
        }
    ]
} 