{
    "type": "form",
    "id": "commandExecutionForm",
    "props": {
        "class": "space-y-4"
    },
    "children": [
        {
            "type": "div",
            "props": {
                "class": "flex space-x-2 mb-2"
            },
            "children": [
                {
                    "type": "button",
                    "props": {
                        "type": "button",
                        "class": "bg-blue-500 text-white px-3 py-1 rounded text-sm flex items-center"
                    },
                    "children": [
                        "Load Scenarios"
                    ],
                    "customHooks": {
                        "click": [
                            {
                                "action": "call",
                                "from": "question-to-user/actions/list-system-scenarios.json",
                                "to": "buffer:availableScenarios"
                            }
                        ]
                    }
                },
                {
                    "type": "button",
                    "props": {
                        "type": "button",
                        "class": "bg-blue-500 text-white px-3 py-1 rounded text-sm flex items-center"
                    },
                    "children": [
                        "Load Tasks"
                    ],
                    "customHooks": {
                        "click": [
                            {
                                "action": "call",
                                "from": "question-to-user/actions/list-system-tasks.json",
                                "to": "buffer:availableTasks"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "type": "div",
            "props": {
                "class": "mb-4"
            },
            "children": [
                {
                    "type": "label",
                    "props": {
                        "class": "block mb-1 font-medium"
                    },
                    "children": [
                        "Scenario ID*"
                    ]
                },
                {
                    "type": "select",
                    "props": {
                        "class": "w-full p-2 border rounded"
                    },
                    "model": {
                        "field": "scenarioId",
                        "default": null,
                        "options": [
                            { "name": "Load scenarios first", "id": null }
                        ]
                    }
                }
            ]
        },
        {
            "type": "div",
            "props": {
                "class": "mb-4"
            },
            "children": [
                {
                    "type": "label",
                    "props": {
                        "class": "block mb-1 font-medium"
                    },
                    "children": [
                        "Task ID (Optional)"
                    ]
                },
                {
                    "type": "select",
                    "props": {
                        "class": "w-full p-2 border rounded"
                    },
                    "model": {
                        "field": "taskId",
                        "default": null,
                        "options": [
                            { "name": "Load tasks first", "id": null }
                        ]
                    }
                }
            ]
        },
        {
            "type": "div",
            "props": {
                "class": "mb-4"
            },
            "children": [
                {
                    "type": "label",
                    "props": {
                        "class": "block mb-1 font-medium"
                    },
                    "children": [
                        "User Input Value (Optional)"
                    ]
                },
                {
                    "type": "input",
                    "props": {
                        "type": "text",
                        "placeholder": "Value for scenario step requiring input",
                        "class": "w-full p-2 border rounded"
                    },
                    "model": {
                        "field": "userInputValue"
                    }
                }
            ]
        },
        {
            "type": "div",
            "props": {
                "class": "flex space-x-2 mt-4"
            },
            "children": [
                {
                    "type": "button",
                    "props": {
                        "type": "button",
                        "class": "bg-green-500 text-white px-3 py-2 rounded"
                    },
                    "children": [
                        "Execute Scenario"
                    ],
                    "customHooks": {
                        "click": [
                            {
                                "action": "call",
                                "from": "question-to-user/actions/execute-main-work-scenario.json",
                                "input": {
                                    "scenarioId": "{input:commandExecutionForm.scenarioId}",
                                    "taskId": "{input:commandExecutionForm.taskId}",
                                    "userInputValue": "{input:commandExecutionForm.userInputValue}"
                                },
                                "to": "buffer:commandExecutionResult"
                            }
                        ]
                    }
                },
                {
                    "type": "button",
                    "props": {
                        "type": "button",
                        "class": "bg-yellow-500 text-white px-3 py-2 rounded border border-yellow-600"
                    },
                    "children": [
                        "Reset Scenario Progress"
                    ],
                    "customHooks": {
                        "click": [
                            {
                                "action": "call",
                                "from": "question-to-user/actions/reset-main-work-scenario.json",
                                "input": {
                                    "scenarioId": "{input:commandExecutionForm.scenarioId}",
                                    "taskId": "{input:commandExecutionForm.taskId}"
                                },
                                "to": "buffer:commandResetResult"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "type": "div",
            "props": {
                "class": "mt-4 border rounded p-2"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "font-semibold p-2 bg-gray-100 flex justify-between cursor-pointer"
                    },
                    "children": [
                        {
                            "type": "span",
                            "props": {
                                "class": "font-semibold"
                            },
                            "children": [
                                "Execution Result"
                            ]
                        }
                    ]
                },
                {
                    "type": "div",
                    "props": {
                        "class": "p-4 space-y-2 hidden"
                    },
                    "children": [
                        {
                            "type": "div",
                            "props": {
                                "class": "font-semibold mt-2"
                            },
                            "children": [
                                {
                                    "type": "span",
                                    "props": {
                                        "class": "font-semibold"
                                    },
                                    "children": [
                                        "Raw Output:"
                                    ]
                                }
                            ]
                        },
                        {
                            "type": "div",
                            "props": {
                                "class": "p-2 border bg-gray-50 h-[200px] overflow-auto"
                            },
                            "children": [
                                {
                                    "type": "pre",
                                    "props": {
                                        "class": "whitespace-pre-wrap"
                                    },
                                    "children": [
                                        "{buffer:commandExecutionResult.rawOutput | stringify}"
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}

