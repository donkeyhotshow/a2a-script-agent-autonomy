{
    "type": "div",
    "props": {
        "id": "dynamic-question-content-area-target",
        "class": "space-y-4"
    },
    "children": [
        {
            "type": "div",
            "props": {
                "class": "mb-3 border rounded shadow"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "bg-gray-100 p-3 font-medium border-b"
                    },
                    "children": [
                        {
                            "type": "span",
                            "props": {
                                "content": "Sample Questions"
                            }
                        }
                    ]
                },
                {
                    "type": "div",
                    "props": {
                        "class": "p-4"
                    },
                    "children": [
                        {
                            "type": "div",
                            "props": {
                                "content": "Question 1 of 3",
                                "class": "font-normal text-sm mb-2"
                            }
                        },
                        {
                            "type": "div",
                            "props": {
                                "content": "What is your name?",
                                "class": "mb-2 font-medium"
                            }
                        },
                        {
                            "type": "input",
                            "props": {
                                "type": "text",
                                "placeholder": "Enter your name",
                                "class": "w-full p-2 border rounded mb-4"
                            },
                            "model": {
                                "field": "userName",
                                "default": null
                            }
                        },
                        {
                            "type": "div",
                            "props": {
                                "content": "Question 2 of 3",
                                "class": "font-normal text-sm mb-2"
                            }
                        },
                        {
                            "type": "div",
                            "props": {
                                "content": "Select your preferred language:",
                                "class": "mb-2 font-medium"
                            }
                        },
                        {
                            "type": "select",
                            "props": {
                                "class": "w-full p-2 border rounded mb-4"
                            },
                            "model": {
                                "field": "preferredLanguage",
                                "default": null,
                                "options": [
                                    { "label": "Select a language", "value": "" },
                                    { "label": "English", "value": "en" },
                                    { "label": "Russian", "value": "ru" },
                                    { "label": "French", "value": "fr" },
                                    { "label": "German", "value": "de" }
                                ]
                            }
                        },
                        {
                            "type": "div",
                            "props": {
                                "content": "Question 3 of 3",
                                "class": "font-normal text-sm mb-2"
                            }
                        },
                        {
                            "type": "div",
                            "props": {
                                "content": "Do you agree to the terms?",
                                "class": "mb-2 font-medium"
                            }
                        },
                        {
                            "type": "div",
                            "props": {
                                "class": "mb-4 flex items-center"
                            },
                            "children": [
                                {
                                    "type": "input",
                                    "props": {
                                        "type": "checkbox",
                                        "class": "mr-2"
                                    },
                                    "model": {
                                        "field": "agreeToTerms",
                                        "default": false
                                    }
                                },
                                {
                                    "type": "span",
                                    "props": {
                                        "content": "I agree to the terms and conditions"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
