{
    "type": "div",
    "id": "scenario-list-display-template",
    "props": {
        "class": "space-y-3",
        "role": "region",
        "aria-labelledby": "scenario-list-heading"
    },
    "children": [
        {
            "type": "h3",
            "id": "scenario-list-heading",
            "props": {
                "class": "sr-only",
                "children": "Scenario List"
            }
        },
        {
            "type": "button",
            "props": {
                "type": "button",
                "class": "bg-gray-200 hover:bg-gray-300 text-gray-800 px-3 py-1 rounded text-sm flex items-center mb-3",
                "children": "Refresh Scenario List",
                "aria-label": "Refresh list of available scenarios",
                "aria-controls": "scenario-list-container"
            },
            "customHooks": {
                "click": [
                    {
                        "action": "call",
                        "from": "question-to-user/actions/list-system-scenarios.json",
                        "to": "buffer:scenarioList"
                    }
                ]
            }
        },
        {
            "type": "div",
            "id": "scenario-list-container",
            "props": {
                "class": "bg-gray-50 border rounded p-3 min-h-[100px]",
                "role": "list",
                "aria-label": "Available system scenarios",
                "aria-live": "polite"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "text-gray-500 italic",
                        "children": "Click the refresh button to load available scenarios."
                    }
                }
            ]
        }
    ]
}
