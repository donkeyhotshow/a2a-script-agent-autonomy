{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "load-ai-probe-questions",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["ai", "probe", "questions", "ui-generation"],
                        "ai_summary": "Loads AI probe questions from a file and prepares them for UI generation.",
                        "features": ["dynamic-ui", "question-processing"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Load AI probe questions from file and prepare for UI generation"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/data/ai-probe-questions.json",
                    "to": "buffer:probeQuestions"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:probeQuestions",
                    "to": "file!question-to-user/data/current-probe-questions.json"
                }
            ]
        },
        {
            "action": "save",
            "from": "file!question-to-user/data/current-probe-questions.json"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/data/current-probe-questions.json",
                    "to": "output:currentQuestions"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "value": {
                        "success": true,
                        "message": "AI probe questions loaded successfully.",
                        "questions": "{buffer:probeQuestions}"
                    },
                    "to": "output:result"
                }
            ]
        }
    ]
} 