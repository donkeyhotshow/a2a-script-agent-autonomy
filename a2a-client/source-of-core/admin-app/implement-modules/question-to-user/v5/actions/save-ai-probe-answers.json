{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "save-ai-probe-answers",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["ai", "probe", "answers", "data-storage"],
                        "ai_summary": "Saves AI probe answers to persistent storage.",
                        "features": ["data-persistence"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Save AI probe answers to persistent storage"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "input:answers",
                    "to": "buffer:answers"
                },
                {
                    "value": {
                        "timestamp": "{system:timestamp}",
                        "answers": "{buffer:answers}"
                    },
                    "to": "buffer:answerData"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:answerData",
                    "to": "file!question-to-user/data/ai-probe-answers/{input:probeId}.json"
                }
            ]
        },
        {
            "action": "save",
            "from": "file!question-to-user/data/ai-probe-answers/{input:probeId}.json"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "value": {
                        "success": true,
                        "message": "AI probe answers saved successfully.",
                        "probeId": "{input:probeId}"
                    },
                    "to": "output:result"
                }
            ]
        }
    ]
} 