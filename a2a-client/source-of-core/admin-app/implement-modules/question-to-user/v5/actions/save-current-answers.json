{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "save-current-answers",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["answers", "data-storage"],
                        "ai_summary": "Saves current answers to persistent storage.",
                        "features": ["data-persistence"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Save current answers to persistent storage"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "input:answers",
                    "to": "buffer:answers"
                },
                {
                    "value": {
                        "timestamp": "{system:timestamp}",
                        "answers": "{buffer:answers}"
                    },
                    "to": "buffer:answerData"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:answerData",
                    "to": "file!question-to-user/data/user_answer_sets/current_answers"
                }
            ]
        },
        {
            "action": "save",
            "from": "file!question-to-user/data/user_answer_sets/current_answers"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "value": {
                        "success": true,
                        "message": "Current answers saved successfully."
                    },
                    "to": "output:result"
                }
            ]
        }
    ]
} 