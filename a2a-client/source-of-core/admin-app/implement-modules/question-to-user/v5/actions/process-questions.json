{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "process-questions",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["questions", "processing", "ui-generation"],
                        "ai_summary": "Processes a set of questions and prepares them for display.",
                        "features": ["dynamic-ui", "question-processing"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Process questions and prepare for display"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "input:questions",
                    "to": "buffer:questions"
                },
                {
                    "from": "file!question-to-user/data/ui-blanks/question-template.json",
                    "to": "buffer:questionTemplate"
                }
            ]
        },
        {
            "action": "for",
            "from": "buffer:questions",
            "to": "currentItem",
            "instructions": [
                {
                    "action": "update",
                    "batch": [
                        {
                            "from": "buffer:questionTemplate",
                            "to": "buffer:currentQuestion"
                        },
                        {
                            "from": "buffer:for.currentItem.text",
                            "to": "buffer:currentQuestion.props.content"
                        },
                        {
                            "from": "buffer:for.currentItem.id",
                            "to": "buffer:currentQuestion.props.id"
                        },
                        {
                            "from": "buffer:currentQuestion",
                            "to": "buffer:processedQuestions"
                        }
                    ]
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:processedQuestions",
                    "to": "file!question-to-user/templates/processed-questions.json"
                }
            ]
        },
        {
            "action": "save",
            "from": "file!question-to-user/templates/processed-questions.json"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "value": {
                        "success": true,
                        "message": "Questions processed successfully.",
                        "questions": "{buffer:processedQuestions}"
                    },
                    "to": "output:result"
                }
            ]
        }
    ]
} 