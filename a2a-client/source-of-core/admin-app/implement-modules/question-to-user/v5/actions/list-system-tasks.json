{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "list-system-tasks",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["tasks", "system", "list", "workflow"],
                        "ai_summary": "Retrieves and returns a list of available system tasks.",
                        "features": ["system-lists", "task-management"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Lists available system tasks by reading from a data file. TODO: Integrate with actual backend task listing mechanism if this file is not the source of truth."
        },
        {
            "action": "comment",
            "value": "Fetching list of system tasks from data file."
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/data/system_lists/tasks",
                    "to": "buffer:fetchedTasks"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "from": "buffer:fetchedTasks",
                    "to": "output:result"
                }
            ]
        }
    ]
} 