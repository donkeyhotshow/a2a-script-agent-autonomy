{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "populate-demo-form",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["demo", "form", "data-population"],
                        "ai_summary": "Populates a demo form with provided data.",
                        "features": ["dynamic-ui", "form-processing"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Populate demo form with provided data"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/templates/demo-form.json",
                    "to": "buffer:demoForm"
                },
                {
                    "from": "input:formData",
                    "to": "buffer:formData"
                }
            ]
        },
        {
            "action": "for",
            "from": "buffer:formData",
            "to": "currentItem",
            "instructions": [
                {
                    "action": "update",
                    "batch": [
                        {
                            "from": "buffer:for.currentItem.value",
                            "to": "buffer:demoForm.fields.{buffer:for.currentItem.field}.value"
                        }
                    ]
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:demoForm",
                    "to": "file!question-to-user/templates/demo-form.json"
                }
            ]
        },
        {
            "action": "save",
            "from": "file!question-to-user/templates/demo-form.json"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/templates/demo-form.json",
                    "to": "output:currentForm"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "value": {
                        "success": true,
                        "message": "Demo form populated successfully.",
                        "form": "{buffer:demoForm}"
                    },
                    "to": "output:result"
                }
            ]
        }
    ]
} 