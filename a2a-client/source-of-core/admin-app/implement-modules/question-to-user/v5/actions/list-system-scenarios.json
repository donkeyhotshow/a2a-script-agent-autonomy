{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "list-system-scenarios",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["scenarios", "system", "list", "workflow"],
                        "ai_summary": "Retrieves and returns a list of available system scenarios.",
                        "features": ["system-lists", "workflow-management"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Lists available system scenarios by reading from a data file. TODO: Integrate with actual backend scenario listing mechanism if this file is not the source of truth."
        },
        {
            "action": "comment",
            "value": "Fetching list of system scenarios from data file."
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/data/system_lists/scenarios",
                    "to": "buffer:fetchedScenarios"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "from": "buffer:fetchedScenarios",
                    "to": "output:result"
                }
            ]
        }
    ]
} 