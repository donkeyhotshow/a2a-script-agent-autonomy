{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "submit-manual-response",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["manual", "response", "submission"],
                        "ai_summary": "Submits a manual response for processing.",
                        "features": ["response-processing"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Submit manual response for processing"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "input:response",
                    "to": "buffer:response"
                },
                {
                    "value": {
                        "timestamp": "{system:timestamp}",
                        "response": "{buffer:response}",
                        "type": "manual"
                    },
                    "to": "buffer:responseData"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:responseData",
                    "to": "file!question-to-user/data/responses/{input:responseId}.json"
                }
            ]
        },
        {
            "action": "save",
            "from": "file!question-to-user/data/responses/{input:responseId}.json"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "value": {
                        "success": true,
                        "message": "Manual response submitted successfully.",
                        "responseId": "{input:responseId}"
                    },
                    "to": "output:result"
                }
            ]
        }
    ]
} 