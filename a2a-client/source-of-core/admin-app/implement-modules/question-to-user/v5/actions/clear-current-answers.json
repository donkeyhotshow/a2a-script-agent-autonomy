{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "clear-current-answers",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["answers", "clear", "reset", "user-data"],
                        "ai_summary": "Clears the current user answers data.",
                        "features": ["data-management", "user-answers"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Clear current answers data."
        },
        {
            "action": "update",
            "batch": [
                {
                    "value": {},
                    "to": "buffer:currentAnswers"
                },
                {
                    "from": "buffer:currentAnswers",
                    "to": "file!question-to-user/data/user_answer_sets/current_answers"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/data/user_answer_sets/current_answers",
                    "to": "output:currentAnswers"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Regenerate UI after clearing answers."
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                }
            ]
        }
    ]
} 