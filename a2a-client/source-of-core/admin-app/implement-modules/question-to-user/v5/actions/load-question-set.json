{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "batch": [
                {
                    "value": "load-question-set",
                    "to": "buffer:actionId"
                },
                {
                    "value": {
                        "keywords": ["questions", "set", "ui-generation"],
                        "ai_summary": "Loads a set of questions and prepares them for display.",
                        "features": ["dynamic-ui", "question-processing"]
                    },
                    "to": "buffer:tags"
                }
            ]
        },
        {
            "action": "comment",
            "value": "Load question set and prepare for display"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/data/question-sets/{input:setId}.json",
                    "to": "buffer:questionSet"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:questionSet",
                    "to": "file!question-to-user/templates/current-question-set.json"
                }
            ]
        },
        {
            "action": "save",
            "from": "file!question-to-user/templates/current-question-set.json"
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "file!question-to-user/templates/current-question-set.json",
                    "to": "output:currentQuestionSet"
                }
            ]
        },
        {
            "action": "update",
            "batch": [
                {
                    "from": "buffer:actionId",
                    "to": "output:actionId"
                },
                {
                    "from": "buffer:tags",
                    "to": "output:tags"
                },
                {
                    "value": {
                        "success": true,
                        "message": "Question set loaded successfully.",
                        "questions": "{buffer:questionSet}"
                    },
                    "to": "output:result"
                }
            ]
        }
    ]
} 