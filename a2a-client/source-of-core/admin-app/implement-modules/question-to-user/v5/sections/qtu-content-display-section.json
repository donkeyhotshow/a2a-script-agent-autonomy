{
    "type": "div",
    "id": "qtu-content-display-section",
    "props": {
        "class": "qtu-content-display p-2 mb-3 {{props.class?}}"
    },
    "children": [
        {
            "type": "div",
            "props": {
                "content": "{{props.markdownText}}",
                "class": "text-surface-700 dark:text-surface-200 prose dark:prose-invert max-w-none"
            }
        },
        {
            "type": "div",
            "props": {
                "class": "ai-analysis-summary mt-2 p-2 border-l-4 border-primary-500 bg-primary-50 dark:bg-primary-900/30 text-sm text-primary-700 dark:text-primary-300"
            },
            "children": [
                {
                    "type": "Span",
                    "props": {
                        "class": "font-semibold",
                        "content": "AI Analysis: "
                    }
                },
                {
                    "type": "Span",
                    "props": {
                        "content": "{{props.aiAnalysisResult}}"
                    }
                }
            ]
        }
    ]
}
