{
    "type": "div",
    "id": "qtu-user-input-section",
    "props": {
        "class": "qtu-user-input-section-wrapper {{props.class?}}"
    },
    "children": [
        {
            "type": "form",
            "props": {
                "id": "{{props.formId}}",
                "class": "qtu-user-input-section space-y-4"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "form-field-example"
                    },
                    "children": [
                        {
                            "type": "span",
                            "props": {
                                "content": "{{props.fields[0].label? | Field 1 Label}}"
                            }
                        },
                        {
                            "type": "InputText",
                            "props": {
                                "placeholder": "{{props.fields[0].placeholder?}}"
                            }
                        }
                    ]
                },
                {
                    "type": "div",
                    "props": {
                        "class": "form-field-example"
                    },
                    "children": [
                        {
                            "type": "span",
                            "props": {
                                "content": "{{props.fields[1].label? | Field 2 Label}}"
                            }
                        },
                        {
                            "type": "Textarea",
                            "props": {
                                "placeholder": "{{props.fields[1].placeholder?}}",
                                "rows": 3
                            },
                            "model": {
                                "form": "qtuInputForm",
                                "field": "user_response_text"
                            }
                        }
                    ]
                },
                {
                    "type": "div",
                    "props": {
                        "class": "form-field-example"
                    },
                    "children": [
                        {
                            "type": "span",
                            "props": {
                                "content": "{{props.fields[2].label? | Keywords (Optional)}}"
                            }
                        },
                        {
                            "type": "InputText",
                            "props": {
                                "placeholder": "{{props.fields[2].placeholder?}}"
                            },
                            "model": {
                                "form": "qtuInputForm",
                                "field": "user_keywords"
                            }
                        }
                    ]
                },
                {
                    "type": "div",
                    "props": {
                        "class": "flex justify-end space-x-3 pt-4"
                    },
                    "children": [
                        {
                            "type": "Button",
                            "props": {
                                "label": "Submit Response",
                                "icon": "pi pi-check",
                                "severity": "primary"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
