{
    "type": "div",
    "id": "question-display-section",
    "props": {
        "class": "space-y-4",
        "aria-labelledby": "question-display-heading"
    },
    "children": [
        {
            "type": "h2",
            "id": "question-display-heading",
            "props": {
                "class": "sr-only",
                "children": "Question Display Section"
            }
        },
        {
            "type": "div",
            "id": "question-loading-buttons",
            "props": {
                "class": "mb-4 flex space-x-2",
                "role": "toolbar",
                "aria-label": "Question loading options"
            },
            "children": [
                {
                    "type": "button",
                    "props": {
                        "type": "button",
                        "class": "bg-blue-500 text-white px-3 py-1 rounded text-sm",
                        "children": "Get Next Question",
                        "aria-label": "Get next AI generated question",
                        "aria-controls": "dynamic-question-content-area"
                    },
                    "customHooks": {
                        "click": [
                            {
                                "action": "call",
                                "from": "question-to-user/actions/get-next-ai-probe-question.json",
                                "to": "buffer:generatedQuestionUI"
                            }
                        ]
                    }
                },
                {
                    "type": "button",
                    "props": {
                        "type": "button",
                        "class": "bg-purple-500 text-white px-3 py-1 rounded text-sm",
                        "children": "Load AI Probe Set",
                        "aria-label": "Load complete AI probe question set",
                        "aria-controls": "dynamic-question-content-area"
                    },
                    "customHooks": {
                        "click": [
                            {
                                "action": "call",
                                "from": "question-to-user/actions/load-ai-probe-questions.json",
                                "to": "buffer:loadedAiQuestions"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "type": "div",
            "id": "dynamic-question-content-area",
            "props": {
                "class": "space-y-4 p-4 bg-gray-50 border rounded min-h-[100px]",
                "role": "region",
                "aria-label": "Question content area",
                "aria-live": "polite"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "text-gray-500 italic",
                        "children": "Questions will be loaded and displayed here. Use one of the buttons above to load question content."
                    }
                }
            ]
        },
        {
            "type": "div",
            "id": "manual-input-section",
            "props": {
                "class": "mt-6",
                "aria-labelledby": "manual-input-heading"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "border rounded"
                    },
                    "children": [
                        {
                            "type": "div",
                            "props": {
                                "class": "bg-gray-100 p-3 font-medium border-b"
                            },
                            "children": [
                                {
                                    "type": "h3",
                                    "id": "manual-input-heading",
                                    "props": {
                                        "class": "font-medium",
                                        "children": "Manual User Input"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "div",
                            "props": {
                                "class": "p-4"
                            },
                            "children": [
                                {
                                    "type": "div",
                                    "props": {
                                        "class": "mb-4"
                                    },
                                    "children": [
                                        {
                                            "type": "label",
                                            "props": {
                                                "for": "manualResponseField",
                                                "class": "block mb-1 font-medium",
                                                "children": "Your Response:"
                                            }
                                        },
                                        {
                                            "type": "textarea",
                                            "props": {
                                                "id": "manualResponseField",
                                                "placeholder": "Type your response here...",
                                                "class": "w-full p-2 border rounded min-h-[100px]",
                                                "aria-label": "Manual response input",
                                                "aria-required": "true"
                                            },
                                            "model": {
                                                "field": "manualResponse"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "div",
                                    "props": {
                                        "class": "flex justify-end"
                                    },
                                    "children": [
                                        {
                                            "type": "button",
                                            "props": {
                                                "type": "button",
                                                "class": "bg-green-500 text-white px-3 py-2 rounded",
                                                "children": "Submit Response",
                                                "aria-label": "Submit your manual response"
                                            },
                                            "customHooks": {
                                                "click": [
                                                    {
                                                        "action": "call",
                                                        "from": "question-to-user/actions/submit-manual-response.json",
                                                        "input": {
                                                            "response": "{input:mainQtuResponseForm.manualResponse}"
                                                        },
                                                        "to": "buffer:manualSubmitStatus"
                                                    }
                                                ]
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
