[
    {
        "id": "q_ds_name",
        "type": "InputText",
        "label": "What is your name?",
        "modelField": "userName",
        "props": {
            "placeholder": "Enter your full name"
        }
    },
    {
        "id": "q_ds_feedback",
        "type": "Textarea",
        "label": "Please provide your detailed feedback:",
        "modelField": "userFeedback",
        "props": {
            "rows": 5,
            "placeholder": "Type your feedback here..."
        }
    },
    {
        "id": "q_ds_mood",
        "type": "Dropdown",
        "label": "How are you feeling today?",
        "modelField": "userMood",
        "props": {
            "options": [
                {
                    "value": "happy",
                    "label": "Happy"
                },
                {
                    "value": "neutral",
                    "label": "Neutral"
                },
                {
                    "value": "sad",
                    "label": "Sad"
                }
            ],
            "placeholder": "Select your mood"
        }
    },
    {
        "id": "q_ds_confirm",
        "type": "Checkbox",
        "label": "I confirm I have read the terms and conditions.",
        "modelField": "userConfirmation",
        "props": {
            "binary": true
        }
    },
    {
        "id": "q_ds_contact_method",
        "type": "RadioButtonGroup",
        "label": "Preferred contact method:",
        "modelField": "userContactMethod",
        "props": {
            "options": [
                {
                    "value": "email",
                    "label": "Email"
                },
                {
                    "value": "phone",
                    "label": "Phone"
                },
                {
                    "value": "none",
                    "label": "No Contact"
                }
            ],
            "orientation": "horizontal"
        }
    }
]
