{
    "type": "Page",
    "id": "qtu-dynamic-form-page",
    "title": "Dynamic Form Demo",
    "description": "Демонстрация динамического создания формы из массива данных",
    "content": {
        "type": "div",
        "props": {
            "class": "flex flex-col min-h-screen bg-gray-100"
        },
        "children": [
            {
                "type": "div",
                "props": {
                    "class": "flex-grow container mx-auto p-4 space-y-6"
                },
                "children": [
                    {
                        "type": "Panel",
                        "props": {
                            "header": "Пример данных для формы",
                            "class": "mb-6 shadow-md rounded"
                        },
                        "children": [
                            {
                                "type": "div",
                                "props": {
                                    "class": "space-y-4"
                                },
                                "children": [
                                    {
                                        "type": "Textarea",
                                        "props": {
                                            "rows": 8,
                                            "autoResize": true,
                                            "class": "w-full font-mono text-sm"
                                        },
                                        "model": {
                                            "field": "formDataJson"
                                        }
                                    },
                                    {
                                        "type": "Button",
                                        "props": {
                                            "label": "Сгенерировать форму",
                                            "icon": "pi pi-cog",
                                            "severity": "primary",
                                            "class": "p-button mt-2"
                                        },
                                        "customHooks": {
                                            "click": [
                                                {
                                                    "action": "call",
                                                    "from": "question-to-user/actions/process-questions",
                                                    "input": "{pageState.formDataJson | parse}",
                                                    "to": "buffer:processResult"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "Panel",
                        "props": {
                            "header": "Сгенерированная форма",
                            "class": "shadow-md rounded"
                        },
                        "children": [
                            {
                                "type": "div",
                                "id": "dynamic-question-content-area-target",
                                "props": {
                                    "class": "p-4 min-h-[300px] bg-gray-50 border rounded"
                                },
                                "children": [
                                    {
                                        "type": "div",
                                        "props": {
                                            "class": "text-gray-500 italic text-center py-8"
                                        },
                                        "children": [
                                            "Нажмите 'Сгенерировать форму' для создания динамической формы из JSON данных выше"
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "Panel",
                        "props": {
                            "header": "Действия с формой",
                            "class": "shadow-md rounded"
                        },
                        "children": [
                            {
                                "type": "div",
                                "props": {
                                    "class": "p-4 flex flex-row space-x-4"
                                },
                                "children": [
                                    {
                                        "type": "Button",
                                        "props": {
                                            "label": "Сохранить ответы",
                                            "icon": "pi pi-save",
                                            "severity": "success",
                                            "class": "p-button-sm"
                                        },
                                        "customHooks": {
                                            "click": [
                                                {
                                                    "action": "call",
                                                    "from": "question-to-user/actions/save-current-answers",
                                                    "to": "buffer:saveResult"
                                                }
                                            ]
                                        }
                                    },
                                    {
                                        "type": "Button",
                                        "props": {
                                            "label": "Очистить ответы",
                                            "icon": "pi pi-trash",
                                            "severity": "danger",
                                            "class": "p-button-sm"
                                        },
                                        "customHooks": {
                                            "click": [
                                                {
                                                    "action": "call",
                                                    "from": "question-to-user/actions/clear-current-answers",
                                                    "to": "buffer:clearResult"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
} 