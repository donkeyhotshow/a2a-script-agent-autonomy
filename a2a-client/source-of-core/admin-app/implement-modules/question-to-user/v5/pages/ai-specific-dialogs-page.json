{
    "type": "Page",
    "id": "qtu-ai-specific-dialogs-page",
    "title": "QTU AI-Driven Specific Dialogs",
    "description": "Facilitates AI-driven probing questions and analysis of user responses.",
    "content": {
        "type": "div",
        "props": {
            "class": "flex flex-col min-h-screen bg-gray-100"
        },
        "children": [
            {
                "type": "div",
                "props": {
                    "class": "flex-grow container mx-auto p-4 space-y-6"
                },
                "children": [
                    {
                        "type": "Panel",
                        "props": {
                            "header": "AI Dialog Control",
                            "class": "mb-6 shadow-md rounded"
                        },
                        "children": [
                            {
                                "type": "div",
                                "props": {
                                    "class": "p-4"
                                },
                                "children": [
                                    {
                                        "type": "Button",
                                        "props": {
                                            "label": "Load/Refresh AI Questions",
                                            "icon": "pi pi-sync",
                                            "severity": "secondary",
                                            "class": "p-button-sm w-full md:w-auto"
                                        },
                                        "customHooks": {
                                            "click": [
                                                {
                                                    "action": "call",
                                                    "from": "question-to-user/actions/load-ai-probe-questions",
                                                    "to": "pageState.loadQuestionStatus"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "Panel",
                        "props": {
                            "header": "AI Inquiry",
                            "class": "mb-6 shadow-md rounded"
                        },
                        "children": [
                            {
                                "type": "div",
                                "props": {
                                    "class": "p-4"
                                },
                                "children": [
                                    {
                                        "type": "Form",
                                        "id": "aiProbeForm",
                                        "props": {
                                            "class": "space-y-4"
                                        },
                                        "children": [
                                            {
                                                "type": "Button",
                                                "props": {
                                                    "label": "Submit Responses",
                                                    "type": "submit",
                                                    "icon": "pi pi-check",
                                                    "class": "p-button-success mt-4 w-full md:w-auto"
                                                },
                                                "customHooks": {
                                                    "click": [
                                                        {
                                                            "action": "call",
                                                            "from": "question-to-user/actions/save-ai-probe-answers",
                                                            "to": "pageState.submitResponseStatus"
                                                        }
                                                    ]
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "Panel",
                        "props": {
                            "header": "Your Response (Manual Input)",
                            "class": "mb-6 shadow-md rounded"
                        },
                        "children": [
                            {
                                "type": "Form",
                                "id": "manualResponseForm",
                                "props": {
                                    "class": "p-4 space-y-4"
                                },
                                "children": [
                                    {
                                        "type": "Textarea",
                                        "props": {
                                            "rows": 5,
                                            "placeholder": "Enter your thoughts here...",
                                            "class": "w-full border rounded p-2"
                                        },
                                        "model": {
                                            "field": "responseText"
                                        }
                                    },
                                    {
                                        "type": "Button",
                                        "props": {
                                            "label": "Submit Manual Response",
                                            "class": "p-button-primary w-full md:w-auto"
                                        },
                                        "customHooks": {
                                            "click": [
                                                {
                                                    "action": "call",
                                                    "from": "question-to-user/actions/submit-manual-response",
                                                    "input": {
                                                        "responseText": "{input:manualResponseForm.responseText}"
                                                    },
                                                    "to": "pageState.manualResponseStatus"
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "Panel",
                        "props": {
                            "header": "AI Analysis/Feedback",
                            "class": "shadow-md rounded"
                        },
                        "children": [
                            {
                                "type": "div",
                                "props": {
                                    "class": "p-4"
                                },
                                "children": [
                                    {
                                        "type": "div",
                                        "id": "ai-feedback-area",
                                        "props": {
                                            "class": "p-3 bg-gray-50 border rounded",
                                            "content": "AI feedback will be dynamically loaded here. (e.g., via an action updating this component or an included template)"
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
