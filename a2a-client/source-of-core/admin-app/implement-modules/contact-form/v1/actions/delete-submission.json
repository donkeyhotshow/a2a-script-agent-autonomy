{
    "type": "Instructions",
    "instructions": [
        {
            "action": "comment",
            "value": "Delete submission at the specified index"
        },
        {
            "action": "update",
            "from": "contact-form/data/submissions",
            "operation": {
                "type": "removeByIndex",
                "index": "{input:payload.indexToDelete}"
            },
            "to": "contact-form/data/submissions"
        },
        {
            "action": "save",
            "from": "contact-form/data/submissions"
        },
        {
            "action": "return",
            "value": {
                "status": "success",
                "message": "Submission deleted."
            }
        }
    ]
}
