{
    "type": "Instructions",
    "instructions": [
        {
            "action": "comment",
            "value": "Append incoming contact form data to the submissions list"
        },
        {
            "action": "add",
            "from": "form:contactFormData",
            "to": "contact-form/data/submissions",
            "how": "append"
        },
        {
            "action": "save",
            "from": "contact-form/data/submissions"
        },
        {
            "action": "return",
            "value": {
                "status": "success",
                "message": "Thank you for your message!",
                "commands": [
                    {
                        "command": "notify",
                        "props": {
                            "severity": "success",
                            "summary": "Success",
                            "detail": "Thank you for your message!",
                            "life": 3000
                        }
                    }
                ]
            }
        }
    ]
}
