{
    "type": "Instructions",
    "instructions": [
        {
            "action": "comment",
            "value": "Initialize validation flags"
        },
        {
            "action": "update",
            "batch": [
                {
                    "value": false,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": {},
                    "to": "buffer:validationErrors"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "{form:contactFormData.name}",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": "Please enter your name",
                    "to": "buffer:validationErrors.name"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "{form:contactFormData.email}",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": "Please enter your email address",
                    "to": "buffer:validationErrors.email"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "equals",
                "{form:contactFormData.message}",
                ""
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": "Please enter your message",
                    "to": "buffer:validationErrors.message"
                }
            ]
        },
        {
            "action": "update",
            "condition": [
                "and",
                [
                    "not",
                    "buffer:validationFailed"
                ],
                [
                    "notEquals",
                    "{form:contactFormData.email}",
                    ""
                ],
                [
                    "!matches",
                    "{form:contactFormData.email}",
                    "/^[\\w-\\.]+@([\\w-]+\\.)+[\\w-]{2,4}$/"
                ]
            ],
            "batch": [
                {
                    "value": true,
                    "to": "buffer:validationFailed"
                },
                {
                    "value": "Please enter a valid email address",
                    "to": "buffer:validationErrors.email"
                }
            ]
        },
        {
            "action": "return",
            "condition": "buffer:validationFailed",
            "value": {
                "status": "error",
                "message": "Please correct the errors below.",
                "errors": "{buffer:validationErrors}",
                "commands": [
                    {
                        "command": "notify",
                        "props": {
                            "severity": "error",
                            "summary": "Validation Error",
                            "detail": "Please check the form for errors.",
                            "life": 5000
                        }
                    }
                ]
            }
        },
        {
            "action": "call",
            "condition": [
                "not",
                "buffer:validationFailed"
            ],
            "from": "contact-form/actions/receive-submission",
            "params": {
                "form:contactFormData": "{form:contactFormData}"
            }
        }
    ]
}
