{
    "type": "div",
    "props": {
        "class": "py-12 px-4 md:px-6 lg:px-8",
        "role": "region",
        "id": "marketplace-hero-section",
        "aria-labelledby": "marketplace-hero-section-title"
    },
    "children": [
        {
            "type": "Grid",
            "props": {
                "class": "grid-cols-1 md:grid-cols-3 gap-4"
