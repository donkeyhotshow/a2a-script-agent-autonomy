                                    "backgroundImage": "url('/assets/1.jpg')",
                                    "backgroundSize": "cover",
                                    "backgroundPosition": "center"
                                }
                            },
                            "children": [
                                {
                                    "type": "div",
                                    "props": {
                                        "class": "absolute inset-0 bg-black opacity-50"
                                    }
