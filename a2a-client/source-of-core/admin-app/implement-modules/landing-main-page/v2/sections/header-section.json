{
    "type": "div",
    "name": "header-section-v6",
    "props": {
        "class": "py-4 px-4 md:px-6 lg:px-8 xl:px-10 2xl:px-12 mx-auto flex items-center justify-between relative bg-surface-0 dark:bg-surface-900 border-b border-surface-200 dark:border-surface-700",
        "style": {
            "position": "sticky",
            "top": 0,
            "zIndex": 1000,
            "backdropFilter": "blur(8px)",
            "backgroundColor": "rgba(255, 255, 255, 0.85)"
        }
    },
    "children": [
        {
            "type": "operation",
            "action": "include",
            "source": "layout/templates/header/brand-logo.json"
        },
        {
            "type": "div",
            "props": {
                "class": "hidden lg:flex items-center"
            },
            "children": [
                {
                    "type": "operation",
                    "action": "include",
                    "source": "layout/templates/header/navigation-links.json"
                },
                {
                    "type": "operation",
                    "action": "include",
                    "source": "layout/templates/header/login-signup-button.json"
                }
            ]
        },
        {
            "type": "Button",
            "props": {
                "icon": "pi pi-bars",
                "text": true,
                "severity": "secondary",
                "class": "lg:hidden text-2xl text-primary"
            },
            "customHooks": {
                "click": [
                    {
                        "action": "toggleClass",
                        "data": {
                            "selector": ".mobile-menu-v6",
                            "class": "hidden"
                        }
                    }
                ]
            }
        },
        {
            "type": "div",
            "props": {
                "class": "mobile-menu-v6 hidden fixed top-0 left-0 w-full h-full z-50 bg-surface-0 dark:bg-surface-900 p-4 overflow-y-auto lg:hidden"
            },
            "children": [
                {
                    "type": "div",
                    "props": {
                        "class": "flex justify-between items-center pb-4 border-b border-surface-200 dark:border-surface-700"
                    },
                    "children": [
                        {
                            "type": "operation",
                            "action": "include",
                            "source": "layout/templates/header/brand-logo.json"
                        },
                        {
                            "type": "Button",
                            "props": {
                                "icon": "pi pi-times",
                                "text": true,
                                "severity": "secondary",
                                "class": "text-2xl text-primary"
                            },
                            "customHooks": {
                                "click": [
                                    {
                                        "action": "toggleClass",
                                        "data": {
                                            "selector": ".mobile-menu-v6",
                                            "class": "hidden"
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "div",
                    "props": {
                        "class": "py-4 flex flex-col space-y-2"
                    },
                    "children": [
                        {
                            "type": "operation",
                            "action": "include",
                            "source": "layout/templates/header/navigation-links.json"
                        }
                    ]
                },
                {
                    "type": "div",
                    "props": {
                        "class": "pt-4 border-t border-surface-200 dark:border-surface-700"
                    },
                    "children": [
                        {
                            "type": "operation",
                            "action": "include",
                            "source": "layout/templates/header/login-signup-button.json"
                        }
                    ]
                }
            ]
        }
    ]
}
