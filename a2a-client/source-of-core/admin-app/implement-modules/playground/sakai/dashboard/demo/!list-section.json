{
    "type": "Section",
    "name": "dashboard-overview-asd",
    "props": {
        "class": "py-6 px-6 lg:px-20 my-2 md:my-6"
    },
    "children": [
        {
            "type": "Grid",
            "props": {
                "class": "flex flex-col"
            },
            "children": [
                {
                    "type": "Card",
                    "props": {
                        "class": "flex flex-col"
                    },
                    "children": [
                        {
                            "type": "Text",
                            "props": {
                                "content": "DataView",
                                "class": "font-semibold text-xl"
                            }
                        },
                        {
                            "type": "DataView",
                            "props": {
                                "value": "products",
                                "layout": "layout"
                            },
                            "children": [
                                {
                                    "type": "Template",
                                    "props": {
                                        "slot": "header"
                                    },
                                    "children": [
                                        {
                                            "type": "div",
                                            "props": {
                                                "class": "flex justify-end"
                                            },
                                            "children": [
                                                {
                                                    "type": "SelectButton",
                                                    "props": {
                                                        "model": "layout",
                                                        "options": "options",
                                                        "allowEmpty": false
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "Template",
                                                            "props": {
                                                                "slot": "option"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "Icon",
                                                                    "props": {
                                                                        "class": "[option === 'list' ? 'pi pi-bars' : 'pi pi-table']"
                                                                    }
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "type": "Template",
                                    "props": {
                                        "slot": "list"
                                    },
                                    "children": [
                                        {
                                            "type": "div",
                                            "props": {
                                                "class": "flex flex-col"
                                            },
                                            "children": [
                                                {
                                                    "type": "div",
                                                    "props": {
                                                        "v-for": "(item, index) in slotProps.items",
                                                        ":key": "index",
                                                        "class": "flex flex-col sm:flex-row sm:items-center p-6 gap-4",
                                                        ":class": "{ 'border-t border-surface': index !== 0 }"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "div",
                                                            "props": {
                                                                "class": "md:w-40 relative"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "Image",
                                                                    "props": {
                                                                        "class": "block xl:block mx-auto rounded w-full",
                                                                        ":src": "`https://primefaces.org/cdn/primevue/images/product/${item.image}`",
                                                                        ":alt": "item.name"
                                                                    }
                                                                },
                                                                {
                                                                    "type": "Tag",
                                                                    "props": {
                                                                        ":value": "item.inventoryStatus",
                                                                        ":severity": "getSeverity(item)",
                                                                        "class": "absolute dark:!bg-surface-900",
                                                                        "style": "left: 4px; top: 4px"
                                                                    }
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "type": "div",
                                                            "props": {
                                                                "class": "flex flex-col md:flex-row justify-between md:items-center flex-1 gap-6"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "div",
                                                                    "props": {
                                                                        "class": "flex flex-row md:flex-col justify-between items-start gap-2"
                                                                    },
                                                                    "children": [
                                                                        {
                                                                            "type": "div",
                                                                            "children": [
                                                                                {
                                                                                    "type": "Text",
                                                                                    "props": {
                                                                                        "content": "{{ item.category }}",
                                                                                        "class": "font-medium text-surface-500 dark:text-surface-400 text-sm"
                                                                                    }
                                                                                },
                                                                                {
                                                                                    "type": "Text",
                                                                                    "props": {
                                                                                        "content": "{{ item.name }}",
                                                                                        "class": "text-lg font-medium mt-2"
                                                                                    }
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "type": "div",
                                                                            "props": {
                                                                                "class": "bg-surface-100 p-1",
                                                                                "style": "border-radius: 30px"
                                                                            },
                                                                            "children": [
                                                                                {
                                                                                    "type": "div",
                                                                                    "props": {
                                                                                        "class": "bg-surface-0 flex items-center gap-2 justify-center py-1 px-2",
                                                                                        "style": "border-radius: 30px; box-shadow: 0px 1px 2px 0px rgba(0, 0, 0, 0.04), 0px 1px 2px 0px rgba(0, 0, 0, 0.06);"
                                                                                    },
                                                                                    "children": [
                                                                                        {
                                                                                            "type": "Text",
                                                                                            "props": {
                                                                                                "content": "{{ item.rating }}",
                                                                                                "class": "text-surface-900 font-medium text-sm"
                                                                                            }
                                                                                        },
                                                                                        {
                                                                                            "type": "Icon",
                                                                                            "props": {
                                                                                                "class": "pi pi-star-fill text-yellow-500"
                                                                                            }
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "div",
                                                                    "props": {
                                                                        "class": "flex flex-col md:items-end gap-8"
                                                                    },
                                                                    "children": [
                                                                        {
                                                                            "type": "Text",
                                                                            "props": {
                                                                                "content": "${{ item.price }}",
                                                                                "class": "text-xl font-semibold"
                                                                            }
                                                                        },
                                                                        {
                                                                            "type": "div",
                                                                            "props": {
                                                                                "class": "flex flex-row-reverse md:flex-row gap-2"
                                                                            },
                                                                            "children": [
                                                                                {
                                                                                    "type": "Button",
                                                                                    "props": {
                                                                                        "icon": "pi pi-heart",
                                                                                        "outlined": true
                                                                                    }
                                                                                },
                                                                                {
                                                                                    "type": "Button",
                                                                                    "props": {
                                                                                        "icon": "pi pi-shopping-cart",
                                                                                        "label": "Buy Now",
                                                                                        ":disabled": "item.inventoryStatus === 'OUTOFSTOCK'",
                                                                                        "class": "flex-auto md:flex-initial whitespace-nowrap"
                                                                                    }
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "type": "Template",
                                    "props": {
                                        "slot": "grid"
                                    },
                                    "children": [
                                        {
                                            "type": "Grid",
                                            "props": {
                                                "class": "grid grid-cols-12 gap-4"
                                            },
                                            "children": [
                                                {
                                                    "type": "Column",
                                                    "props": {
                                                        "v-for": "(item, index) in slotProps.items",
                                                        ":key": "index",
                                                        "class": "col-span-12 sm:col-span-6 lg:col-span-4 p-2"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "div",
                                                            "props": {
                                                                "class": "p-6 border border-surface-200 dark:border-surface-700 bg-surface-0 dark:bg-surface-900 rounded flex flex-col"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "div",
                                                                    "props": {
                                                                        "class": "bg-surface-50 flex justify-center rounded p-4"
                                                                    },
                                                                    "children": [
                                                                        {
                                                                            "type": "div",
                                                                            "props": {
                                                                                "class": "relative mx-auto"
                                                                            },
                                                                            "children": [
                                                                                {
                                                                                    "type": "Image",
                                                                                    "props": {
                                                                                        "class": "rounded w-full",
                                                                                        ":src": "`https://primefaces.org/cdn/primevue/images/product/${item.image}`",
                                                                                        ":alt": "item.name",
                                                                                        "style": "max-width: 300px"
                                                                                    }
                                                                                },
                                                                                {
                                                                                    "type": "Tag",
                                                                                    "props": {
                                                                                        ":value": "item.inventoryStatus",
                                                                                        ":severity": "getSeverity(item)",
                                                                                        "class": "absolute dark:!bg-surface-900",
                                                                                        "style": "left: 4px; top: 4px"
                                                                                    }
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "type": "div",
                                                                    "props": {
                                                                        "class": "pt-6"
                                                                    },
                                                                    "children": [
                                                                        {
                                                                            "type": "div",
                                                                            "props": {
                                                                                "class": "flex flex-row justify-between items-start gap-2"
                                                                            },
                                                                            "children": [
                                                                                {
                                                                                    "type": "div",
                                                                                    "children": [
                                                                                        {
                                                                                            "type": "Text",
                                                                                            "props": {
                                                                                                "content": "{{ item.category }}",
                                                                                                "class": "font-medium text-surface-500 dark:text-surface-400 text-sm"
                                                                                            }
                                                                                        },
                                                                                        {
                                                                                            "type": "Text",
                                                                                            "props": {
                                                                                                "content": "{{ item.name }}",
                                                                                                "class": "text-lg font-medium mt-1"
                                                                                            }
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "type": "div",
                                                                                    "props": {
                                                                                        "class": "bg-surface-100 p-1",
                                                                                        "style": "border-radius: 30px"
                                                                                    },
                                                                                    "children": [
                                                                                        {
                                                                                            "type": "div",
                                                                                            "props": {
                                                                                                "class": "bg-surface-0 flex items-center gap-2 justify-center py-1 px-2",
                                                                                                "style": "border-radius: 30px; box-shadow: 0px 1px 2px 0px rgba(0, 0, 0, 0.04), 0px 1px 2px 0px rgba(0, 0, 0, 0.06);"
                                                                                            },
                                                                                            "children": [
                                                                                                {
                                                                                                    "type": "Text",
                                                                                                    "props": {
                                                                                                        "content": "{{ item.rating }}",
                                                                                                        "class": "text-surface-900 font-medium text-sm"
                                                                                                    }
                                                                                                },
                                                                                                {
                                                                                                    "type": "Icon",
                                                                                                    "props": {
                                                                                                        "class": "pi pi-star-fill text-yellow-500"
                                                                                                    }
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "type": "div",
                                                                            "props": {
                                                                                "class": "flex flex-col gap-6 mt-6"
                                                                            },
                                                                            "children": [
                                                                                {
                                                                                    "type": "Text",
                                                                                    "props": {
                                                                                        "content": "${{ item.price }}",
                                                                                        "class": "text-2xl font-semibold"
                                                                                    }
                                                                                },
                                                                                {
                                                                                    "type": "div",
                                                                                    "props": {
                                                                                        "class": "flex gap-2"
                                                                                    },
                                                                                    "children": [
                                                                                        {
                                                                                            "type": "Button",
                                                                                            "props": {
                                                                                                "icon": "pi pi-shopping-cart",
                                                                                                "label": "Buy Now",
                                                                                                ":disabled": "item.inventoryStatus === 'OUTOFSTOCK'",
                                                                                                "class": "flex-auto whitespace-nowrap"
                                                                                            }
                                                                                        },
                                                                                        {
                                                                                            "type": "Button",
                                                                                            "props": {
                                                                                                "icon": "pi pi-heart",
                                                                                                "outlined": true
                                                                                            }
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "Grid",
            "props": {
                "class": "flex flex-col lg:flex-row gap-8"
            },
            "children": [
                {
                    "type": "Column",
                    "props": {
                        "class": "lg:w-2/3"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "PickList",
                                        "class": "font-semibold text-xl mb-4"
                                    }
                                },
                                {
                                    "type": "PickList",
                                    "props": {
                                        "model": "picklistProducts",
                                        "breakpoint": "1400px",
                                        "dataKey": "id"
                                    },
                                    "children": [
                                        {
                                            "type": "Template",
                                            "props": {
                                                "slot": "option"
                                            },
                                            "children": [
                                                {
                                                    "type": "Text",
                                                    "props": {
                                                        "content": "{{ option.name }}"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "props": {
                        "class": "lg:w-1/3"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "OrderList",
                                        "class": "font-semibold text-xl mb-4"
                                    }
                                },
                                {
                                    "type": "OrderList",
                                    "props": {
                                        "model": "orderlistProducts",
                                        "breakpoint": "1400px",
                                        "dataKey": "id",
                                        "pt:pcList:root": "w-full"
                                    },
                                    "children": [
                                        {
                                            "type": "Template",
                                            "props": {
                                                "slot": "option"
                                            },
                                            "children": [
                                                {
                                                    "type": "Text",
                                                    "props": {
                                                        "content": "{{ option.name }}"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
