{
    "type": "Section",
    "name": "dashboard-overview-asd",
    "props": {
        "class": "py-6 px-6 lg:px-20 my-2 md:my-6"
    },
    "children": [
        {
            "type": "Grid",
            "props": {
                "class": "flex flex-col md:flex-row gap-8"
            },
            "children": [
                {
                    "type": "Column",
                    "props": {
                        "class": "md:w-1/2"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col gap-4"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4'>Menubar</div>"
                                    }
                                },
                                {
                                    "type": "Menubar",
                                    "props": {
                                        "model": "nestedMenuitems"
                                    },
                                    "children": [
                                        {
                                            "type": "IconField",
                                            "props": {
                                                "iconPosition": "left"
                                            },
                                            "children": [
                                                {
                                                    "type": "InputIcon",
                                                    "props": {
                                                        "class": "pi pi-search"
                                                    }
                                                },
                                                {
                                                    "type": "InputText",
                                                    "props": {
                                                        "type": "text",
                                                        "placeholder": "Search"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "props": {
                        "class": "md:w-1/2"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col gap-4"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4'>Breadcrumb</div>"
                                    }
                                },
                                {
                                    "type": "Breadcrumb",
                                    "props": {
                                        "home": "breadcrumbHome",
                                        "model": "breadcrumbItems"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "Grid",
            "props": {
                "class": "flex flex-col md:flex-row gap-8 mt-6"
            },
            "children": [
                {
                    "type": "Column",
                    "props": {
                        "class": "md:w-1/3"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col gap-4"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4'>Tiered Menu</div>"
                                    }
                                },
                                {
                                    "type": "TieredMenu",
                                    "props": {
                                        "model": "tieredMenuItems"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "props": {
                        "class": "md:w-1/3"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col gap-4"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4'>Plain Menu</div>"
                                    }
                                },
                                {
                                    "type": "Menu",
                                    "props": {
                                        "model": "menuitems"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "props": {
                        "class": "md:w-1/3"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col gap-4"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4'>Overlay Menu</div>"
                                    }
                                },
                                {
                                    "type": "Menu",
                                    "props": {
                                        "ref": "menu",
                                        "model": "overlayMenuItems",
                                        "popup": true
                                    }
                                },
                                {
                                    "type": "Button",
                                    "props": {
                                        "type": "button",
                                        "label": "Options",
                                        "icon": "pi pi-angle-down",
                                        "@click": "toggleMenu",
                                        "style": "width: auto"
                                    }
                                }
                            ]
                        },
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col gap-4",
                                "@contextmenu": "onContextRightClick"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4'>Context Menu</div>Right click to display."
                                    }
                                },
                                {
                                    "type": "ContextMenu",
                                    "props": {
                                        "ref": "contextMenu",
                                        "model": "contextMenuItems"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "type": "Grid",
            "props": {
                "class": "flex flex-col md:flex-row gap-8 mt-8"
            },
            "children": [
                {
                    "type": "Column",
                    "props": {
                        "class": "md:w-1/2"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col gap-4"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4'>MegaMenu | Horizontal</div>"
                                    }
                                },
                                {
                                    "type": "MegaMenu",
                                    "props": {
                                        "model": "megamenuItems"
                                    }
                                },
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4 mt-8'>MegaMenu | Vertical</div>"
                                    }
                                },
                                {
                                    "type": "MegaMenu",
                                    "props": {
                                        "model": "megamenuItems",
                                        "orientation": "vertical"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "props": {
                        "class": "md:w-1/2"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "flex flex-col gap-4"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "<div class='font-semibold text-xl mb-4'>PanelMenu</div>"
                                    }
                                },
                                {
                                    "type": "PanelMenu",
                                    "props": {
                                        "model": "panelMenuitems"
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}