                                        {
                                            "type": "Template",
                                            "props": {
                                                "slot": "content",
                                                "slotProps": "slotProps"
                                            },
                                            "children": [
                                                {
                                                    "type": "Text",
                                                    "props": {
                                                        "content": "{{ slotProps.item }}"
                                                    }
                                                }
