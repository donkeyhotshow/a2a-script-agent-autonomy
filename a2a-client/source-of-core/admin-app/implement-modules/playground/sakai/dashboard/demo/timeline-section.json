                                                                {
                                                                    "type": "Button",
                                                                    "props": {
                                                                        "label": "Read more",
                                                                        "text": true
                                                                    }
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
