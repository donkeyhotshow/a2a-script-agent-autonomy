                                    "type": "Text",
                                    "props": {
                                        "content": "Right Align",
                                        "class": "font-semibold text-xl mb-4"
                                    }
                                },
                                {
                                    "type": "Timeline",
                                    "props": {
                                        "value": "events",
                                        "align": "right"
                                    },
                                    "children": [
                                        {
                                            "type": "Template",
                                            "props": {
                                                "slot": "content",
                                                "slotProps": "slotProps"
                                            },
                                            "children": [
                                                {
                                                    "type": "Text",
                                                    "props": {
                                                        "content": "{{ slotProps.item.status }}"
                                                    }
                                                }
                                            ]
