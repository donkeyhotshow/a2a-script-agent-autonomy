                                    "type": "Timeline",
                                    "props": {
                                        "value": "horizontalEvents",
                                        "layout": "horizontal",
                                        "align": "bottom"
                                    },
                                    "children": [
                                        {
                                            "type": "Template",
                                            "props": {
                                                "slot": "content",
                                                "slotProps": "slotProps"
                                            },
                                            "children": [
                                                {
                                                    "type": "Text",
                                                    "props": {
                                                        "content": "{{ slotProps.item }}"
