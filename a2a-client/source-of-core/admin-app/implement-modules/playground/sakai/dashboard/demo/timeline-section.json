            },
            "children": [
                {
                    "type": "Column",
                    "props": {
                        "class": "col-span-6"
                    },
                    "children": [
                        {
                            "type": "Card",
                            "props": {
                                "class": "card"
                            },
                            "children": [
                                {
                                    "type": "Text",
                                    "props": {
                                        "content": "Left Align",
                                        "class": "font-semibold text-xl mb-4"
                                    }
                                },
                                {
                                    "type": "Timeline",
                                    "props": {
                                        "value": "events"
                                    },
                                    "children": [
                                        {
                                            "type": "Template",
                                            "props": {
                                                "slot": "content",
                                                "slotProps": "slotProps"
                                            },
                                            "children": [
                                                {
                                                    "type": "Text",
                                                    "props": {
                                                        "content": "{{ slotProps.item.status }}"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "props": {
                        "class": "col-span-6"
                    },
                    "children": [
                        {
