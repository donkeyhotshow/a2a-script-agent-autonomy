{
    "type": "Section",
    "name": "media-section",
    "props": {
        "class": "py-6 px-6 lg:px-20 my-2 md:my-6"
    },
    "children": [
        {
            "type": "Grid",
            "props": {
                "class": "grid grid-cols-12 gap-4"
            },
            "children": [
                {
                    "type": "Column",
                    "props": {
                        "class": "col-span-12"
                    },
                    "children": [
                        {
                            "type": "Text",
                            "props": {
                                "content": "<div class='font-semibold text-xl mb-4'>Carousel</div>"
                            }
                        },
                        {
                            "type": "Carousel",
                            "props": {
                                "value": "products",
                                "numVisible": 3,
                                "numScroll": 3,
                                "responsiveOptions": "carouselResponsiveOptions"
                            },
                            "children": [
                                {
                                    "type": "Template",
                                    "props": {
                                        "slot": "item"
                                    },
                                    "children": [
                                        {
                                            "type": "div",
                                            "props": {
                                                "class": "border border-surface-200 dark:border-surface-700 rounded m-2 p-4"
                                            },
                                            "children": [
                                                {
                                                    "type": "div",
                                                    "props": {
                                                        "class": "mb-4"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "div",
                                                            "props": {
                                                                "class": "relative mx-auto"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "Image",
                                                                    "props": {
                                                                        "src": "'https://primefaces.org/cdn/primevue/images/product/' + slotProps.data.image",
                                                                        "alt": "slotProps.data.name",
                                                                        "class": "w-full rounded"
                                                                    }
                                                                },
                                                                {
                                                                    "type": "div",
                                                                    "props": {
                                                                        "class": "dark:bg-surface-900 absolute rounded-border",
                                                                        "style": "left: 5px; top: 5px"
                                                                    },
                                                                    "children": [
                                                                        {
                                                                            "type": "Tag",
                                                                            "props": {
                                                                                "value": "slotProps.data.inventoryStatus",
                                                                                "severity": "getSeverity(slotProps.data.inventoryStatus)"
                                                                            }
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "div",
                                                    "props": {
                                                        "class": "mb-4 font-medium"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "Text",
                                                            "props": {
                                                                "content": "{{ slotProps.data.name }}"
                                                            }
                                                        }
                                                    ]
                                                },
                                                {
                                                    "type": "div",
                                                    "props": {
                                                        "class": "flex justify-between items-center"
                                                    },
                                                    "children": [
                                                        {
                                                            "type": "div",
                                                            "props": {
                                                                "class": "mt-0 font-semibold text-xl"
                                                            },
                                                            "children": [
                                                                {
                                                                    "type": "Text",
                                                                    "props": {
                                                                        "content": "${{ slotProps.data.price }}"
                                                                    }
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "type": "Span",
                                                            "children": [
                                                                {
                                                                    "type": "Button",
                                                                    "props": {
                                                                        "icon": "pi pi-heart",
                                                                        "severity": "secondary",
                                                                        "outlined": true
                                                                    }
                                                                },
                                                                {
                                                                    "type": "Button",
                                                                    "props": {
                                                                        "icon": "pi pi-shopping-cart",
                                                                        "class": "ml-2"
                                                                    }
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "Column",
                    "props": {
                        "class": "col-span-12"
                    },
                    "children": [
                        {
                            "type": "Text",
                            "props": {
                                "content": "<div class='font-semibold text-xl mb-4'>Image</div>"
                            }
                        },
                        {
                            "type": "Image",
                            "props": {
                                "src": "https://primefaces.org/cdn/primevue/images/galleria/galleria10.jpg",
                                "alt": "Image",
                                "width": "250"
                            }
                        }
                    ]
                },
                {
                    "type": "Column",
                    "props": {
                        "class": "col-span-12"
                    },
                    "children": [
                        {
                            "type": "Text",
                            "props": {
                                "content": "<div class='font-semibold text-xl mb-4'>Galleria</div>"
                            }
                        },
                        {
                            "type": "Galleria",
                            "props": {
                                "value": "images",
                                "responsiveOptions": "galleriaResponsiveOptions",
                                "numVisible": 5,
                                "containerStyle": "max-width: 640px"
                            },
                            "children": [
                                {
                                    "type": "Template",
                                    "props": {
                                        "slot": "item"
                                    },
                                    "children": [
                                        {
                                            "type": "Image",
                                            "props": {
                                                "src": "slotProps.item.itemImageSrc",
                                                "alt": "slotProps.item.alt",
                                                "style": "width: 100%"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "type": "Template",
                                    "props": {
                                        "slot": "thumbnail"
                                    },
                                    "children": [
                                        {
                                            "type": "Image",
                                            "props": {
                                                "src": "slotProps.item.thumbnailImageSrc",
                                                "alt": "slotProps.item.alt"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
