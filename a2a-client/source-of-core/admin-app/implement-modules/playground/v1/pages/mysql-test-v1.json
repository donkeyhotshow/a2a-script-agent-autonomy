{
    "type": "Page",
    "content": {
        "type": "div",
        "props": {
            "class": "p-4 grid grid-cols-1 md:grid-cols-2 gap-4"
        },
        "children": [
            {
                "type": "div",
                "props": {
                    "id": "inputSection",
                    "class": "border rounded p-4 space-y-4"
                },
                "children": [
                    {
                        "type": "H2",
                        "props": {
                            "class": "text-xl font-semibold",
                            "content": "Test: MySQL Operations (Path Format)"
                        }
                    },
                    {
                        "type": "Form",
                        "props": {
                            "class": "space-y-2 border p-2 rounded"
                        },
                        "children": [
                            {
                                "type": "H4",
                                "props": {
                                    "content": "Record Data"
                                }
                            },
                            {
                                "type": "InputText",
                                "props": {
                                    "name": "name",
                                    "label": "Name"
                                },
                                "model": {
                                    "form": "mysqlDataForm",
                                    "field": "name"
                                }
                            },
                            {
                                "type": "InputText",
                                "props": {
                                    "name": "value",
                                    "label": "Value"
                                },
                                "model": {
                                    "form": "mysqlDataForm",
                                    "field": "value"
                                }
                            },
                            {
                                "type": "InputText",
                                "props": {
                                    "name": "category",
                                    "label": "Category"
                                },
                                "model": {
                                    "form": "mysqlDataForm",
                                    "field": "category"
                                }
                            }
                        ]
                    },
                    {
                        "type": "Form",
                        "props": {
                            "class": "space-y-2 border p-2 rounded mt-4"
                        },
                        "children": [
                            {
                                "type": "H4",
                                "props": {
                                    "content": "Parameters for Load/Update/Delete/Where/Count"
                                }
                            },
                            {
                                "type": "InputText",
                                "props": {
                                    "name": "recordId",
                                    "label": "Record ID"
                                },
                                "model": {
                                    "form": "mysqlParamForm",
                                    "field": "recordId"
                                }
                            },
                            {
                                "type": "Select",
                                "props": {
                                    "name": "whereColumn",
                                    "label": "Where Column"
                                },
                                "model": {
                                    "form": "mysqlParamForm",
                                    "field": "whereColumn",
                                    "optionLabel": "label",
                                    "optionValue": "value",
                                    "options": [
                                        {
                                            "label": "ID",
                                            "value": "id"
                                        },
                                        {
                                            "label": "Name",
                                            "value": "name"
                                        },
                                        {
                                            "label": "Email",
                                            "value": "email"
                                        },
                                        {
                                            "label": "Description",
                                            "value": "description"
                                        },
                                        {
                                            "label": "Status",
                                            "value": "status"
                                        },
                                        {
                                            "label": "Type",
                                            "value": "type"
                                        },
                                        {
                                            "label": "Amount",
                                            "value": "amount"
                                        },
                                        {
                                            "label": "Created At",
                                            "value": "created_at"
                                        },
                                        {
                                            "label": "Updated At",
                                            "value": "updated_at"
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "InputText",
                                "props": {
                                    "name": "whereValue",
                                    "label": "Where Value"
                                },
                                "model": {
                                    "form": "mysqlParamForm",
                                    "field": "whereValue"
                                }
                            }
                        ]
                    },
                    {
                        "type": "div",
                        "props": {
                            "class": "flex flex-wrap gap-2 pt-2"
                        },
                        "children": [
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Save New",
                                    "aria-label": "Save new record to MySQL"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "mysql-test-v1/save-new-mysql",
                                                "form": "mysqlDataForm"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Update by ID",
                                    "aria-label": "Update record by ID in MySQL"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "mysql-test-v1/update-mysql-by-id",
                                                "forms": [
                                                    "mysqlDataForm",
                                                    "mysqlParamForm"
                                                ]
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Load by ID",
                                    "aria-label": "Load record by ID from MySQL"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "mysql-test-v1/load-mysql-by-id",
                                                "form": "mysqlParamForm"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Load by Where",
                                    "aria-label": "Load records by where clause from MySQL"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "mysql-test-v1/load-mysql-by-where",
                                                "form": "mysqlParamForm"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Delete by ID",
                                    "severity": "danger",
                                    "aria-label": "Delete record by ID from MySQL"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "mysql-test-v1/delete-mysql-by-id",
                                                "form": "mysqlParamForm"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Count All",
                                    "aria-label": "Count all records in MySQL"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "mysql-test-v1/count-mysql-all"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Count by Where",
                                    "aria-label": "Count records by where clause in MySQL"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "mysql-test-v1/count-mysql-by-where",
                                                "form": "mysqlParamForm"
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "type": "div",
                "props": {
                    "id": "outputSection",
                    "class": "border rounded p-4 space-y-2"
                },
                "children": [
                    {
                        "type": "H3",
                        "props": {
                            "class": "text-lg font-semibold",
                            "content": "Result / Status:"
                        }
                    },
                    {
                        "type": "div",
                        "props": {
                            "id": "mysqlStatus",
                            "class": "p-2 border rounded bg-blue-100 text-blue-800",
                            "content": "Ready..."
                        }
                    },
                    {
                        "type": "div",
                        "props": {
                            "id": "mysqlOutput",
                            "class": "p-3 border rounded bg-gray-100 min-h-[150px] whitespace-pre-wrap",
                            "content": "Output will appear here..."
                        }
                    },
                    {
                        "type": "div",
                        "props": {
                            "id": "statusLog",
                            "class": "p-3 border rounded bg-gray-50 min-h-[80px] mb-4"
                        },
                        "children": []
                    }
                ]
            }
        ]
    }
}
