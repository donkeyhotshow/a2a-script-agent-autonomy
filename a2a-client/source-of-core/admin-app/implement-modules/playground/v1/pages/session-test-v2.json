{
    "type": "Page",
    "content": {
        "type": "div",
        "props": {
            "class": "p-4 grid grid-cols-1 md:grid-cols-2 gap-4"
        },
        "children": [
            {
                "type": "div",
                "props": {
                    "id": "inputSection",
                    "class": "border rounded p-4"
                },
                "children": [
                    {
                        "type": "H2",
                        "props": {
                            "class": "text-xl font-semibold mb-2",
                            "content": "Session Operations Experiment"
                        }
                    },
                    {
                        "type": "Form",
                        "props": {
                            "formId": "sessionOpForm",
                            "class": "space-y-2"
                        },
                        "children": [
                            {
                                "type": "InputText",
                                "props": {
                                    "name": "sessionKey",
                                    "label": "Session Key",
                                    "ariaLabel": "Key for session operations"
                                },
                                "model": {
                                    "form": "sessionOpForm",
                                    "field": "sessionKey"
                                }
                            },
                            {
                                "type": "InputText",
                                "props": {
                                    "name": "sessionValue",
                                    "label": "Session Value",
                                    "ariaLabel": "Value to save to session"
                                },
                                "model": {
                                    "form": "sessionOpForm",
                                    "field": "sessionValue"
                                }
                            }
                        ]
                    },
                    {
                        "type": "div",
                        "props": {
                            "class": "flex flex-wrap gap-2 pt-2"
                        },
                        "children": [
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Set Session",
                                    "ariaLabel": "Save value to session key"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "session-test-v2/session-set",
                                                "form": "sessionOpForm"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Get Session",
                                    "ariaLabel": "Fetch value from session key"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "session-test-v2/session-get",
                                                "form": "sessionOpForm"
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "type": "Button",
                                "props": {
                                    "label": "Remove Session",
                                    "ariaLabel": "Remove session key"
                                },
                                "customHooks": {
                                    "click": [
                                        {
                                            "action": "sendData",
                                            "data": {
                                                "sendTo": "session-test-v2/session-remove",
                                                "form": "sessionOpForm"
                                            }
                                        }
                                    ]
                                }
                            }
                        ]
                    }
                ]
            },
            {
                "type": "div",
                "props": {
                    "id": "outputSection",
                    "class": "border rounded p-4 mt-4"
                },
                "children": [
                    {
                        "type": "H3",
                        "props": {
                            "class": "text-lg font-semibold mb-2",
                            "content": "Result / Status:"
                        }
                    },
                    {
                        "type": "div",
                        "props": {
                            "id": "sessionOpStatus",
                            "class": "p-2 border rounded bg-gray-100 mb-2",
                            "content": "Ready..."
                        }
                    },
                    {
                        "type": "div",
                        "props": {
                            "id": "sessionOpDisplay",
                            "class": "p-2 border rounded bg-gray-50 whitespace-pre-wrap",
                            "content": ""
                        }
                    }
                ]
            }
        ]
    }
}
