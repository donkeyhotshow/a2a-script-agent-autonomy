        },
        {
            "action": "update",
            "from": "input:modelDataForm",
            "to": "model!TestModel/find/{input:recordId}"
        },
        {
            "action": "save",
            "from": "model!TestModel/find/{input:recordId}"
        },
        {
            "action": "update",
            "from": "playground/data/blanks/status-item",
            "to": "buffer:blankItem"
        },
        {
            "action": "update",
