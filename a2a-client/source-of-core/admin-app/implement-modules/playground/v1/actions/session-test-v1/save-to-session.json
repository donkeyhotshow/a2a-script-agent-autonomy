{
    "type": "Instructions",
    "instructions": [
        {
            "action": "update",
            "to": "session!test-save-to-session",
            "from": "input:textToSave"
        },
        {
            "action": "update",
            "from": "data/blanks/status-item",
            "to": "buffer:blankItem"
        },
        {
            "action": "update",
            "to": "buffer:blankItem.props.content",
            "value": "✔ Saved: {input:textToSave}"
        },
        {
            "action": "add",
            "from": "buffer:blankItem",
            "to": "playground/session-test-v1:content.children.1.children.2.children",
            "how": "append"
        },
        {
            "action": "save",
            "from": "playground/session-test-v1"
        },
        {
            "action": "update",
            "to": "output:result.title",
            "value": "✔ Saved to session: {input:textToSave}"
        }
    ]
}
