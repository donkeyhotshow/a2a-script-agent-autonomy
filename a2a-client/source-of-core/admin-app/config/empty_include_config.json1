{
    "comment": "Test config with empty include_directories.",
    "scan_settings": {
        "source_file_extensions": [
            ".ps1",
            ".php"
        ],
        "include_directories": [],
        "exclude_patterns": [
            "vendor/",
            "node_modules/"
        ],
        "max_depth": 10,
        "follow_symlinks": false
    },
    "documentation_mapping": {
        "base_documentation_path": "docs/",
        "mirror_source_directory_structure": true,
        "append_source_base_to_doc_path": true,
        "doc_file_extension": ".md",
        "special_mappings": []
    },
    "output_options": {
        "report_file_path": "reports/empty_include_report.json",
        "log_level": "INFO",
        "default_mode_write_report": false
    }
}
