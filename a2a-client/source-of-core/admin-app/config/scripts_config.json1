                "path": "resources/common/managers/",
                "indexFile": "index/resources/resources.common.managers.index.json",
                "includePatterns": [
                    "*.*"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "resources_frontend",
                "path": "resources/frontend/",
