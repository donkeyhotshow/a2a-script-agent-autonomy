                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            }
        ],
        "groups": {
            "description": "Named groups of scan groups for easier referencing",
            "modules": [
                "modules_docs_implement_config",
                "modules_docs_implement_contact_form",
                "modules_docs_implement_landing_main_page",
                "modules_docs_implement_login_form",
                "modules_docs_implement_page",
                "modules_docs_implement_playground",
                "modules_docs_implement_primary_form",
                "modules_docs_implement_question_to_user",
                "modules_docs_implement_top_bar"
            ],
            "code-php": [
                "code_app_airude_app",
                "code_app_airude_helpers",
                "code_app_airude_managers",
                "code_app_airude_modules_code",
                "code_app_airude_processors",
                "code_app_airude_storage",
                "code_app_console_commands",
                "code_app_helpers",
                "code_app_hooks",
                "code_app_http_controllers",
                "code_app_http_middleware",
                "code_app_models"
            ],
            "question-to-user": [
                "script_engine",
                "script_docs",
                "modules_docs_implement_question_to_user"
            ]
        }
    },
    "mirrorsDocsScan": {
        "description": "Configuration for the fix-mirrors-docs.ps1 script.",
        "sourceDirs": [
            "app",
            "resources",
            "routes",
            "tests"
        ],
        "docsMirrorsDir": "docs-mirrors"
    },
    "main": {
        "description": "Settings for main.ps1"
    },
    "modules": {
        "description": "List of module scripts to be invoked by main.ps1 without parameters",
        "scripts": [
            "fix/fix-indexer.ps1",
            "fix/fix-mirrors-docs.ps1",
            "fix/file-cleanup.ps1",
            "fix/find-broken-links.ps1",
            "fix/invoke-periodic-action.ps1"
        ]
    },
    "periodicActions": {
        "description": "Configuration for actions triggered periodically based on run counts.",
        "stateFilePath": "script/config/periodic_action_state.json",
        "actions": [
            {
                "id": "blinking_message_lessons",
                "frequency": 21,
                "type": "message",
                "message": "Remember to consult @lessons-learned.json for insights!",
                "color": "Yellow"
            },
            {
                "id": "blinking_message_requirements",
                "frequency": 20,
                "type": "message",
                "message": "Have you checked /docs/ROOT.md recently?",
                "color": "Cyan"
            },
            {
                "id": "auto_commit",
                "frequency": 20,
                "type": "command",
                "command": "git add -A; git commit -m 'Periodic auto-commit based on run count'",
                "workingDirectory": "../../"
            },
            {
                "id": "remove_bom_periodically",
                "frequency": 30,
                "type": "command",
                "command": "pwsh -File script/fix/remove-bom.ps1",
                "workingDirectory": "../../"
            },
            {
                "id": "optimize_all",
                "frequency": 31,
                "type": "command",
                "command": "pwsh -File script/fix/optimize_all.ps1",
                "workingDirectory": "../../"
            }
        ]
    },
    "tasks": {
        "description": "Settings related to task definition and processing"
    },
    "testing": {
        "description": "Settings for tests/run.ps1"
    },
    "brokenLinksScan": {
        "description": "Configuration for the find-broken-links.ps1 script.",
        "directories": [
            "docs/"
        ],
        "reportFile": "reports/broken_links_report.json",
        "maxConsoleIssues": 10
    },
    "activeScripts": [
        "fix/fix-indexer.ps1"
    ],
    "scriptSettings": {
        "fix/fix-indexer.ps1": {
            "autoTrigger": "onFileChange",
            "watchedPaths": [
                "app/",
                "docs/",
                "docs/",
                "resources/",
                "tests/"
            ]
        }
    }
}

