                ]
            },
            {
                "name": "tests_feature_controllers",
                "path": "tests/Feature/Controllers/",
                "indexFile": "index/tests/tests.Feature.Controllers.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "tests_feature_airude_depot",
                "path": "tests/Feature/AiRudeDepot/",
                "indexFile": "index/tests/tests.Feature.AiRudeDepot.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
