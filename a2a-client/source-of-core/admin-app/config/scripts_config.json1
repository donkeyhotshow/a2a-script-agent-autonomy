                    "*.json"
                ],
                "excludePatterns": [
                    ".aide/"
                ]
            },
            {
                "name": "modules_docs_implement_landing_main_page",
                "path": "implement-modules/landing-main-page/",
                "indexFile": "index/modules/docs.implement.landing-main-page.index.json",
                "description": "Implementation documentation for the Landing Main Page module.",
                "includePatterns": [
                    "*.md",
                    "*.json"
                ],
                "excludePatterns": [
