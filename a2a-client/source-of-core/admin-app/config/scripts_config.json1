                "description": "Implementation documentation for the Login Form module.",
                "includePatterns": [
                    "*.md",
                    "*.json"
                ],
                "excludePatterns": [
                    ".aide/"
                ]
            },
            {
                "name": "modules_docs_implement_page",
                "path": "implement-modules/page/",
                "indexFile": "index/modules/docs.implement.page.index.json",
                "description": "Implementation documentation for the Page module.",
                "includePatterns": [
                    "*.md",
                    "*.json"
                ],
                "excludePatterns": [
                    ".aide/"
                ]
            },
            {
                "name": "modules_docs_implement_playground",
                "path": "implement-modules/playground/",
                "indexFile": "index/modules/docs.implement.playground.index.json",
                "description": "Implementation documentation for the Playground module.",
                "includePatterns": [
                    "*.md",
                    "*.json"
                ],
                "excludePatterns": [
                    ".aide/"
                ]
            },
            {
                "name": "modules_docs_implement_question_to_user",
                "path": "implement-modules/question-to-user/",
                "indexFile": "index/modules/docs.implement.question-to-user.index.json",
                "description": "Implementation documentation for the Question to User module.",
                "includePatterns": [
                    "*.md",
                    "*.json"
                ],
                "excludePatterns": [
                    ".aide/"
                ]
            },
            {
                "name": "modules_docs_implement_top_bar",
                "path": "implement-modules/top-bar/",
                "indexFile": "index/modules/docs.implement.top-bar.index.json",
                "description": "Implementation documentation for the Top Bar module.",
                "includePatterns": [
                    "*.md",
                    "*.json"
                ],
                "excludePatterns": [
                    ".aide/"
                ]
            },
            {
                "name": "resources_backend_js",
                "path": "resources/backend/js/",
                "indexFile": "index/resources/resources.backend.js.index.json",
                "includePatterns": [
                    "*.js"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "resources_common_js",
                "path": "resources/common/js/",
                "indexFile": "index/resources/resources.common.js.index.json",
                "includePatterns": [
