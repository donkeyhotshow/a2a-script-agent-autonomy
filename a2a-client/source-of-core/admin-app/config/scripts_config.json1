{
    "description": "Central configuration settings for PowerShell scripts in the ./script directory",
    "indexingWorkflow": {
        "description": "State and configuration for the stateful indexing process (fix-indexer.ps1)",
        "indexBaseDir": "index/",
        "scanGroups": [
            {
                "name": "script_docs",
                "path": "script/docs/",
                "indexFile": "index/script/docs.index.json",
                "description": "Documentation for project scripts and standards.",
                "includePatterns": [
                    "*.md"
                ],
                "excludePatterns": [
                    ".aide/"
                ]
            },
            {
                "name": "script_engine",
                "path": "script/engine/",
                "indexFile": "index/script/engine.index.json",
                "description": "Core scripting engine files (PowerShell and PHP).",
                "includePatterns": [
                    "*.ps1",
                    "*.php"
                ],
                "excludePatterns": [
                    "**/tests/"
                ]
            },
            {
                "name": "script_helpers",
                "path": "script/helpers/",
                "indexFile": "index/script/helpers.index.json",
                "description": "Helper scripts and utility functions.",
                "includePatterns": [
                    "*.ps1",
                    "*.php"
                ]
            },
            {
                "name": "code_app_airude_app",
                "path": "app/AiRudeDepot/App/",
                "indexFile": "index/code/app.AiRudeDepot.App.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": []
            },
            {
                "name": "code_app_airude_helpers",
                "path": "app/AiRudeDepot/Helpers/",
                "indexFile": "index/code/app.AiRudeDepot.Helpers.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": []
            },
            {
                "name": "code_app_airude_managers",
                "path": "app/AiRudeDepot/Managers/",
                "indexFile": "index/code/app.AiRudeDepot.Managers.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "code_app_airude_modules_code",
                "path": "app/AiRudeDepot/Modules/",
                "indexFile": "index/code/app.AiRudeDepot.Modules.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "code_app_airude_processors",
                "path": "app/AiRudeDepot/Processors/",
                "indexFile": "index/code/app.AiRudeDepot.Processors.index.json",
                "includePatterns": [
                    "*.php",
                    "*.json"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "code_app_airude_storage",
                "path": "app/AiRudeDepot/Storage/",
                "indexFile": "index/code/app.AiRudeDepot.Storage.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "code_app_console_commands",
                "path": "app/Console/Commands/",
                "indexFile": "index/code/app.Console.Commands.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "code_app_helpers",
                "path": "app/Helpers/",
                "indexFile": "index/code/app.Helpers.index.json",
                "description": "Application-level PHP helper classes.",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    "**/Traits/",
                    "**/Utils/Old/"
                ]
            },
            {
                "name": "code_app_hooks",
                "path": "app/Hooks/",
                "indexFile": "index/code/app.Hooks.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "code_app_http_controllers",
                "path": "app/Http/Controllers/",
                "indexFile": "index/code/app.Http.Controllers.index.json",
                "description": "HTTP Controllers (Backend, Common, Frontend).",
                "includePatterns": [
                    "*.php"
                ]
            },
            {
                "name": "code_app_http_middleware",
                "path": "app/Http/Middleware/",
                "indexFile": "index/code/app.Http.Middleware.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "code_app_models",
                "path": "app/Models/",
                "indexFile": "index/code/app.Models.index.json",
                "includePatterns": [
                    "*.php"
                ],
                "excludePatterns": [
                    ".aide/",
                    ".git/",
                    ".vscode/",
                    "vendor/",
                    "node_modules/"
                ]
            },
            {
                "name": "modules_docs_implement_config",
                "path": "implement-modules/config/",
                "indexFile": "index/modules/docs.implement.config.index.json",
                "description": "Implementation documentation for the Config module.",
                "includePatterns": [
