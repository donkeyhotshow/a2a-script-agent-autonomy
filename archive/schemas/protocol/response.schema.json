{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://a2a-protocol.org/schemas/response.schema.json",
  "title": "A2A Response",
  "description": "Response object for A2A protocol communication",
  "type": "object",
  "required": ["context"],
  "properties": {
    "context": {
      "$ref": "context.schema.json"
    },
    "actions": {
      "type": "array",
      "description": "List of available primary actions (hardcoded steps)",
      "items": {
        "$ref": "#/definitions/Action"
      }
    },
    "aiActions": {
      "type": "array",
      "description": "List of available AI actions (LLM-controlled steps)",
      "items": {
        "$ref": "#/definitions/Action"
      }
    },
    "fallbackActions": {
      "type": "array",
      "description": "Fallback action options",
      "items": {
        "$ref": "#/definitions/FallbackAction"
      }
    },
    "execute": {
      "type": "object",
      "description": "Action to execute on client (action-key shape)",
      "oneOf": [
        {
          "$ref": "action.schema.json#/definitions/FormExecute"
        },
        {
          "$ref": "action.schema.json#/definitions/ScriptExecute"
        },
        {
          "$ref": "action.schema.json#/definitions/ReadFileExecute"
        },
        {
          "$ref": "action.schema.json#/definitions/WriteFileExecute"
        },
        {
          "$ref": "action.schema.json#/definitions/RagSearchExecute"
        },
        {
          "$ref": "action.schema.json#/definitions/ExecuteCommandExecute"
        },
        {
          "$ref": "action.schema.json#/definitions/MessageExecute"
        }
      ]
    },
    "result": {
      "type": "object",
      "description": "Final result (only for final step)",
      "additionalProperties": true
    },
    "assistantMessage": {
      "$ref": "message.schema.json",
      "description": "Assistant message to display"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Action": {
      "type": "object",
      "required": ["action", "title", "description"],
      "properties": {
        "action": {
          "type": "string",
          "description": "Action identifier"
        },
        "title": {
          "type": "string",
          "description": "Action display title"
        },
        "description": {
          "type": "string",
          "description": "Action description"
        },
        "priority": {
          "type": "number",
          "description": "Action priority (higher = more important)"
        },
        "matchScore": {
          "type": "number",
          "description": "Match score for relevance ranking"
        },
        "steps": {
          "type": "array",
          "description": "List of steps for this action",
          "items": {
            "$ref": "#/definitions/Step"
          }
        },
        "repeatSteps": {
          "type": "array",
          "description": "Steps that can be repeated",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Step": {
      "type": "object",
      "required": ["action", "title", "description"],
      "properties": {
        "action": {
          "type": "string",
          "description": "Step action identifier"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "number"
        },
        "input": {
          "type": "object",
          "description": "Expected input shape"
        },
        "output": {
          "type": "object",
          "description": "Expected output shape"
        }
      },
      "additionalProperties": false
    },
    "FallbackAction": {
      "type": "object",
      "required": ["mode", "title", "description"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto-ai", "task-decomposition"],
          "description": "Fallback mode"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fallbackType": {
          "type": "string",
          "enum": ["llm_generation", "manual"],
          "description": "Type of fallback"
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "context": {
        "task": "виправити імпорти у vue компонентах"
      },
      "execute": {
        "form": {
          "title": "Оберіть спосіб виконання",
          "choices": [
            {
              "id": "fix-vue-imports",
              "label": "Виправити зламані імпорти у Vue файлах (автомат)"
            },
            {
              "id": "auto-ai",
              "label": "AI Action Generator — згенерувати екшен за допомогою LLM"
            }
          ]
        }
      }
    },
    {
      "context": {
        "task": "виправити імпорти у vue компонентах",
        "execution": {
          "action": "fix-vue-imports",
          "step": "vue-import-resolve"
        }
      },
      "execute": {
        "script": {
          "input": {
            "broken_imports": []
          },
          "output": "patches[]",
          "code": "// script code here"
        }
      }
    }
  ]
}
