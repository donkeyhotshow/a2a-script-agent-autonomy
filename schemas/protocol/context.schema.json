{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://a2a-protocol.org/schemas/context.schema.json",
  "title": "A2A Context",
  "description": "Context object for maintaining state across A2A protocol requests/responses",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "description": "Original task description"
    },
    "execution": {
      "type": "object",
      "description": "Current execution state - managed by system",
      "properties": {
        "action": {
          "type": "string",
          "description": "Current action identifier"
        },
        "step": {
          "type": "string",
          "description": "Current step within the action"
        },
        "progress": {
          "type": "object",
          "description": "Optional progress information",
          "properties": {
            "current": {
              "type": "number",
              "description": "Current progress value"
            },
            "total": {
              "type": "number",
              "description": "Total progress value"
            },
            "message": {
              "type": "string",
              "description": "Progress message"
            }
          }
        }
      },
      "required": ["action", "step"],
      "additionalProperties": true
    },
    "history": {
      "type": "array",
      "description": "Execution history - managed by system",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "workbench": {
      "type": "object",
      "description": "Structured working state: sections (named text), optional batch (items/cursor/label), optional slots (named JSON).",
      "additionalProperties": true,
      "properties": {
        "sections": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Named draft chunks (e.g. task spec sections)."
        },
        "batch": {
          "type": "object",
          "description": "Sequential processing cursor + queue",
          "additionalProperties": true
        },
        "slots": {
          "type": "object",
          "description": "Named payloads (patches, summaries, arbitrary JSON)",
          "additionalProperties": true
        }
      }
    },
    "vite_config": {
      "type": "object",
      "description": "Vite configuration (optional)",
      "additionalProperties": true
    },
    "aliases": {
      "type": "object",
      "description": "Path aliases configuration (optional)",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "examples": [
    {
      "task": "виправити імпорти у vue компонентах",
      "execution": {
        "action": "fix-vue-imports",
        "step": "vue-import-detect"
      },
      "history": [],
      "workbench": { "sections": {} }
    },
    {
      "task": "виправити імпорти у vue компонентах",
      "execution": {
        "action": "fix-vue-imports",
        "step": "vue-import-resolve",
        "progress": {
          "current": 2,
          "total": 5,
          "message": "Processing imports..."
        }
      },
      "history": [
        {
          "action": "fix-vue-imports",
          "step": "vue-import-detect",
          "timestamp": "2026-03-03T10:00:00Z"
        }
      ]
    }
  ]
}
