{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://a2a-protocol.org/schema/protocol.json",
  "title": "A2A Protocol Schema",
  "description": "JSON Schema for A2A (Agent-to-Agent) Protocol messages",
  "definitions": {
    "ActionKeyShape": {
      "type": "object",
      "description": "Action-key shape wrapper for execute/result objects",
      "patternProperties": {
        "^(script|read-file|write-file|rag-search|execute-command|form|message|choice)$": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ExecutionContext": {
      "type": "object",
      "description": "Current execution state",
      "properties": {
        "action": { "type": "string" },
        "step": { "type": "string" },
        "progress": {
          "type": "object",
          "properties": {
            "current": { "type": "number" },
            "total": { "type": "number" }
          }
        }
      },
      "required": ["action"]
    },
    "FormChoice": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "variant": {
          "type": "string",
          "enum": ["primary", "secondary", "danger", "success"]
        }
      },
      "required": ["id", "label"]
    },
    "FormInput": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["text", "textarea", "select", "checkbox", "radio", "number"]
        },
        "label": { "type": "string" },
        "placeholder": { "type": "string" },
        "required": { "type": "boolean" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        }
      },
      "required": ["name", "type", "label"]
    },
    "Request": {
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "sessionId": { "type": "string" },
        "action": { "type": "string" },
        "context": {
          "type": "object",
          "properties": {
            "history": {
              "type": "array",
              "items": { "$ref": "#/definitions/HistoryEntry" }
            },
            "execution": { "$ref": "#/definitions/ExecutionContext" },
            "docVirtual": { "type": "string" }
          }
        },
        "result": { "$ref": "#/definitions/ActionKeyShape" }
      },
      "required": ["requestId", "sessionId", "action"]
    },
    "HistoryEntry": {
      "type": "object",
      "properties": {
        "step": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "result": { "type": "object" }
      },
      "required": ["step", "action", "timestamp"]
    },
    "Response": {
      "type": "object",
      "properties": {
        "requestId": { "type": "string" },
        "sessionId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["processing", "completed", "error", "waiting"]
        },
        "execute": { "$ref": "#/definitions/ActionKeyShape" },
        "context": {
          "type": "object",
          "properties": {
            "execution": { "$ref": "#/definitions/ExecutionContext" }
          }
        },
        "message": { "type": "string" }
      },
      "required": ["requestId", "sessionId", "status"]
    },
    "ExecuteScript": {
      "type": "object",
      "properties": {
        "script": {
          "type": "object",
          "properties": {
            "input": { "type": "object" },
            "output": { "type": "string" },
            "code": { "type": "string" }
          },
          "required": ["code"]
        }
      },
      "required": ["script"]
    },
    "ExecuteReadFile": {
      "type": "object",
      "properties": {
        "read-file": {
          "type": "object",
          "properties": {
            "path": { "type": "string" }
          },
          "required": ["path"]
        }
      },
      "required": ["read-file"]
    },
    "ExecuteWriteFile": {
      "type": "object",
      "properties": {
        "write-file": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["path", "content"]
        }
      },
      "required": ["write-file"]
    },
    "ExecuteRagSearch": {
      "type": "object",
      "properties": {
        "rag-search": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "filters": { "type": "object" }
          },
          "required": ["query"]
        }
      },
      "required": ["rag-search"]
    },
    "ExecuteCommand": {
      "type": "object",
      "properties": {
        "execute-command": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "cwd": { "type": "string" },
            "timeout": { "type": "number" }
          },
          "required": ["command"]
        }
      },
      "required": ["execute-command"]
    },
    "ExecuteForm": {
      "type": "object",
      "properties": {
        "form": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "choices": {
              "type": "array",
              "items": { "$ref": "#/definitions/FormChoice" }
            },
            "input": {
              "type": "array",
              "items": { "$ref": "#/definitions/FormInput" }
            }
          }
        }
      },
      "required": ["form"]
    },
    "ExecuteMessage": {
      "type": "object",
      "properties": {
        "message": { "type": "string" }
      },
      "required": ["message"]
    },
    "ResultScript": {
      "type": "object",
      "properties": {
        "script": {
          "type": "object",
          "properties": {
            "output": { "type": "string" },
            "broken_imports": { "type": "array" },
            "data": { "type": "object" }
          }
        }
      },
      "required": ["script"]
    },
    "ResultReadFile": {
      "type": "object",
      "properties": {
        "read-file": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["path", "content"]
        }
      },
      "required": ["read-file"]
    },
    "ResultWriteFile": {
      "type": "object",
      "properties": {
        "write-file": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "success": { "type": "boolean" }
          },
          "required": ["path", "success"]
        }
      },
      "required": ["write-file"]
    },
    "ResultRagSearch": {
      "type": "object",
      "properties": {
        "rag-search": {
          "type": "object",
          "properties": {
            "results": { "type": "array" },
            "files": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["results"]
        }
      },
      "required": ["rag-search"]
    },
    "ResultExecuteCommand": {
      "type": "object",
      "properties": {
        "execute-command": {
          "type": "object",
          "properties": {
            "command": { "type": "string" },
            "exitCode": { "type": "number" },
            "stdout": { "type": "string" },
            "stderr": { "type": "string" }
          },
          "required": ["command", "exitCode"]
        }
      },
      "required": ["execute-command"]
    },
    "ResultChoice": {
      "type": "object",
      "properties": {
        "choice": { "type": "string" }
      },
      "required": ["choice"]
    },
    "ResultMessage": {
      "type": "object",
      "properties": {
        "message": { "type": "string" }
      },
      "required": ["message"]
    }
  },
  "type": "object",
  "oneOf": [
    { "$ref": "#/definitions/Request" },
    { "$ref": "#/definitions/Response" }
  ]
}