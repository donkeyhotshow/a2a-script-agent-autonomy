{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "agent",
        "step": "request"
      }
    },
    {
      "op": "set",
      "path": "$.context.workbench",
      "value": {}
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "form": {
          "title": "Ваш запит",
          "description": "Монорепо a2a-script-agent. Далі — повний ланцюжок інструментів agent (як у agent-coder-smart + workspace tools).",
          "input": [
            {
              "name": "message",
              "type": "text",
              "label": "Повідомлення",
              "required": true
            }
          ]
        }
      }
    }
  ]
}
