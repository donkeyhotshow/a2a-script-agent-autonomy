{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$out.context.execution",
      "value": {
        "action": "agent",
        "step": "request"
      }
    },
    {
      "op": "set",
      "path": "$out.execute",
      "value": {
        "form": {
          "input": [
            {
              "name": "message",
              "type": "text",
              "label": "Повідомлення",
              "required": true
            }
          ]
        }
      }
    }
  ]
}
