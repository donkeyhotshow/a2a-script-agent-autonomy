{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "fix-vue-imports",
        "step": "vue-import-detect"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "script": {
          "input": {
            "rootDir": "."
          },
          "output": "broken_imports[]",
          "code": "return { broken_imports: [{ file: 'app/Example.vue', line: 2, specifier: './Missing' }] };"
        }
      }
    }
  ]
}
