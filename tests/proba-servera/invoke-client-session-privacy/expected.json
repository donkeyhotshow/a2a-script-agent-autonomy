{
  "$proba": {
    "ignorePaths": [
      "context.task",
      "context.result",
      "context.message",
      "context.execution.routerAnalysis",
      "execute.form.choices"
    ],
    "inputAbsentPaths": ["context.history"],
    "actualMustNotContainSubstrings": ["sess_PROBA_PRIVACY_LEAK_TOKEN_xyz"]
  },
  "context": {
    "execution": {
      "action": "task",
      "step": "router"
    },
    "session_id": {
      "$regex": "^srv_sess_"
    }
  },
  "execute": {
    "form": {
      "title": "string"
    }
  }
}
