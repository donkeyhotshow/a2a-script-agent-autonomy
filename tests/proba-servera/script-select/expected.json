{
  "$proba": {
    "ignorePaths": [
      "context.session_id",
      "context.result",
      "context.choice_id",
      "context.message"
    ],
    "skipHistoryLengthCheck": true
  },
  "context": {
    "task": "string",
    "execution": {
      "action": "string",
      "step": "string"
    },
    "history": [
      {
        "role": "user",
        "message": "string"
      },
      {
        "role": "system",
        "message": {
          "$regex": "^choice:"
        }
      }
    ]
  },
  "execute": {
    "form": {
      "title": "string",
      "description": "string",
      "input": [
        {
          "name": "string",
          "type": "string",
          "label": "string",
          "required": true
        }
      ]
    }
  }
}
