      { "role": "string", "message": "string" },
      { "role": "string", "message": "string" },
      { "role": "string", "message": "string" },
      { "role": "string", "message": "string" },
      { "role": "string", "message": "string" },
      { "role": "string", "message": "string" }
    ]
  },
  "execute": {
    "write-file": {
      "path": "utils/helpers.js",
      "content": "function calculateTotal(items) {\n  return items.reduce((sum, item) => sum + item.price, 0);\n}\n\nmodule.exports = { calculateTotal };"
    }
  }
