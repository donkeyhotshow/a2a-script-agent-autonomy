{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "agent",
        "step": "execute-item"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "form": {
          "input": [
            {
              "name": "message",
              "type": "text",
              "label": "Контент документу (.carrier/tasks/task-1.md)",
              "required": true
            }
          ]
        }
      }
    }
  ]
}
