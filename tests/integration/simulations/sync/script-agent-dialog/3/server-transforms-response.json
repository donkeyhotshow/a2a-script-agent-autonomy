{
  "type": "pipeline",
  "steps": [
    {
      "op": "parse-json-from-md",
      "fromFile": "response.md",
      "jsonPath": "$",
      "to": "$llm"
    },
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "append-to-array",
      "to": "$.context.history",
      "value": {
        "role": "assistant",
        "message": "$.llm.message"
      }
    },
    {
      "op": "set",
      "path": "$.context.workbench",
      "value": {
        "sections": {
          "autoScriptTrigger": {
            "scriptId": "fix-vue-imports",
            "triggeredBy": "assistant",
            "errorMessage": "Cannot find module @/components/Missing referenced from Example.vue",
            "file": "resources/js/components/Example.vue",
            "autoRun": true
          }
        }
      }
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "dialog",
        "step": "auto_script_gate"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "run-script": {
          "scriptId": "fix-vue-imports",
          "params": {
            "scope": "resources/js/components/Example.vue",
            "reason": "assistant reported import error"
          }
        }
      }
    }
  ]
}
