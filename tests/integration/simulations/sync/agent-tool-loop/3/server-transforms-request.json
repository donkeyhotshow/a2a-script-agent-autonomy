{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$out.context.execution.step",
      "value": "tool_list_directory"
    },
    {
      "op": "set",
      "path": "$out.execute",
      "value": {
        "list-directory": {
          "path": "."
        }
      }
    },
    {
      "op": "set",
      "path": "$out.context.history[+]",
      "value": {
        "role": "assistant",
        "step": "tool_list_directory",
        "message": "list-directory: ."
      }
    }
  ]
}