{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "fix-vue-imports",
        "step": "audit_merge"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "script": {
          "input": {
            "lintStdout": "lint ok"
          },
          "output": "auditSummary",
          "code": "return { auditSummary: { patches: 1, lint: 'pass' } };"
        }
      }
    }
  ]
}
