{
  "$proba": {
    "ignorePaths": [
      "context.task",
      "context.session_id",
      "context.repo_map",
      "context.requestPhase",
      "context.llmPromiseId",
      "context.result",
      "context.transformSchema",
      "context.message",
      "context.choice_id",
      "context.workbench.slots"
    ],
    "skipHistoryLengthCheck": true,
    "snapExecuteToActual": true,
    "ignoreExecuteWhenOutcomeFailed": true
  },
  "context": {
    "execution": {
      "action": "agent",
      "step": "tool_rag"
    },
    "workbench": {
      "sections": {}
    },
    "history": [
      {
        "role": "string",
        "message": "string"
      }
    ]
  },
  "execute": {
    "rag-search": {
      "query": "simulations sync agent SCHEMA received.json",
      "limit": 8
    }
  }
}
