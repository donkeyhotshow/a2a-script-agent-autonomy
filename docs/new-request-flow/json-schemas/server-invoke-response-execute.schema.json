{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://a2a-script-agent/new-request-flow/json-schemas/server-invoke-response-execute.schema.json",
  "title": "Server Invoke Response - Execute Step",
  "description": "Generic execute response for POST /api/v1/invoke: context + execute{...} (+ optional finalResult / top-level result for final step).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "object",
      "description": "Execution context echoed back to client. System-managed, free-form.",
      "required": ["task"],
      "properties": {
        "task": { "type": "string" },
        "execution": {
          "type": "object",
          "description": "Current server-side execution state.",
          "required": ["action", "step"],
          "properties": {
            "action": { "type": "string" },
            "step": { "type": "string" },
            "status": {
              "type": "string",
              "enum": ["completed"],
              "description": "Present and equal to 'completed' on final step."
            }
          },
          "additionalProperties": true
        },
        "history": {
          "type": "array",
          "description": "Execution history for AI-Actions.",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "description": "user | assistant | system (other values allowed for captured fixtures)" },
              "message": { "type": "string" },
              "action": { "type": "string" },
              "params": { "type": "object" }
            },
            "required": ["role"],
            "additionalProperties": true
          }
        },
        "docVirtual": {
          "type": "object",
          "description": "Virtual document state for accumulating content across steps."
        }
      },
      "additionalProperties": true
    },
    "execute": {
      "type": "object",
      "description": "Command(s) for client or web UI. Each key is an action type (form, script, read-file, write-file, rag-search, execute-command, list-directory, grep-search, message, etc.).",
      "minProperties": 1,
      "additionalProperties": true,
      "properties": {
        "form": {
          "type": "object",
          "description": "Form to be rendered in Web UI (input fields and/or choices).",
          "additionalProperties": true,
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string", "description": "Optional subtitle / help for the whole form (SDK + Web)." },
            "choices": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label"],
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "description": { "type": "string", "description": "Per-choice help text for router / forms." }
                },
                "additionalProperties": true
              }
            },
            "input": {
              "type": "array",
              "description": "Input fields for the form.",
              "items": {
                "type": "object",
                "required": ["name", "type"],
                "properties": {
                  "name": { "type": "string" },
                  "type": {
                    "type": "string",
                    "description": "Common: text, textarea, select, checkbox, number; also submit/button/etc. in fixtures."
                  },
                  "label": { "type": "string" },
                  "placeholder": { "type": "string" },
                  "required": { "type": "boolean" },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "value": { "type": "string" },
                        "label": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "message": {
          "description": "Text message to display in Web UI (string or object).",
          "oneOf": [
            { "type": "string" },
            { "type": "object", "additionalProperties": true }
          ]
        },
        "script": {
          "type": "object",
          "description": "DSL script to run on client (Actions).",
          "required": ["input", "output", "code"],
          "properties": {
            "input": { "type": "object", "additionalProperties": true },
            "output": { "type": "string" },
            "code": { "type": "string" }
          },
          "additionalProperties": true
        },
        "read-file": {
          "type": "object",
          "description": "Request to read a file.",
          "properties": {
            "path": { "type": "string" }
          },
          "required": ["path"],
          "additionalProperties": true
        },
        "write-file": {
          "type": "object",
          "description": "Request to write a file.",
          "properties": {
            "path": { "type": "string" },
            "content": { "type": "string" }
          },
          "required": ["path", "content"],
          "additionalProperties": true
        },
        "rag-search": {
          "type": "object",
          "description": "Request to perform RAG (Retrieval-Augmented Generation) search.",
          "properties": {
            "query": { "type": "string" }
          },
          "required": ["query"],
          "additionalProperties": true
        },
        "execute-command": {
          "type": "object",
          "description": "Request to execute shell command.",
          "properties": {
            "command": { "type": "string" }
          },
          "required": ["command"],
          "additionalProperties": true
        },
        "list-directory": {
          "type": "object",
          "description": "Request to list directory contents.",
          "properties": {
            "path": { "type": "string" }
          },
          "required": ["path"],
          "additionalProperties": true
        },
        "grep-search": {
          "type": "object",
          "description": "Request to search for patterns in files.",
          "properties": {
            "pattern": { "type": "string" },
            "path": { "type": "string" },
            "glob": { "type": "string" }
          },
          "required": ["pattern"],
          "additionalProperties": true
        }
      }
    },
    "finalResult": {
      "type": "object",
      "description": "Optional summary object for algorithmic Actions (e.g. fix-vue-imports) on the final step.",
      "required": ["action", "summary"],
      "properties": {
        "action": { "type": "string" },
        "summary": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "description": "Optional top-level result for final AI-Actions step (per simulations/SCHEMA.md).",
      "additionalProperties": true
    }
  },
  "required": ["context", "execute"]
}
