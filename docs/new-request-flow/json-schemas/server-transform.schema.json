{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://a2a-script-agent/new-request-flow/json-schemas/server-transform.schema.json",
  "title": "Server Transform Pipeline",
  "description": "JSONPath transform DSL for sim step pipelines (request.md / response.json). See a2a-server/src/transform/types.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "steps"],
  "properties": {
    "type": { "type": "string", "enum": ["pipeline"] },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/transformStep" }
    }
  },
  "definitions": {
    "jp": { "type": "string" },
    "transformStep": {
      "oneOf": [
        { "$ref": "#/definitions/opAppendToArray" },
        { "$ref": "#/definitions/opApplyScratchpadOps" },
        { "$ref": "#/definitions/opApplyWorkbenchSectionOps" },
        { "$ref": "#/definitions/opCopy" },
        { "$ref": "#/definitions/opDrop" },
        { "$ref": "#/definitions/opForEach" },
        { "$ref": "#/definitions/opIncludeIf" },
        { "$ref": "#/definitions/opMergeFilesToContext" },
        { "$ref": "#/definitions/opMergeWorkbenchSections" },
        { "$ref": "#/definitions/opMergeWorkbenchSlots" },
        { "$ref": "#/definitions/opParseJsonFromMd" },
        { "$ref": "#/definitions/opPickContext" },
        { "$ref": "#/definitions/opPickFiles" },
        { "$ref": "#/definitions/opRenderMarkdown" },
        { "$ref": "#/definitions/opSet" },
        { "$ref": "#/definitions/opSummarizeFiles" },
        { "$ref": "#/definitions/opSwitch" },
        { "$ref": "#/definitions/opTruncateHistory" },
        { "$ref": "#/definitions/opTruncateSection" }
      ]
    },
    "opAppendToArray": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "to", "value"],
      "properties": {
        "op": { "const": "append-to-array" },
        "to": { "$ref": "#/definitions/jp" },
        "value": { "type": "object", "additionalProperties": true }
      }
    },
    "opApplyScratchpadOps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from"],
      "properties": {
        "op": { "const": "apply-scratchpad-ops" },
        "from": { "$ref": "#/definitions/jp" },
        "scratchpadPath": { "$ref": "#/definitions/jp" }
      }
    },
    "opApplyWorkbenchSectionOps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from"],
      "properties": {
        "op": { "const": "apply-workbench-section-ops" },
        "from": { "$ref": "#/definitions/jp" },
        "sectionsPath": { "$ref": "#/definitions/jp" }
      }
    },
    "opCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from", "to"],
      "properties": {
        "op": { "const": "copy" },
        "from": { "$ref": "#/definitions/jp" },
        "to": { "$ref": "#/definitions/jp" }
      }
    },
    "opDrop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": { "const": "drop" },
        "path": { "$ref": "#/definitions/jp" }
      }
    },
    "opForEach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "arrayPath", "as", "steps"],
      "properties": {
        "op": { "const": "for-each" },
        "arrayPath": { "$ref": "#/definitions/jp" },
        "as": { "type": "string" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/transformStep" }
        }
      }
    },
    "opIncludeIf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "condition"],
      "properties": {
        "op": { "const": "include-if" },
        "path": { "$ref": "#/definitions/jp" },
        "condition": { "$ref": "#/definitions/jp" }
      }
    },
    "opMergeFilesToContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "const": "merge-files-to-context" },
        "from": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "opMergeWorkbenchSections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from", "to"],
      "properties": {
        "op": { "const": "merge-workbench-sections" },
        "from": { "$ref": "#/definitions/jp" },
        "to": { "$ref": "#/definitions/jp" }
      }
    },
    "opMergeWorkbenchSlots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "from"],
      "properties": {
        "op": { "const": "merge-workbench-slots" },
        "from": { "$ref": "#/definitions/jp" },
        "to": { "$ref": "#/definitions/jp" },
        "skipKeys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "opParseJsonFromMd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "fromFile", "to"],
      "properties": {
        "op": { "const": "parse-json-from-md" },
        "fromFile": { "type": "string" },
        "jsonPath": { "$ref": "#/definitions/jp" },
        "to": { "$ref": "#/definitions/jp" }
      }
    },
    "opPickContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "include"],
      "properties": {
        "op": { "const": "pick-context" },
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "opPickFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "paths"],
      "properties": {
        "op": { "const": "pick-files" },
        "paths": {
          "oneOf": [
            { "type": "array", "items": { "type": "string" } },
            { "const": "$result" }
          ]
        }
      }
    },
    "opRenderMarkdown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "templateRef", "data", "outputFile"],
      "properties": {
        "op": { "const": "render-markdown" },
        "templateRef": { "type": "string" },
        "data": { "$ref": "#/definitions/jp" },
        "outputFile": { "type": "string" },
        "maxChars": { "type": "number", "minimum": 1 },
        "truncateSuffix": { "type": "string" }
      }
    },
    "opSet": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path"],
          "properties": {
            "op": { "const": "set" },
            "path": { "$ref": "#/definitions/jp" },
            "value": {
              "type": ["object", "null", "string", "number", "boolean", "array"]
            },
            "valueFrom": { "$ref": "#/definitions/jp" }
          }
        },
        {
          "anyOf": [{ "required": ["value"] }, { "required": ["valueFrom"] }]
        }
      ]
    },
    "opSummarizeFiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": { "const": "summarize-files" },
        "maxLines": { "type": "number" },
        "only": { "type": "array", "items": { "type": "string" } }
      }
    },
    "opSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "discriminator", "cases"],
      "properties": {
        "op": { "const": "switch" },
        "discriminator": { "$ref": "#/definitions/jp" },
        "cases": {
          "type": "object",
          "additionalProperties": { "type": "object", "additionalProperties": true }
        },
        "default": { "type": "object", "additionalProperties": true },
        "exactOnly": { "type": "boolean" }
      }
    },
    "opTruncateHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "keep"],
      "properties": {
        "op": { "const": "truncate-history" },
        "keep": { "type": "number", "minimum": 0 }
      }
    },
    "opTruncateSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path", "maxChars"],
      "properties": {
        "op": { "const": "truncate-section" },
        "path": { "$ref": "#/definitions/jp" },
        "maxChars": { "type": "number", "minimum": 1 },
        "suffix": { "type": "string" }
      }
    }
  }
}
