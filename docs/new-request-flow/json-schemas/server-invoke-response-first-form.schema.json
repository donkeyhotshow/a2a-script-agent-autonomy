{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://a2a-script-agent/new-request-flow/json-schemas/server-invoke-response-first-form.schema.json",
  "title": "Server Invoke Response - First (Form Choices)",
  "description": "Canonical first response for POST /api/v1/invoke: context + execute.form.choices (see simulations/SCHEMA.md, fix-vue-imports/1, agent-coder/1).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "context": {
      "type": "object",
      "description": "Execution context. At minimum contains task; may contain other system-managed fields.",
      "required": ["task"],
      "properties": {
        "task": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "execute": {
      "type": "object",
      "required": ["form"],
      "properties": {
        "form": {
          "type": "object",
          "description": "Form with choices for selecting the execution mode/action.",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string"
            },
            "choices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "label"],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Choice ID (e.g. fix-vue-imports, auto-ai, task-decomposition)."
                  },
                  "label": {
                    "type": "string",
                    "description": "Human-readable label."
                  }
                }
              }
            }
          },
          "required": ["choices"]
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["context", "execute"]
}

