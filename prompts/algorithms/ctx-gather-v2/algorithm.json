{
  "id": "ctx-gather-v2",
  "version": "2.0",
  "model": "llama3.1:8b",
  "promptTemplate": "ctx-gather-template",
  "outputSchema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "items": { "type": "string" },
        "description": "List of files found matching the patterns"
      },
      "imports": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "imports": { "type": "array", "items": { "type": "string" } }
          }
        },
        "description": "Import statements found in each file"
      },
      "patterns": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Detected code patterns"
      }
    },
    "required": ["files"]
  },
  "contextRequirements": ["targetFiles"],
  "maxTokens": 2000,
  "temperature": 0.0
}