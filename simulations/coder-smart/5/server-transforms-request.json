{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$.context.ragResults",
      "value": "$.result.rag-search.results"
    },
    {
      "op": "render-markdown",
      "templateRef": "simulations/coder-smart/5/request.md",
      "data": "$out",
      "outputFile": "request.md"
    }
  ]
}
