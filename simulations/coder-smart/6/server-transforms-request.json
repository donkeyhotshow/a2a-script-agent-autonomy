{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "truncate-section",
      "path": "context.docVirtual",
      "maxChars": 8000
    },
    {
      "op": "render-markdown",
      "templateRef": "a2a-server/prompts/coder-request.md",
      "data": "$out",
      "outputFile": "request.md"
    }
  ]
}
