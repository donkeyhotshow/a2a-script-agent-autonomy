    "view_file": {
      "path": "resources/js/components/ProfileEditForm.vue",
      "code": "<template>\n  <div class=\"profile-edit-form\">\n    <h2>Редагування профілю</h2>\n    \n    <form @submit.prevent=\"handleSubmit\" class=\"space-y-4\">\n      <!-- Avatar Upload -->\n      <div class=\"form-group\">\n        <label>Аватар</label>\n        <div class=\"avatar-upload\">\n          <img v-if=\"previewAvatar\" :src=\"previewAvatar\" class=\"avatar-preview\" />\n          <input\n            type=\"file\"\n            accept=\"image/*\"\n            @change=\"handleAvatarChange\"\n            class=\"form-control\"\n          />\n        </div>\n      </div>\n      \n      <!-- Name -->\n      <div class=\"form-group\">\n        <label for=\"name\">Ім'я *</label>\n        <input\n          id=\"name\"\n          v-model=\"form.name\"\n          type=\"text\"\n          required\n          maxlength=\"255\"\n          class=\"form-control\"\n          :class=\"{ 'is-invalid': errors.name }\"\n        />\n        <span v-if=\"errors.name\" class=\"error\">{{ errors.name }}</span>\n      </div>\n      \n      <!-- Email -->\n      <div class=\"form-group\">\n        <label for=\"email\">Email *</label>\n        <input\n          id=\"email\"\n          v-model=\"form.email\"\n          type=\"email\"\n          required\n          class=\"form-control\"\n          :class=\"{ 'is-invalid': errors.email }\"\n        />\n        <span v-if=\"errors.email\" class=\"error\">{{ errors.email }}</span>\n      </div>\n      \n      <!-- Phone -->\n      <div class=\"form-group\">\n        <label for=\"phone\">Телефон</label>\n        <input\n          id=\"phone\"\n          v-model=\"form.phone\"\n          type=\"tel\"\n          class=\"form-control\"\n        />\n      </div>\n      \n      <!-- Birthdate -->\n      <div class=\"form-group\">\n        <label for=\"birthdate\">Дата народження</label>\n        <input\n          id=\"birthdate\"\n          v-model=\"form.birthdate\"\n          type=\"date\"\n          class=\"form-control\"\n        />\n      </div>\n      \n      <!-- Bio -->\n      <div class=\"form-group\">\n        <label for=\"bio\">Про себе</label>\n        <textarea\n          id=\"bio\"\n          v-model=\"form.bio\"\n          rows=\"4\"\n          maxlength=\"1000\"\n          class=\"form-control\"\n        ></textarea>\n      </div>\n      \n      <!-- Actions -->\n      <div class=\"form-actions\">\n        <button\n          type=\"submit\"\n          :disabled=\"isLoading\"\n          class=\"btn btn-primary\"\n        >\n          {{ isLoading ? 'Збереження...' : 'Зберегти' }}\n        </button>\n        <button\n          type=\"button\"\n          @click=\"$emit('cancel')\"\n          class=\"btn btn-secondary\"\n        >\n          Скасувати\n        </button>\n      </div>\n    </form>\n  </div>\n</template>\n\n<script setup>\nimport { ref, reactive, computed } from 'vue'\n\nconst props = defineProps({\n  user: {\n    type: Object,\n    required: true\n  }\n})\n\nconst emit = defineEmits(['submit', 'cancel'])\n\nconst isLoading = ref(false)\nconst errors = ref({})\nconst previewAvatar = ref(props.user.avatar_url)\n\nconst form = reactive({\n  name: props.user.name || '',\n  email: props.user.email || '',\n  phone: props.user.phone || '',\n  birthdate: props.user.birthdate || '',\n  bio: props.user.bio || '',\n  avatar: null\n})\n\nconst handleAvatarChange = (event) => {\n  const file = event.target.files[0]\n  if (file) {\n    form.avatar = file\n    previewAvatar.value = URL.createObjectURL(file)\n  }\n}\n\nconst handleSubmit = async () => {\n  isLoading.value = true\n  errors.value = {}\n  \n  try {\n    const formData = new FormData()\n    Object.keys(form).forEach(key => {\n      if (form[key] !== null) {\n        formData.append(key, form[key])\n      }\n    })\n    \n    await emit('submit', formData)\n  } catch (error) {\n    if (error.response?.data?.errors) {\n      errors.value = error.response.data.errors\n    }\n  } finally {\n    isLoading.value = false\n  }\n}\n</script>\n\n<style scoped>\n.profile-edit-form {\n  max-width: 600px;\n  margin: 0 auto;\n}\n\n.form-group {\n  margin-bottom: 1rem;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 0.5rem;\n  font-weight: 600;\n}\n\n.form-control {\n  width: 100%;\n  padding: 0.5rem;\n  border: 1px solid #ddd;\n  border-radius: 4px;\n}\n\n.form-control.is-invalid {\n  border-color: #e74c3c;\n}\n\n.error {\n  color: #e74c3c;\n  font-size: 0.875rem;\n}\n\n.avatar-preview {\n  width: 100px;\n  height: 100px;\n  border-radius: 50%;\n  object-fit: cover;\n  margin-bottom: 0.5rem;\n}\n\n.form-actions {\n  display: flex;\n  gap: 1rem;\n  margin-top: 1.5rem;\n}\n\n.btn {\n  padding: 0.5rem 1rem;\n  border-radius: 4px;\n  cursor: pointer;\n}\n\n.btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.btn-primary {\n  background: #3498db;\n  color: white;\n  border: none;\n}\n\n.btn-secondary {\n  background: #95a5a6;\n  color: white;\n  border: none;\n}\n</style>"
