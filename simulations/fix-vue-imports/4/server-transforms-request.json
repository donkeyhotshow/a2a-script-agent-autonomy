{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "copy",
      "from": "$.result.script.unresolved_imports",
      "to": "$.context.unresolved_imports"
    },
    {
      "op": "switch",
      "discriminator": "$.result.script.partial_escalate",
      "cases": {
        "true": {
          "op": "set",
          "path": "$.context.execution",
          "value": {
            "action": "fix-vue-imports",
            "step": "vue-import-escalate"
          }
        }
      },
      "default": {
        "op": "set",
        "path": "$.context.execution",
        "value": {
          "action": "fix-vue-imports",
          "step": "vue-import-apply"
        }
      }
    }
  ]
}
