{
  "type": "pipeline",
  "description": "Трансформація RAG-результатів - має виправити неправильний формат",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$.context.ragResults",
      "value": "$.result.rag-search.results"
    },
    {
      "op": "validate-rag-format",
      "description": "Перевірка формату RAG-результатів"
    },
    {
      "op": "render-markdown",
      "templateRef": "a2a-server/prompts/coder-request.md",
      "data": "$out",
      "outputFile": "request.md"
    }
  ]
}
