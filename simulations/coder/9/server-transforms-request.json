{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "append-to-array",
      "to": "$.context.history",
      "value": {
        "role": "assistant",
        "action": "read-file",
        "result": "$.result.read-file"
      }
    },
    {
      "op": "inject-error",
      "to": "$.context.history",
      "errorType": "json-parse-error",
      "errorMessage": "Не вдалося розпарсити JSON у полі content: Unexpected end of JSON input"
    },
    {
      "op": "render-markdown",
      "templateRef": "a2a-server/prompts/coder-request.md",
      "data": "$out",
      "outputFile": "request.md"
    }
  ]
}
