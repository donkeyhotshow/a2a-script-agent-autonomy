{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "append-to-array",
      "to": "$.context.history",
      "value": {
        "role": "assistant",
        "action": "write-file",
        "result": "$.result"
      }
    },
    {
      "op": "render-markdown",
      "templateRef": "simulations/coder/8/request.md",
      "data": "$out",
      "outputFile": "request.md"
    }
  ]
}
