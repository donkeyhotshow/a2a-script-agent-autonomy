{
  "type": "pipeline",
  "steps": [
    {
      "op": "parse-json-from-md",
      "fromFile": "response.md",
      "jsonPath": "$",
      "to": "$llm"
    },
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "append-to-array",
      "to": "$.context.history",
      "value": {
        "role": "assistant",
        "message": "$.llm.message",
        "action": "$.llm.action"
      }
    },
    {
      "op": "switch",
      "discriminator": "$.llm.action",
      "cases": {
        "continue": {
          "op": "set",
          "path": "$.execute",
          "value": {
            "form": {
              "title": "Продовжити",
              "input": [
                {
                  "name": "message",
                  "type": "text",
                  "label": "Ваше повідомлення",
                  "required": true
                }
              ]
            }
          }
        }
      }
    }
  ]
}
