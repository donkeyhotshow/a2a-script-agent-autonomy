{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/org-carrier/a2a-script-agent/simulations/validation-for-response.schema.json",
  "title": "Simulation Response Schema",
  "description": "JSON Schema for validating simulation response.json files (Server → Client)",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "description": "Message to display in web UI dialog (translates to web)"
    },
    "execute": {
      "$ref": "#/definitions/execute"
    },
    "context": {
      "$ref": "#/definitions/context"
    },
    "actions": {
      "type": "array",
      "description": "Primary actions list - hardcoded steps, server determines next step from result",
      "items": {
        "$ref": "#/definitions/action"
      },
      "default": []
    },
    "aiActions": {
      "type": "array",
      "description": "Secondary AI actions - available steps for display only, LLM chooses next from its answer",
      "items": {
        "$ref": "#/definitions/action"
      },
      "default": []
    },
    "fallbackActions": {
      "type": "array",
      "description": "Fallback actions merged into choices (auto-ai, task-decomposition)",
      "items": {
        "$ref": "#/definitions/fallbackAction"
      },
      "default": []
    }
  },
  "required": ["context"],
  "additionalProperties": false,
  "definitions": {
    "context": {
      "type": "object",
      "description": "Context object containing task state, execution info, and history",
      "properties": {
        "task": {
          "type": "string",
          "description": "The original task description"
        },
        "execution": {
          "$ref": "#/definitions/execution"
        },
        "history": {
          "type": "array",
          "description": "Conversation history between user and assistant",
          "items": {
            "$ref": "#/definitions/historyEntry"
          },
          "default": []
        },
        "docVirtual": {
          "type": "object",
          "description": "Virtual document for multi-step workflows (coder-smart, task-decomposition)",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": ["task"]
    },
    "execution": {
      "type": "object",
      "description": "Execution state tracking",
      "properties": {
        "action": {
          "type": "string",
          "description": "Current action being executed (e.g., 'auto-ai', 'dialog', 'coder-smart', 'fix-vue-imports')"
        },
        "step": {
          "type": "string",
          "description": "Current step within the action (e.g., 'llm-request', 'user-request', 'completed')"
        }
      },
      "required": ["action"]
    },
    "historyEntry": {
      "type": "object",
      "description": "A single entry in conversation history",
      "properties": {
        "role": {
          "type": "string",
          "enum": ["user", "assistant", "system"],
          "description": "Role of the message sender"
        },
        "message": {
          "type": "string",
          "description": "The message content"
        },
        "action": {
          "type": "string",
          "description": "Action taken by assistant (e.g., 'rag-search', 'read-file', 'write-file', 'completed')"
        },
        "params": {
          "type": "object",
          "description": "Parameters for the action"
        }
      },
      "required": ["role", "message"]
    },
    "execute": {
      "type": "object",
      "description": "Commands to execute on client/web. Each key is the action type, value is params.",
      "properties": {
        "message": {
          "type": "string",
          "description": "Message to display in web UI dialog (translates to web, NOT processed by client)"
        },
        "form": {
          "$ref": "#/definitions/form"
        },
        "read-file": {
          "$ref": "#/definitions/executeReadFile"
        },
        "write-file": {
          "$ref": "#/definitions/executeWriteFile"
        },
        "rag-search": {
          "$ref": "#/definitions/executeRagSearch"
        },
        "execute-command": {
          "$ref": "#/definitions/executeCommand"
        },
        "list-directory": {
          "$ref": "#/definitions/executeListDirectory"
        },
        "grep-search": {
          "$ref": "#/definitions/executeGrepSearch"
        },
        "script": {
          "$ref": "#/definitions/executeScript"
        }
      },
      "additionalProperties": false,
      "description": "execute is action-key format only. Keys: message (web), form (web), read-file (client), write-file (client), rag-search (client), execute-command (client), script (client)"
    },
    "form": {
      "type": "object",
      "description": "Form to display on web UI (translates to web)",
      "properties": {
        "title": {
          "type": "string",
          "description": "Form title"
        },
        "choices": {
          "type": "array",
          "description": "Choice options (for selection forms)",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Choice identifier (sent back as result.choice)"
              },
              "label": {
                "type": "string",
                "description": "Choice label displayed to user"
              }
            },
            "required": ["id", "label"]
          }
        },
        "input": {
          "type": "array",
          "description": "Form input fields",
          "items": {
            "$ref": "#/definitions/formInput"
          }
        }
      }
    },
    "formInput": {
      "type": "object",
      "description": "Form input field definition",
      "properties": {
        "name": {
          "type": "string",
          "description": "Field name (key in form submission)"
        },
        "type": {
          "type": "string",
          "enum": ["text", "submit", "checkbox", "radio", "select", "textarea"],
          "description": "Input type"
        },
        "label": {
          "type": "string",
          "description": "Field label"
        },
        "placeholder": {
          "type": "string",
          "description": "Placeholder text"
        },
        "required": {
          "type": "boolean",
          "description": "Whether field is required",
          "default": false
        },
        "value": {
          "description": "Default value"
        }
      },
      "required": ["name", "type", "label"]
    },
    "executeReadFile": {
      "type": "object",
      "description": "Command to read a file (processed by client, NOT translated to web)",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the file to read"
        }
      },
      "required": ["path"]
    },
    "executeWriteFile": {
      "type": "object",
      "description": "Command to write a file (processed by client, NOT translated to web)",
      "properties": {
        "path": {
          "type": "string",
          "description": "Path where to write the file"
        },
        "content": {
          "type": "string",
          "description": "Content to write"
        }
      },
      "required": ["path", "content"]
    },
    "executeRagSearch": {
      "type": "object",
      "description": "Command to perform RAG search (processed by client, NOT translated to web)",
      "properties": {
        "query": {
          "type": "string",
          "description": "Search query"
        }
      },
      "required": ["query"]
    },
    "executeCommand": {
      "type": "object",
      "description": "Command to execute shell command (processed by client, NOT translated to web)",
      "properties": {
        "command": {
          "type": "string",
          "description": "Shell command to execute"
        }
      },
      "required": ["command"]
    },
    "executeListDirectory": {
      "type": "object",
      "description": "Command to list directory contents (processed by client, NOT translated to web)",
      "properties": {
        "path": {
          "type": "string",
          "description": "Directory path to list"
        }
      },
      "required": ["path"]
    },
    "executeGrepSearch": {
      "type": "object",
      "description": "Command to search files with grep (processed by client, NOT translated to web)",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Search pattern (regex)"
        },
        "path": {
          "type": "string",
          "description": "Path to search in"
        },
        "glob": {
          "type": "string",
          "description": "File glob pattern (e.g., '*.js')"
        }
      },
      "required": ["pattern"]
    },
    "executeScript": {
      "type": "object",
      "description": "Command to execute a script (processed by client, NOT translated to web)",
      "properties": {
        "input": {
          "type": "object",
          "description": "Input parameters for the script"
        },
        "output": {
          "type": "string",
          "description": "Expected output variable name"
        },
        "code": {
          "type": "string",
          "description": "DSL code to execute"
        }
      }
    },
    "action": {
      "type": "object",
      "description": "Action definition for actions or aiActions lists",
      "properties": {
        "action": {
          "type": "string",
          "description": "Action identifier"
        },
        "title": {
          "type": "string",
          "description": "Action title"
        },
        "description": {
          "type": "string",
          "description": "Action description"
        },
        "priority": {
          "type": "integer",
          "description": "Action priority (higher = more preferred)"
        },
        "matchScore": {
          "type": "number",
          "description": "Match score for AI action selection"
        },
        "steps": {
          "type": "array",
          "description": "Steps for the action (hardcoded for actions, available for display in aiActions)",
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "repeatSteps": {
          "type": "array",
          "description": "Steps that can be repeated",
          "items": {
            "$ref": "#/definitions/step"
          }
        }
      },
      "required": ["action", "title", "description"]
    },
    "step": {
      "type": "object",
      "description": "Step definition within an action",
      "properties": {
        "action": {
          "type": "string",
          "description": "Step action identifier"
        },
        "title": {
          "type": "string",
          "description": "Step title"
        },
        "description": {
          "type": "string",
          "description": "Step description"
        },
        "priority": {
          "type": "integer",
          "description": "Step priority"
        },
        "input": {
          "type": "object",
          "description": "Input configuration for the step"
        },
        "output": {
          "type": "object",
          "description": "Output configuration for the step"
        }
      }
    },
    "fallbackAction": {
      "type": "object",
      "description": "Fallback action definition",
      "properties": {
        "mode": {
          "type": "string",
          "description": "Fallback mode identifier (e.g., 'auto-ai', 'task-decomposition')"
        },
        "title": {
          "type": "string",
          "description": "Fallback action title"
        },
        "description": {
          "type": "string",
          "description": "Fallback action description"
        },
        "fallbackType": {
          "type": "string",
          "enum": ["llm_generation", "manual"],
          "description": "Type of fallback: llm_generation (auto-ai) or manual (task-decomposition)"
        }
      },
      "required": ["mode", "title", "description", "fallbackType"]
    }
  }
}
