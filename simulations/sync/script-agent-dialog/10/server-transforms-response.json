{
  "type": "pipeline",
  "steps": [
    {
      "op": "parse-json-from-md",
      "fromFile": "response.md",
      "jsonPath": "$",
      "to": "$llm"
    },
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "append-to-array",
      "to": "$.context.history",
      "value": {
        "role": "assistant",
        "message": "$.llm.message"
      }
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "dialog",
        "step": "adding_tests"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": "$.llm.execute"
    }
  ]
}
