{
  "type": "pipeline",
  "steps": [
    {
      "op": "set",
      "path": "$.context.history",
      "valueFrom": "$.context.history + [{'role': 'system', 'message': 'RAG: ' + $.result['rag-search'].results[0].path + ' (page 1, pageSize 10, total ' + $.result['rag-search'].results.length + ', hasMore false)'}]"
    },
    {
      "op": "remove",
      "path": "$.result"
    },
    {
      "op": "set",
      "path": "$.context.workbench.sections.scratchpad.pending_rag",
      "value": null
    },
    {
      "op": "set",
      "path": "$.context.workbench.sections.scratchpad.rag_ok",
      "value": true
    }
  ]
}
