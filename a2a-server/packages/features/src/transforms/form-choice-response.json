{
  "type": "pipeline",
  "steps": [
    {
      "op": "switch",
      "exactOnly": true,
      "discriminator": "$.choice_id",
      "cases": {
        "auto": {
          "op": "set",
          "path": "$.formProcessResult",
          "value": {
            "outcome": "completed",
            "message": "Auto mode selected",
            "execute": {
              "form": {
                "title": "Автоматичний режим вибрано",
                "description": "Очікуйте виконання...",
                "input": [{ "name": "message", "type": "text", "label": "Message", "required": true }]
              }
            }
          }
        },
        "manual": {
          "op": "set",
          "path": "$.formProcessResult",
          "value": {
            "outcome": "completed",
            "message": "Manual mode selected",
            "execute": {
              "form": {
                "title": "Ручний режим вибрано. Кроки будуть показані для підтвердження.",
                "choices": [
                  { "id": "confirm", "label": "Підтвердити" },
                  { "id": "cancel", "label": "Скасувати" }
                ]
              }
            }
          }
        },
        "ai": {
          "op": "set",
          "path": "$.formProcessResult",
          "value": {
            "outcome": "completed",
            "message": "AI mode selected",
            "execute": {
              "form": {
                "title": "AI режим вибрано. Генерація дій через LLM...",
                "choices": [
                  { "id": "generate", "label": "Згенерувати дії" },
                  { "id": "refine", "label": "Уточнити задачу" }
                ]
              }
            }
          }
        },
        "dialog": {
          "op": "set",
          "path": "$.formProcessResult",
          "value": {
            "outcome": "completed",
            "message": "Dialog mode selected",
            "context": {
              "execution": {
                "action": "dialog",
                "step": "request"
              },
              "task": "диалог"
            },
            "execute": {
              "message": "Виберіть режим 'діалог' для спілкування з AI. Введіть ваше повідомлення нижче.",
              "form": {
                "input": [
                  {
                    "name": "message",
                    "type": "text",
                    "label": "Повідомлення",
                    "required": true
                  }
                ]
              }
            }
          }
        },
        "agent": {
          "op": "set",
          "path": "$.formProcessResult",
          "value": {
            "outcome": "ai_action_ready",
            "message": "Agent mode selected",
            "context": {
              "execution": {
                "action": "agent",
                "step": "start"
              },
              "workbench": {
                "sections": {}
              }
            },
            "execute": {
              "message": "Режим агента: модель обробляє `context.task` і agent prompt; окрема форма вводу не показується."
            },
            "aiActions": {
              "action": "agent",
              "mode": "llm-driven",
              "step": "start",
              "completed": false
            }
          }
        },
        "task-decomposition": {
          "op": "set",
