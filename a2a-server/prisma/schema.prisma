// Prisma Schema for A2A Server
// Async protocol: Sessions, Messages, Requests stored in PostgreSQL

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Client - пользователь системы
// ============================================

model Client {
  id           String   @id
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  apiKey       String   @unique @map("api_key")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  projects     Project[]

  @@map("clients")
}

// ============================================
// Project - проект в системе
// ============================================

model Project {
  id                String   @id
  clientId          String   @map("client_id")
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  gitUrl            String   @map("git_url")
  branch            String   @default("main")
  sshKeyEncrypted   String?  @map("ssh_key_encrypted")
  status            ProjectStatus @default(PENDING_CLONE)
  lastIndexedAt     DateTime? @map("last_indexed_at")
  indexingProgress  Int      @default(0) @map("indexing_progress")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  architecturalFeatures ArchitecturalFeature[]
  sessions          Session[]
  files             File[]
  graphEntities     GraphEntity[]
  indexingJobs      IndexingJob[]

  @@map("projects")
}

enum ProjectStatus {
  PENDING_CLONE
  CLONING
  PENDING_INDEXING
  INDEXING
  INDEXED
  ERROR
}

// ============================================
// ArchitecturalFeature - архитектурные особенности проекта
// ============================================

model ArchitecturalFeature {
  id        String   @id
  projectId String   @map("project_id")
  feature   String
  category  String
  detectedAt DateTime @default(now()) @map("detected_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("architectural_features")
}

// ============================================
// Session - диалог между клиентом и сервером
// ============================================

model Session {
  id          String        @id
  projectId   String        @map("project_id")
  title       String?       @default("New Session")
  status      SessionStatus @default(CREATED)
  context     Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  completedAt DateTime?     @map("completed_at")
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]
  messages    Message[]

  @@index([projectId])
  @@index([status])
  @@map("sessions")
}

enum SessionStatus {
  CREATED
  ACTIVE
  PAUSED
  COMPLETED
  ERROR
}

// ============================================
// Task - задача в сессии
// ============================================

model Task {
  id         String     @id
  sessionId  String     @map("session_id")
  type       TaskType
  status     TaskStatus @default(PENDING)
  target     String?
  progress   Int        @default(0)
  metadata   Json?
  error      String?
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  session    Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

enum TaskType {
  ANALYZE
  REFACTOR
  TEST
  DOCUMENT
  FIX
  CREATE
  DELETE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================
// Message - сообщение в сессии
// ============================================

model Message {
  id         String          @id
  sessionId  String          @map("session_id")
  direction  MessageDirection
  role       MessageRole?    // NEW: user | server
  content    Json
  contentText String?        @map("content_text") // NEW: текстовое содержимое
  promiseId  String?         @unique @map("promise_id") // NEW: ссылка на Request
  status     MessageStatus?  @default(sent) // NEW: статус сообщения
  createdAt  DateTime        @default(now()) @map("created_at")
  session    Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([promiseId])
  @@map("messages")
}

enum MessageDirection {
  CLIENT_TO_SERVER
  SERVER_TO_CLIENT
}

enum MessageRole {
  user
  server
}

enum MessageStatus {
  sent
  pending
  completed
  failed
}

// ============================================
// Request - запрос на обработку (Promise)
// ============================================

model Request {
  id          String        @id
  promiseId   String        @unique @default(cuid()) @map("promise_id")
  clientId    String        @map("client_id")
  status      RequestStatus @default(pending)
  priority    Int           @default(0)
  context     Json
  message     String?       @map("message_text")
  codeBlocks  Json?         @map("code_blocks")
  result      Json?
  error       Json?
  createdAt   DateTime      @default(now()) @map("created_at")
  startedAt   DateTime?     @map("started_at")
  completedAt DateTime?     @map("completed_at")

  @@index([status, priority, createdAt])
  @@index([clientId])
  @@map("requests")
}

enum RequestStatus {
  pending
  processing
  completed
  failed
  cancelled
}

// ============================================
// File - файл проекта
// ============================================

model File {
  id           String   @id
  projectId    String   @map("project_id")
  path         String
  language     String?
  linesCount   Int      @map("lines_count")
  hash         String
  lastModified DateTime @map("last_modified")
  indexedAt    DateTime? @map("indexed_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  embeddings   Embedding[]

  @@unique([projectId, path])
  @@map("files")
}

// ============================================
// GraphEntity - сущность графа знаний
// ============================================

model GraphEntity {
  id        String       @id
  projectId String       @map("project_id")
  path      String
  type      EntityType
  name      String?
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  relationsFrom GraphRelation[] @relation("FromRelation")
  relationsTo   GraphRelation[] @relation("ToRelation")

  @@unique([projectId, path])
  @@index([projectId, type])
  @@map("graph_entities")
}

enum EntityType {
  MODEL
  CONTROLLER
  SERVICE
  REPOSITORY
  MIDDLEWARE
  VUE_COMPONENT
  COMPOSABLE
  PHP
  JS
  CONFIG
  OTHER
}

// ============================================
// GraphRelation - связь между сущностями
// ============================================

model GraphRelation {
  id        String       @id
  projectId String       @map("project_id")
  fromId    String       @map("from_id")
  toId      String       @map("to_id")
  type      RelationType
  metadata  Json?
  createdAt DateTime     @default(now()) @map("created_at")
  fromEntity GraphEntity @relation("FromRelation", fields: [fromId], references: [id], onDelete: Cascade)
  toEntity   GraphEntity @relation("ToRelation", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([projectId, fromId, toId, type])
  @@index([projectId])
  @@index([fromId, toId])
  @@map("graph_relations")
}

enum RelationType {
  USES
  CREATES
  EXTENDS
  IMPLEMENTS
  IMPORTS
  BELONGS_TO
  HAS_MANY
  HAS_ONE
  BELONGS_TO_MANY
}

// ============================================
// Embedding - векторное представление
// ============================================

model Embedding {
  id         String     @id
  fileId     String     @map("file_id")
  chunkType  ChunkType  @map("chunk_type")
  lineStart  Int        @map("line_start")
  lineEnd    Int        @map("line_end")
  content    String
  metadata   Json?
  createdAt  DateTime   @default(now()) @map("created_at")
  file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("embeddings")
}

enum ChunkType {
  FILE
  CLASS
  METHOD
  FUNCTION
  COMPONENT
  BLOCK
  SECTION
}

// ============================================
// IndexingJob - задача индексации
// ============================================

model IndexingJob {
  id          String     @id
  projectId   String     @map("project_id")
  type        String
  payload     Json
  status      JobStatus  @default(PENDING)
  progress    Int        @default(0)
  error       String?
  createdAt   DateTime   @default(now()) @map("created_at")
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("indexing_jobs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
