{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Simulation v2 Schema",
  "type": "object",
  "properties": {
    "neurons": {
      "type": "object",
      "properties": {
        "intentDetectors": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true,
            "patternProperties": {
              "^.+$": {
                "type": "object"
              }
            }
          }
        },
        "contextEnrichers": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true,
            "patternProperties": {
              "^.+$": {
                "type": "object"
              }
            }
          }
        },
        "actionSuggesters": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true,
            "patternProperties": {
              "^.+$": {
                "type": "object"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "contextPipeline": {
      "type": "object",
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "neurons"],
            "properties": {
              "name": { "type": "string" },
              "neurons": {
                "type": "array",
                "items": { "type": "string" }
              },
              "parallel": { "type": "boolean" },
              "timeout": { "type": "number" },
              "depends_on": {
                "oneOf": [
                  { "type": "string" },
                  {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "output": {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": ["enriched", "minimal"]
            },
            "include_neuron_metadata": { "type": "boolean" }
          },
          "additionalProperties": false,
          "required": ["format", "include_neuron_metadata"]
        }
      },
      "required": ["stages", "output"],
      "additionalProperties": false
    },
    "llmRequirements": {
      "type": "object",
      "properties": {
        "template": { "type": "string" },
        "generateFrom": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generate_from": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": { "type": "string" },
              "add": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["condition", "add"],
            "additionalProperties": false
          }
        }
      },
      "required": ["template", "generateFrom", "rules"],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
