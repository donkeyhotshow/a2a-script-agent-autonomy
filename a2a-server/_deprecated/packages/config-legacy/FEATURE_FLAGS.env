# A2A Server Feature Flags Configuration Example
# Copy this to .env and customize for your deployment

# ===========================================
# FEATURE FLAGS - Enable/Disable System Mechanisms
# ===========================================

# Core systems are always enabled (cannot be disabled)
# These provide fundamental request processing and orchestration

# LLM Integration Features
FEATURE_LLM_ENABLED=true
FEATURE_LLM_COGNITION_INJECTION=true
FEATURE_LLM_HIERARCHICAL_REASONER=true
FEATURE_LLM_BUG_FIXER=true

# P2P Networking (set to false for single-server deployments)
FEATURE_P2P_ENABLED=false
FEATURE_P2P_CRDT=true
FEATURE_P2P_RELAY=true

# Background Daemon Services
FEATURE_DAEMON_ENABLED=true
FEATURE_DAEMON_LLM_POLLING=true
FEATURE_DAEMON_REQUEST_PROCESSING=true

# Action Execution System
FEATURE_ACTIONS_ENABLED=true
FEATURE_ACTIONS_FILE_OPERATIONS=true
FEATURE_ACTIONS_GIT_OPERATIONS=true
FEATURE_ACTIONS_SCRIPT_EXECUTION=true
FEATURE_ACTIONS_MCP_CALLS=true

# Request Transform Pipeline
FEATURE_TRANSFORM_ENABLED=true
FEATURE_TRANSFORM_GRAY_ROOM=true
FEATURE_TRANSFORM_PIPELINE=true
FEATURE_TRANSFORM_INTERRUPT_HANDLERS=true

# AI/ML Features
FEATURE_AI_ENABLED=true
FEATURE_AI_EMBEDDINGS=false
FEATURE_AI_RAG=true
FEATURE_AI_AGENT_SWING=true
FEATURE_AI_EPISODIC_MEMORY=true

# Monitoring and Observability
FEATURE_MONITORING_ENABLED=true
FEATURE_MONITORING_METRICS=true
FEATURE_MONITORING_LOGGING=true
FEATURE_MONITORING_HEALTH_CHECKS=true
FEATURE_MONITORING_NOTIFICATIONS=false

# Security Features
FEATURE_SECURITY_ENABLED=true
FEATURE_SECURITY_AUTH=true
FEATURE_SECURITY_RATE_LIMITING=true
FEATURE_SECURITY_VALIDATION=true

# Storage and Persistence
FEATURE_STORAGE_ENABLED=true
FEATURE_STORAGE_DATABASE=true
FEATURE_STORAGE_REDIS=true
FEATURE_STORAGE_FILE_CACHE=true
FEATURE_STORAGE_GIT_REPOS=true

# API Interfaces
FEATURE_API_ENABLED=true
FEATURE_API_REST=true
FEATURE_API_WEBSOCKET=true
FEATURE_API_GRAPHQL=false

# Experimental Features (use with caution)
FEATURE_EXPERIMENTAL_ENABLED=false
FEATURE_EXPERIMENTAL_SELF_EVOLVE=false
FEATURE_EXPERIMENTAL_SKILL_EVOLVER=false
FEATURE_EXPERIMENTAL_VISION_TESTER=false

# ===========================================
# DEVELOPMENT/PRODUCTION OVERRIDES
# ===========================================

# In development, you might want to enable experimental features for testing
# NODE_ENV=development

# In production, keep experimental features disabled
# NODE_ENV=production

# ===========================================
# PERFORMANCE TUNING
# ===========================================

# Disable heavy features for resource-constrained environments
# FEATURE_AI_EMBEDDINGS=false
# FEATURE_MONITORING_NOTIFICATIONS=false
# FEATURE_EXPERIMENTAL_ENABLED=false

# Enable all features for full functionality testing
# FEATURE_P2P_ENABLED=true
# FEATURE_AI_EMBEDDINGS=true
# FEATURE_MONITORING_NOTIFICATIONS=true