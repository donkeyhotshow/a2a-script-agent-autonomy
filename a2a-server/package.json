{
  "name": "a2a-server",
  "version": "1.0.0",
  "type": "module",
  "description": "A2A (Agent-to-Agent) Server - Intelligent code analysis and transformation server (stateless edition)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "dev:no-auth": "cross-env SKIP_AUTH=1 tsx watch src/index.ts",
    "claude": "tsx bin/a2a-claude.ts",
    "tui": "tsx bin/handler-tui.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:human-review": "node scripts/run-human-review.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mocks": "cross-env TEST_MODE=mocked vitest run",
    "test:record": "cross-env TEST_MODE=recording vitest run",
    "test:replay": "cross-env TEST_MODE=replay vitest run",
    "test:real": "cross-env TEST_MODE=real vitest run",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "sim:create": "tsx scripts/sim-scaffold.ts",
    "sim:run": "tsx scripts/sim-run.ts",
    "sim:run-all": "tsx scripts/sim-run.ts --all",
    "sim:lint": "tsx scripts/sim-lint.ts",
    "sim:lint:all": "tsx scripts/sim-lint.ts --all",
    "sim:validate": "tsx scripts/sim-validate.ts",
    "sim:validate:all": "tsx scripts/sim-validate.ts --all",
    "sim:workbench:validate": "tsx scripts/sim-workbench-validate.ts",
    "sim:compare": "tsx scripts/sim-compare.ts",
    "sim:report": "tsx scripts/sim-report.ts",
    "sim:check-md": "node scripts/check-sim-md-json-drift.mjs",
    "sim:check-md:fix": "node scripts/check-sim-md-json-drift.mjs --fix",
    "sim:quality": "tsx scripts/sim-quality-gate.ts",
    "sim:contract-report": "tsx scripts/sim-contract-report.ts",
    "gate:cleanup": "tsx scripts/cleanup-gate.ts"
  },
  "keywords": [
    "a2a",
    "agent-to-agent",
    "code-analysis",
    "stateless"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@a2a/rag": "file:../a2a-client/packages/rag",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.72.1",
    "commander": "^11.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "cross-fetch": "^4.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "handlebars": "^4.7.8",
    "helmet": "^7.1.0",
    "ink": "^4.4.1",
    "js-yaml": "^4.1.1",
    "jsonpath-plus": "^10.4.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "picomatch": "^4.0.4",
    "prom-client": "^15.1.3",
    "react": "^18.2.0",
    "simple-git": "^3.22.1",
    "uuid": "^9.0.1",
    "vm2": "^3.10.5",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/ajv": "^0.0.5",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/nock": "^10.0.3",
    "@types/node": "^20.19.38",
    "@types/picomatch": "^4.0.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "jsonify": "^0.0.1",
    "nock": "^13.5.6",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
