{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "switch",
      "discriminator": "$.context.execution.step",
      "cases": {
        "clarify": {
          "op": "pick-context",
          "include": ["execution", "task", "history"]
        },
        "research-plan": {
          "op": "pick-context",
          "include": ["execution", "task", "history"]
        },
        "rag-clarify": {
          "op": "pick-context",
          "include": ["execution", "task", "history"]
        },
        "rag-research-plan": {
          "op": "pick-context",
          "include": ["execution", "task", "history", "workbench"]
        },
        "checklist": {
          "op": "pick-context",
          "include": ["execution", "task", "history", "workbench"]
        },
        "write-doc": {
          "op": "pick-context",
          "include": ["execution", "task", "history", "workbench"]
        },
        "execute-item": {
          "op": "pick-context",
          "include": ["execution", "task", "history", "workbench", "scratchpad", "files"]
        },
        "completed": {
          "op": "pick-context",
          "include": ["execution", "task", "history"]
        }
      },
      "default": {
        "op": "pick-context",
        "include": ["execution", "task", "history", "workbench", "scratchpad"]
      }
    },
    {
      "op": "switch",
      "discriminator": "$.context.execution.step",
      "cases": {
        "execute-item": {
          "op": "summarize-files",
          "maxLines": 80
        }
      },
      "default": {
        "op": "drop",
        "path": "$.context.files"
      }
    },
    {
      "op": "truncate-section",
      "path": "context.workbench.sections",
      "maxChars": 12000
    },
    {
      "op": "render-markdown",
      "templateRef": "a2a-server/prompts/coder-system.md",
      "data": "$out",
      "outputFile": "system.md"
    },
    {
      "op": "render-markdown",
      "templateRef": "a2a-server/prompts/coder-context.md",
      "data": "$out",
      "outputFile": "request.md"
    }
  ]
}
