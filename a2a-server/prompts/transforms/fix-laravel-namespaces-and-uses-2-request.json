{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "fix-laravel-namespaces-and-uses",
        "step": "laravel-use-detect"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "script": {
          "input": {
            "rootDir": ".",
            "filePattern": "**/*.php"
          },
          "output": "broken_uses"
        }
      }
    }
  ]
}
