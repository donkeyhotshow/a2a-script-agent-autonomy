{
  "type": "pipeline",
  "steps": [
    {
      "op": "parse-json-from-md",
      "fromFile": "response.md",
      "jsonPath": "$",
      "to": "$llm"
    },
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "set",
      "path": "$.context.execution.step",
      "value": "${$.llm.step}"
    },
    {
      "op": "append-to-array",
      "to": "$.context.history",
      "value": {
        "role": "assistant",
        "step": "${$.llm.step}",
        "message": "${$.llm.message}"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "valueFrom": "$.llm.execute"
    },
    {
      "op": "set",
      "path": "$.result.completed",
      "value": "${$.llm.completed}"
    }
  ]
}
/**
 * NOTE: The prompt (coder-request.md, dialog-request.md) MUST instruct LLM to return JSON in a code block like:
 * ```json
 * {"step": "...", "message": "...", "execute": {...}, "completed": false}
 * ```
 *
 * If LLM returns plain text (not in JSON code block), parse-json-from-md extracts the raw text,
 * and subsequent steps will fail because $.llm.step, $.llm.message etc. won't exist.
 *
 * This transform uses ${...} template syntax to resolve paths in the extracted JSON.
 */
