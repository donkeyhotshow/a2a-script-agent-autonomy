{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$out.context.execution.step",
      "value": "start"
    },
    {
      "op": "set",
      "path": "$out.context.workbench",
      "value": {
        "sections": {}
      }
    },
    {
      "op": "set",
      "path": "$out.execute",
      "value": {
        "message": "Pending LLM (request template; no fixed input form)."
      }
    },
    {
      "op": "render-markdown",
      "templateRef": "a2a-server/prompts/agent-request.md",
      "data": "$out",
      "outputFile": "request.md"
    }
  ]
}
