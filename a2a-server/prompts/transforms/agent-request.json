{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$out.context.execution.step",
      "value": "start"
    },
    {
      "op": "set",
      "path": "$out.context.workbench",
      "value": {
        "sections": {}
      }
    },
    {
      "op": "set",
      "path": "$out.execute",
      "value": {
        "form": {
          "title": "Agent",
          "description": "Pending LLM request. You can still provide your next instruction.",
          "input": [
            {
              "name": "message",
              "type": "text",
              "label": "Message",
              "required": true
            }
          ]
        }
      }
    },
    {
      "op": "render-markdown",
      "templateRef": "a2a-server/prompts/agent-request.md",
      "data": "$out",
      "outputFile": "request.md"
    }
  ]
}
