{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "fix-vue-imports",
        "step": "vue-import-detect"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "script": {
          "input": {
            "rootDir": ".",
            "filePattern": "**/*.{vue,js,ts}"
          },
          "output": "broken_imports"
        }
      }
    }
  ]
}
