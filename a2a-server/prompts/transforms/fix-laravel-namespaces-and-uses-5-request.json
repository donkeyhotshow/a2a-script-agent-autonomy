{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$",
      "to": "$out"
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "fix-laravel-namespaces-and-uses",
        "step": "laravel-composer-autoload"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "execute-command": {
          "command": "composer dump-autoload -o"
        }
      }
    }
  ]
}
