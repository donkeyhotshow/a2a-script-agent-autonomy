# A2A Server Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ===========================================
# Database Configuration (PostgreSQL + pgvector)
# ===========================================
# Run: npm run init-db (creates a2a_server, a2a_test, app user). Set PG_ADMIN_URL for postgres superuser.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/a2a_server?schema=public"

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ===========================================
# Authentication
# ===========================================
# Default dev credentials (seed creates these): dev@localhost / dev
A2A_DEFAULT_EMAIL=dev@localhost
A2A_DEFAULT_PASSWORD=dev
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# API Keys
# ===========================================
API_KEY_PREFIX=sk_a2a_

# ===========================================
# LLM (OpenAI / Ollama via ai-integration) — external AI for request processing
# ===========================================
# Provider selection:
# - LLM_PROVIDER=ollama  -> use ai-integration in promise mode (?promise=1 + polling)
# - LLM_PROVIDER=openai  -> use OpenAI chat completions
# - unset                -> auto (OpenAI if OPENAI_API_KEY set, else placeholder)
LLM_PROVIDER=

# Ollama via ai-integration (proxy.py)
USE_OLLAMA=false
AI_HUB_URL=http://localhost:11434
OLLAMA_MODEL=llama3
POLL_INTERVAL_MS=2000
POLL_TIMEOUT_MS=120000

# When set, replaces placeholder with actual LLM response
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Plexe ML Configuration
# ===========================================
PLEXE_API_URL=http://localhost:8000
PLEXE_API_KEY=your-plexe-api-key

# ===========================================
# Git Configuration
# ===========================================
GIT_SSH_KEY_PATH=./ssh_keys
GIT_CLONE_BASE_PATH=./repos

# ===========================================
# File Storage
# ===========================================
FILE_CACHE_PATH=./file_cache
MAX_FILE_SIZE_MB=10

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# WebSocket
# ===========================================
WS_PORT=3001
WS_HEARTBEAT_INTERVAL_MS=30000

# ===========================================
# Queue (BullMQ)
# ===========================================
QUEUE_CONCURRENCY=5
INDEXING_CONCURRENCY=2

# ===========================================
# ML / Embeddings
# ===========================================
EMBEDDING_DIMENSION=768
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# ===========================================
# Session Configuration
# ===========================================
SESSION_TIMEOUT_MS=3600000
SESSION_MAX_INACTIVE_MS=1800000
