# A2A Server Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ===========================================
# Database Configuration (PostgreSQL + pgvector)
# ===========================================
# Run: npm run init-db (creates a2a_server, a2a_test, app user). Set PG_ADMIN_URL for postgres superuser.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/a2a_server?schema=public"

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ===========================================
# Authentication
# ===========================================
# Default dev credentials (seed creates these): dev@localhost / dev
A2A_DEFAULT_EMAIL=dev@localhost
A2A_DEFAULT_PASSWORD=dev
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# API Keys
# ===========================================
API_KEY_PREFIX=sk_a2a_

# ===========================================
# LLM (OpenAI / Ollama via ai-integration) — external AI for request processing
# ===========================================
# Provider selection:
# - LLM_PROVIDER=ollama  -> use ai-integration in promise mode (?promise=1 + polling)
# - LLM_PROVIDER=openai  -> use OpenAI chat completions
# - unset                -> auto (OpenAI if OPENAI_API_KEY set, else placeholder)
LLM_PROVIDER=

# Ollama via ai-integration (proxy.py)
USE_OLLAMA=false
AI_HUB_URL=http://localhost:11434
OLLAMA_MODEL=llama3
POLL_INTERVAL_MS=2000
# Legacy fallback: dialog processor uses LLM_POLL_TIMEOUT_MS if set, else POLL_TIMEOUT_MS (default 1h, max 24h)
POLL_TIMEOUT_MS=3600000
# How long a2a-server waits for AI Hub / Ollama promise (ms). Capped at 86_400_000 (24h).
LLM_POLL_TIMEOUT_MS=3600000
LLM_POLL_INTERVAL_MS=2000

# File request queue — retries and cooldown revival (failed timeout-like jobs)
REQUEST_MAX_RETRIES=15
REQUEST_RETRY_DELAY_MS=15000
# After this cooldown (ms), failed requests matching timeout/network errors may be re-queued (rate-limited). 0 = off
AUTO_RETRY_FAILED_AFTER_MS=600000
AUTO_RETRY_FAILED_MAX_PER_TICK=1

# When set, replaces placeholder with actual LLM response
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Plexe ML Configuration
# ===========================================
PLEXE_API_URL=http://localhost:8000
PLEXE_API_KEY=your-plexe-api-key

# ===========================================
# Git Configuration
# ===========================================
GIT_SSH_KEY_PATH=./ssh_keys
GIT_CLONE_BASE_PATH=./repos

# ===========================================
# File Storage
# ===========================================
FILE_CACHE_PATH=./file_cache
MAX_FILE_SIZE_MB=10

# Request queue (file-based, survives restart)
# Base directory for file-based request queue. Relative paths are resolved from server cwd.
REQUESTS_STORAGE_PATH=./storage/requests
# How many days to keep completed/failed/cancelled requests (0 = keep forever).
REQUESTS_RETENTION_DAYS=7
# Hard cap on total request files in storage (0 = no cap). Oldest requests are removed first.
REQUESTS_MAX_FILES=10000

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# WebSocket
# ===========================================
WS_PORT=3001
WS_HEARTBEAT_INTERVAL_MS=30000

# ===========================================
# Queue (BullMQ)
# ===========================================
QUEUE_CONCURRENCY=5
INDEXING_CONCURRENCY=2
QUEUE_MAX_RETRIES=5
QUEUE_BACKOFF_DELAY_MS=1000
QUEUE_BACKOFF_MULTIPLIER=2
QUEUE_MAX_DELAY_MS=60000

# ===========================================
# ML / Embeddings
# ===========================================
EMBEDDING_DIMENSION=768
CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# ===========================================
# Session Configuration
# ===========================================
SESSION_TIMEOUT_MS=3600000
SESSION_MAX_INACTIVE_MS=1800000

# ===========================================
# External AI Hub Proxy Integration
# ===========================================
# Connection Settings
PROXY_BASE_URL=http://localhost:5000
PROXY_FALLBACK_URLS=[]
PROXY_API_KEY=
PROXY_TIMEOUT_MS=30000

# Retry Configuration
PROXY_RETRY_COUNT=2
PROXY_RETRY_DELAY_MS=1000
PROXY_RETRY_MAX_DELAY_MS=30000
PROXY_RETRY_BACKOFF_MULTIPLIER=2
PROXY_RETRYABLE_STATUSES=[408,429,500,502,503,504]

# Cache Configuration
PROXY_CACHE_ENABLED=true
PROXY_CACHE_TTL_SECONDS=300
PROXY_CACHE_MAX_ITEMS=1000
PROXY_CACHE_REDIS_URL=
PROXY_CACHE_KEY_PREFIX=a2a:proxy

# Rate Limiting
PROXY_RATE_LIMIT_ENABLED=true
PROXY_RATE_LIMIT_RPM=1000
PROXY_RATE_LIMIT_BURST=100
PROXY_RATE_LIMIT_BLOCK_DURATION=60
PROXY_RATE_LIMIT_ENDPOINTS={"/api/v1/generate":{"rpm":600,"burst":60},"/api/v1/chat":{"rpm":600,"burst":60},"/api/v1/embeddings":{"rpm":300,"burst":30}}
PROXY_RATE_LIMIT_USERS={}

# Circuit Breaker
PROXY_CIRCUIT_BREAKER_ENABLED=true
PROXY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PROXY_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
PROXY_CIRCUIT_BREAKER_TIMEOUT_MS=60000
PROXY_CIRCUIT_BREAKER_HALF_OPEN_MAX=3

# Load Balancer
PROXY_LB_STRATEGY=round_robin
PROXY_LB_WEIGHTS={}
PROXY_LB_HEALTH_CHECK_INTERVAL_MS=30000

# Monitoring
PROXY_MONITOR_ENABLED=true
PROXY_MONITOR_RETENTION_MINUTES=60
PROXY_MONITOR_LATENCY_HISTOGRAM=true
PROXY_MONITOR_LATENCY_BUCKETS=[10,50,100,250,500,1000,2500,5000]
PROXY_MONITOR_ERROR_THRESHOLD=0.1
PROXY_MONITOR_LATENCY_THRESHOLD=5000

# Health Check
PROXY_HEALTH_ENDPOINT=/health
PROXY_HEALTH_INTERVAL_MS=30000
PROXY_HEALTH_TIMEOUT_MS=5000
PROXY_HEALTH_FAILURE_THRESHOLD=3

# ===========================================
# Polling Optimization
# ===========================================
USE_ADAPTIVE_POLLING=true
POLLING_MIN_INTERVAL_MS=1000
POLLING_MAX_INTERVAL_MS=60000
POLLING_BACKOFF_FACTOR=1.5
POLLING_ACCELERATION_FACTOR=0.5
POLLING_EMPTY_THRESHOLD=3
POLLING_CIRCUIT_BREAKER_THRESHOLD=5
POLLING_CIRCUIT_BREAKER_TIMEOUT_MS=30000

# ===========================================
# Webhook
# ===========================================
WEBHOOK_ENABLED=false
WEBHOOK_TIMEOUT_MS=30000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_SECRET=your-webhook-secret-key

# ===========================================
# Metrics
# ===========================================
METRICS_ENABLED=true
METRICS_EXPORT_INTERVAL_MS=10000
REQUEST_PROCESSOR_INTERVAL_MS=5000

# ===========================================
# Gray Room (Server-side orchestration)
# ===========================================
# Enable gray room server-side interrupt loop (default: off)
# When enabled, allows server to run additional LLM turns after main response
# Values: 0 (disabled), 1 (enabled), true, yes
A2A_GRAY_ROOM_ENABLED=0

# Maximum number of gray room turns (default: 10, max: 100)
A2A_GRAY_ROOM_MAX_TURNS=10

# ===========================================
# Encryption
# ===========================================
ENCRYPTION_KEY=your-32-char-encryption-key!
