# ===========================================
# A2A Unified Orchestrator Environment
# ===========================================

# ===========================================
# Service Ports
# ===========================================
#
# NOTE: The Port Management System will automatically allocate
# alternative ports if these defaults are busy. Check .env.local
# after starting services to see actual port assignments.
#
# See docs/PORT_MANAGEMENT.md for more information.
#

# Main A2A Server API (Node.js) - Range: 3000-3010
SERVER_PORT=3000

# Client API Server (Node.js) - Range: 3001-3011
CLIENT_API_PORT=3001

# Web UI Development Server (Vite) - Range: 5173-5183
WEB_PORT=5173

# AI Proxy (Python Flask) - Range: 11434-11444
PROXY_PORT=11434

# Ollama (Docker) - Range: 11435-11445
OLLAMA_PORT=11435

# PostgreSQL Database - Range: 5432-5442
POSTGRES_PORT=5432
POSTGRES_USER=a2a
POSTGRES_PASSWORD=a2a_secret
POSTGRES_DB=a2a_server

# Redis Cache - Range: 6379-6389
REDIS_PORT=6379

# ===========================================
# A2A Server Configuration
# ===========================================
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Logging Configuration
# LOG_LEVEL: error, warn, info, debug
# LOG_FORMAT: json (machine-readable), pretty (human-readable with colors)
LOG_LEVEL=info
LOG_FORMAT=json

# Database URLs
DATABASE_URL="postgresql://a2a:a2a_secret@localhost:5432/a2a_server?schema=public"
REDIS_URL="redis://localhost:6379"

# Skip auth in development
SKIP_AUTH=1

# ===========================================
# AI Integration (Proxy) Configuration
# ===========================================
OLLAMA_HOST=http://localhost:11435
AI_HUB_CONFIG=
FORWARD_TIMEOUT_SECONDS=60
PROMISE_TTL_SECONDS=86400
PROMISE_MAX_WORKERS=8

# Ollama auto-start behavior
OLLAMA_AUTO_START=true
OLLAMA_IDLE_TIMEOUT=300
OLLAMA_KEEP_ALIVE=5m

# ===========================================
# LLM Provider Settings
# ===========================================
LLM_PROVIDER=ollama
USE_OLLAMA=true
OLLAMA_MODEL=qwen3:8b
A2A_SERVER_URL=http://localhost:3000
AI_HUB_URL=http://localhost:11434
POLL_INTERVAL_MS=2000
POLL_TIMEOUT_MS=3600000

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ===========================================
# Paths
# ===========================================
STORAGE_DIR=proxy_logs
SIMULATION_DATA_PATH=simulation_data
OLLAMA_MODELS=C:\Users\dev\Desktop\.ollama

# ===========================================
# Agent RAG Configuration
# ===========================================
# Maximum number of RAG search operations in a chain (agent flows).
# Prevents excessive RAG chains that could impact performance.
# Default: 5, Range: 1-20
A2A_AGENT_RAG_CHAIN_MAX=5

# Project path for RAG indexing (used by auto-rag-page-server.ts).
# When set, enables server-side RAG for gray room 'interrupt.reason === "auto_rag_page"'.
# Example: A2A_RAG_PROJECT_PATH=C:\workspace\my-project
# Default: not set (RAG disabled)
  
# ===========================================
# Task Monitor Configuration
# ===========================================
# Base URL for Client API (where sessions are managed)
# Default: http://localhost:5173/api/a2a (Vite dev server)
TASK_MONITOR_CLIENT_API_URL=http://localhost:5173/api/a2a

# Base URL for A2A Server (direct API access)
# Default: http://localhost:3000/api/v1
TASK_MONITOR_SERVER_API_URL=http://localhost:3000/api/v1

# Default project ID for task sessions
# If not set, monitor will fetch from /projects endpoint
TASK_MONITOR_PROJECT_ID=

# Polling configuration for async operations
TASK_MONITOR_POLL_INTERVAL_MS=5000
TASK_MONITOR_MAX_POLL_ATTEMPTS=60
TASK_MONITOR_POLL_TIMEOUT_MS=300000

# State file path (relative to cwd or absolute)
TASK_MONITOR_STATE_FILE=task-monitor-state.json

# Tasks directory (where prompt files are located)
TASK_MONITOR_TASKS_DIR=prompts-to-agent-mode

# Mode: 'daemon' for continuous monitoring, 'once' for single run
TASK_MONITOR_RUN_MODE=once

# Log level: error, warn, info, debug
TASK_MONITOR_LOG_LEVEL=info

# AI Integration proxy (port 11434) — Task Monitor reads GET /health for promise_daemon_only gate
TASK_MONITOR_AI_HUB_URL=http://localhost:11434
# Skip interactive OK prompt when PROMISE_DAEMON_ONLY is on (CI / non-interactive): 1 | true | yes
TASK_MONITOR_SKIP_PROMISE_GATE=

# ===========================================
# Gray Room (Server-side orchestration)
# ===========================================
# Gray room interrupt chain (RAG→history, thinking, compress, …). Default ON when unset.
# Set to 0 / false / off to disable (one response-transform pass; `interrupt` ignored).
# Values: 1, true, yes (on) | 0, false, no, off (off)
A2A_GRAY_ROOM_ENABLED=1

# Maximum number of gray room turns (default: 10, max: 100)
A2A_GRAY_ROOM_MAX_TURNS=10

# ===========================================
# Manual LLM Mode (Operator-controlled LLM)
# ===========================================
# When enabled, server pauses before calling LLM and waits for operator to
# submit LLM response manually via API endpoint.
#
# Use case: testing, debugging, using external LLM providers not in the
# standard pipeline, or manually crafting responses.
#
# Flow:
# 1. Request submitted normally via /invoke
# 2. Server transforms prepare request.md
# 3. Instead of calling LLM, request status becomes 'waiting_manual_llm'
# 4. Server returns execute.form with instructions
# 5. Operator submits response via POST /requests/{promiseId}/llm-response
# 6. Server continues with gray room processing
#
# Check pending: GET /requests/manual-llm/pending
#
# Values: 1, true, yes (on) | 0, false, no, off (off - default)
A2A_MANUAL_LLM_MODE=0
