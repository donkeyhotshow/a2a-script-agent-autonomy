{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://a2a.dev/schemas/action-definition.schema.json",
  "title": "A2A Action Definition Schema",
  "description": "Schema for defining A2A actions with steps, validation, and type generation",
  "type": "object",
  "required": ["id", "version", "title", "description"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference"
    },
    "id": {
      "type": "string",
      "description": "Unique action identifier (kebab-case)",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of the action",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable action title"
    },
    "description": {
      "type": "string",
      "description": "Detailed action description"
    },
    "abstract": {
      "type": "boolean",
      "description": "Whether this is an abstract base action",
      "default": false
    },
    "base": {
      "type": "string",
      "description": "Base action to inherit from"
    },
    "triggers": {
      "type": "array",
      "description": "Keywords for semantic search matching",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "number",
      "description": "Execution priority (lower = higher priority)",
      "default": 100
    },
    "context": {
      "type": "object",
      "description": "Action execution context requirements",
      "properties": {
        "framework": {
          "type": "string",
          "description": "Target framework (e.g., vue, react, angular)"
        },
        "buildTool": {
          "type": "string",
          "description": "Build tool (e.g., vite, webpack)"
        },
        "type": {
          "type": "string",
          "description": "Action type classification"
        },
        "requiresConfirmation": {
          "type": "boolean",
          "default": true
        },
        "supportsDryRun": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "mixins": {
      "type": "array",
      "description": "Mixins to include in this action",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "description": "Ordered list of execution steps",
      "items": {
        "$ref": "#/definitions/Step"
      }
    }
  },
  "definitions": {
    "Step": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique step identifier within action",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "description": "Step description"
        },
        "title": {
          "type": "string",
          "description": "Human-readable step title"
        },
        "priority": {
          "type": "number",
          "description": "Step priority (lower = higher priority)",
          "default": 100
        },
        "$mixin": {
          "type": "string",
          "description": "Reference to mixin step"
        },
        "if": {
          "type": "string",
          "description": "Condition for step execution (template expression)"
        },
        "action": {
          "type": "string",
          "description": "Action type for this step",
          "enum": ["script", "form", "message", "rag-search", "read-file", "write-file", "execute-command"]
        },
        "input": {
          "oneOf": [
            {
              "type": "object",
              "description": "Static input parameters"
            },
            {
              "type": "string",
              "description": "Template expression referencing previous outputs"
            }
          ]
        },
        "output": {
          "type": "string",
          "description": "Output variable name for this step's result"
        },
        "script": {
          "type": "string",
          "description": "TypeScript code for script action type"
        },
        "code": {
          "type": "string",
          "description": "Alternative script code (inline)"
        }
      },
      "additionalProperties": false
    },
    "Mixin": {
      "type": "object",
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Mixin identifier"
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "description": "Mixin input parameters schema"
        },
        "returns": {
          "type": "object",
          "description": "Mixin output schema"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Step"
          }
        }
      }
    }
  }
}
