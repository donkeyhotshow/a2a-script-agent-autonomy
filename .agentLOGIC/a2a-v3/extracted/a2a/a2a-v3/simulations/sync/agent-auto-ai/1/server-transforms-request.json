{
  "type": "pipeline",
  "steps": [
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "set",
      "path": "$.context.execution",
      "value": {
        "action": "task",
        "step": "router"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "form": {
          "title": "Оберіть спосіб виконання",
          "description": "LLM адаптується до вашої задачі.",
          "choices": [
            {
              "id": "dialog",
              "label": "AI діалог з користувачем",
              "description": "Free-form chat; follow-up forms in later steps."
            },
            {
              "id": "agent",
              "label": "Agent",
              "description": "Універсальний режим - LLM адаптує поведінку до задачі."
            },
            {
              "id": "task-decomposition",
              "label": "Декомпозиція задачі",
              "description": "Split a goal into ordered subtasks and track progress."
            }
          ]
        }
      }
    }
  ]
}
