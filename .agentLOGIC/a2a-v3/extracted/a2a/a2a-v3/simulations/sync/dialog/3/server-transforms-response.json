{
  "type": "pipeline",
  "steps": [
    {
      "op": "parse-json-from-md",
      "fromFile": "response.md",
      "jsonPath": "$",
      "to": "$llm"
    },
    {
      "op": "copy",
      "from": "$.context",
      "to": "$.context"
    },
    {
      "op": "append-to-array",
      "to": "$.context.history",
      "value": {
        "role": "assistant",
        "message": "$.llm.message"
      }
    },
    {
      "op": "set",
      "path": "$.execute",
      "value": {
        "form": {
          "title": "Продовжити діалог",
          "input": [
            {
              "name": "message",
              "type": "text",
              "label": "Ваше повідомлення",
              "required": true
            }
          ]
        }
      }
    }
  ]
}
